---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="About & Contact - Claire Nyquist"
    description="Minneapolis-based data visualization designer, developer, and public health analyst, available for freelance and full-time work. Specializing in interactive data visualizations using R, Python, JavaScript, and D3. Let's work together."
>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Hero Section -->
        <div class="text-center mb-16">
            <h1 class="text-4xl md:text-6xl name-gradient mb-6">
                About & Contact
            </h1>
        </div>

        <div class="max-w-3xl mx-auto mb-16">
            <!-- About Section -->
            <div>
                <!-- About Content -->
                <div>
                    <div
                        class="prose prose-lg max-w-none text-gray-700 space-y-6"
                    >
                        <p>
                            With a Master of Public Health from the University
                            of Minnesota and First Class Honors in Graphic
                            Communication Design from the University of
                            Westminster in London, I've spent my career
                            translating complex science into actionable insights
                            — for ICF, the Minnesota Department of Health, the
                            Minneapolis Health Department, and Robert Wood
                            Johnson Foundation programs.
                        </p>
                        <p>
                            I've worked in a pediatric ER, a veterinary
                            diagnostic lab, and as a federal consultant. From
                            HTML/CSS to JavaScript and R, I build digital
                            experiences that are accessible, functional, and
                            statistically sound. I organize <a
                                href="/tcplot"
                                class="text-blue-600 hover:text-blue-800"
                                >tcplot</a
                            >, our local Twin Cities data visualization
                            community, and I've spent my free time volunteering
                            at the Minneapolis Institute of Art and The Bakken
                            Museum. I aim to spark curiosity&mdash;whether you
                            are five years old or a federal policymaker.
                        </p>
                        <p>
                            I'm based in Minneapolis and available for freelance
                            data visualization, science communication, and
                            design work. I'd love to hear what you're building.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Section -->
        <div class="max-w-3xl mx-auto mb-16">
            <div
                class="bg-gray-50 border border-gray-200 rounded-lg p-8 text-center"
            >
                <h2 class="text-2xl font-semibold text-gray-900 mb-3">
                    Let's work together
                </h2>
                <p class="text-gray-600 leading-relaxed">
                    Hiring for a role, scoping a freelance project, or just want
                    to talk data over coffee? Whether it needs a microscope, a
                    paintbrush, or both, I'd love to hear from you. I read every
                    message and aim to reply within a day or two.
                </p>
            </div>
        </div>
    </div>
</BaseLayout>
