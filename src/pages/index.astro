---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "The Met Collection | Claire Nyquist";
const description =
    "Every square is an artwork. Hundreds of objects from the Metropolitan Museum of Art, colored by their dominant hue and rearranged as you scroll.";
---

<BaseLayout title={title} description={description}>
    <!-- Fixed canvas behind everything -->
    <canvas
        id="met-canvas"
        style="position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:0;"
    ></canvas>

    <!-- Tooltip -->
    <div
        id="tooltip"
        style="position:fixed;z-index:100;pointer-events:none;display:none;
    background:rgba(0,0,0,0.9);color:#fff;padding:0;border-radius:8px;
    font-size:13px;max-width:300px;line-height:1.4;box-shadow:0 4px 20px rgba(0,0,0,0.4);overflow:hidden;"
    >
        <div
            id="tooltip-img-wrap"
            style="width:300px;height:200px;background:#111;display:none;position:relative;"
        >
            <img
                id="tooltip-img"
                src=""
                alt=""
                style="width:100%;height:100%;object-fit:cover;"
            />
            <div
                id="tooltip-img-loader"
                style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;"
            >
                <div
                    style="width:20px;height:20px;border:2px solid #444;border-top-color:#fff;border-radius:50%;animation:spin 0.6s linear infinite;"
                >
                </div>
            </div>
        </div>
        <div id="tooltip-text" style="padding:8px 12px;"></div>
    </div>

    <!-- Scroll sections -->
    <div
        id="scroll-container"
        style="position:relative;z-index:1;pointer-events:none;"
    >
        <!-- Section 0: Intro -->
        <section
            class="scroll-section"
            data-sort="hue"
            style="height:100vh;display:flex;align-items:center;justify-content:flex-start;padding:2rem;"
        >
            <div class="glass-card" style="margin-left:5%;">
                <h1
                    style="font-size:clamp(1.8rem,4vw,3rem);font-weight:700;margin:0 0 0.75rem 0;color:#000;"
                >
                    The Met Collection
                </h1>
                <p
                    style="font-size:clamp(0.95rem,1.5vw,1.15rem);color:#000;line-height:1.6;margin:0;"
                >
                    Every square you see is an artwork from the
                    <a
                        href="https://www.metmuseum.org/"
                        target="_blank"
                        rel="noopener noreferrer"
                        style="color:#1d4ed8;text-decoration:underline;"
                        >Metropolitan Museum of Art</a
                    >'s open-access collection, colored by its dominant hue.
                    <br /><br />
                    Scroll to see hundreds of objects sorted by hue, date, culture,
                    and medium.
                </p>
                <h3
                    style="font-size:clamp(1.1rem,2vw,1.5rem);font-weight:700;margin:1rem 0 0 0;color:#000;"
                >
                    <span class="speech-desktop">Hover to see the artworks!</span>
                    <span class="speech-mobile">Click to see the artworks!</span>
                </h3>
            </div>
        </section>

        <!-- Section 1: Hue -->
        <section
            class="scroll-section"
            data-sort="hue"
            style="height:100vh;display:flex;align-items:center;justify-content:flex-end;padding:2rem;"
        >
            <div class="glass-card" style="margin-right:5%;">
                <h2
                    style="font-size:clamp(1.4rem,3vw,2rem);font-weight:700;margin:0 0 0.5rem 0;color:#000;"
                >
                    Color Spectrum
                </h2>
                <p
                    style="font-size:clamp(0.9rem,1.3vw,1.05rem);color:#000;line-height:1.6;margin:0;"
                >
                    Each artwork's dominant color is extracted by sampling the most saturated tone from its image. Sorted by hue, with lightness as a tiebreaker.
                </p>
            </div>
        </section>

        <!-- Section 2: Chronological -->
        <section
            class="scroll-section"
            data-sort="chronological"
            style="height:100vh;display:flex;align-items:center;justify-content:flex-start;padding:2rem;"
        >
            <div class="glass-card" style="margin-left:5%;">
                <h2
                    style="font-size:clamp(1.4rem,3vw,2rem);font-weight:700;margin:0 0 0.5rem 0;color:#000;"
                >
                    5,000 Years of Art
                </h2>
                <p
                    style="font-size:clamp(0.9rem,1.3vw,1.05rem);color:#000;line-height:1.6;margin:0;"
                >
                    Sorted by creation date, from ancient Egyptian artifacts to
                    modern paintings. Each row reads left to right through time.
                </p>
            </div>
        </section>

        <!-- Section 3: Culture -->
        <section
            class="scroll-section"
            data-sort="culture"
            style="height:100vh;display:flex;align-items:center;justify-content:flex-end;padding:2rem;"
        >
            <div class="glass-card" style="margin-right:5%;">
                <h2
                    style="font-size:clamp(1.4rem,3vw,2rem);font-weight:700;margin:0 0 0.5rem 0;color:#000;"
                >
                    Cultures & Nations
                </h2>
                <p
                    style="font-size:clamp(0.9rem,1.3vw,1.05rem);color:#000;line-height:1.6;margin:0;"
                >
                    Grouped by culture of origin. Notice how color palettes
                    differ.
                </p>
            </div>
        </section>

        <!-- Section 4: Medium -->
        <section
            class="scroll-section"
            data-sort="medium"
            style="height:100vh;display:flex;align-items:center;justify-content:flex-end;padding:2rem;"
        >
            <div class="glass-card" style="margin-right:5%;">
                <h2
                    style="font-size:clamp(1.4rem,3vw,2rem);font-weight:700;margin:0 0 0.5rem 0;color:#000;"
                >
                    Materials & Media
                </h2>
                <p
                    style="font-size:clamp(0.9rem,1.3vw,1.05rem);color:#000;line-height:1.6;margin:0;"
                >
                    Grouped by material&mdash;oil on canvas, woodblock print,
                    silver, ceramic. The medium shapes the palette.
                </p>
            </div>
        </section>

        <!-- Section 6: Outro -->
        <section
            class="scroll-section"
            data-sort="hue"
            style="height:100vh;display:flex;align-items:center;justify-content:center;padding:2rem;"
        >
            <div class="glass-card" style="max-width:520px;text-align:center;">
                <h2
                    style="font-size:clamp(1.4rem,3vw,2rem);font-weight:700;margin:0 0 0.75rem 0;color:#000;"
                >
                    Data Sources
                </h2>
                <p
                    style="font-size:clamp(0.85rem,1.2vw,1rem);color:#000;line-height:1.7;margin:0;"
                >
                    Artwork data from the
                    <a
                        href="https://metmuseum.github.io/"
                        target="_blank"
                        rel="noopener noreferrer"
                        style="color:#1d4ed8;text-decoration:underline;"
                        >Met Museum Collection API</a
                    >
                    and
                    <a
                        href="https://github.com/metmuseum/openaccess"
                        target="_blank"
                        rel="noopener noreferrer"
                        style="color:#1d4ed8;text-decoration:underline;"
                        >Open Access CSV</a
                    >.
                    <br /><br />
                    Dominant colors extracted with
                    <a
                        href="https://github.com/obskyr/colorgram.py"
                        target="_blank"
                        rel="noopener noreferrer"
                        style="color:#1d4ed8;text-decoration:underline;"
                        >colorgram.py</a
                    >.
                    <br /><br />
                    <span style="font-size:0.85em;color:#000;"
                        >Visualization by Claire Nyquist</span
                    >
                </p>
            </div>
        </section>
    </div>

    <style>
        /* Glass card */
        .glass-card {
            pointer-events: auto;
            background: rgba(255, 255, 255, 0.55);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 12px;
            padding: 1.5rem 2rem;
            max-width: 420px;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.5);
        }

        .glass-card a {
            color: #1d4ed8;
            text-decoration: underline;
        }
        .glass-card a:hover {
            color: #1e40af;
        }

        /* Show/hide based on pointer capability */
        .speech-mobile { display: none; }
        .speech-desktop { display: inline; }
        @media (hover: none) and (pointer: coarse) {
            .speech-mobile { display: inline; }
            .speech-desktop { display: none; }
        }

        /* Hide default page padding from BaseLayout main */
        :global(main.flex-grow) {
            padding: 0 !important;
        }

        /* Hide footer when on this page */
        :global(footer) {
            display: none;
        }

        /* Loading overlay */
        #loading-overlay {
            position: fixed;
            inset: 0;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            transition: opacity 0.5s;
        }
        #loading-overlay.hidden {
            opacity: 0;
            pointer-events: none;
        }
    </style>

    <!-- Loading overlay -->
    <div id="loading-overlay">
        <div style="text-align:center;">
            <div
                style="width:48px;height:48px;border:3px solid #e5e7eb;border-top-color:#3b82f6;border-radius:50%;animation:spin 0.8s linear infinite;margin:0 auto 1rem;"
            >
            </div>
            <p style="color:#666;font-size:0.95rem;">Loading artworks...</p>
        </div>
    </div>
    <style>
        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>

    <script is:inline>
        (function () {
            "use strict";

            // --- State ---
            let artworks = [];
            let N = 0;
            let currentSort = "hue";
            let targetSort = "hue";
            let animProgress = 1; // 1 = done
            let animStart = 0;
            const ANIM_DURATION = 800;

            // Position arrays: { [sortName]: Float32Array of [x0,y0,x1,y1,...] }
            let positions = {};
            // Colors as [r,g,b] arrays
            let colors = [];

            // Canvas
            const canvas = document.getElementById("met-canvas");
            const ctx = canvas.getContext("2d");
            let canvasW = 0,
                canvasH = 0,
                cols = 0,
                rows = 0,
                pixelSize = 0;
            const dpr = window.devicePixelRatio || 1;
            const navH = 64; // height of sticky navbar

            // Tooltip
            const tooltip = document.getElementById("tooltip");

            // --- CSV Parsing ---
            function parseCSV(text) {
                const lines = text.split("\n");
                const headers = parseCSVLine(lines[0]);
                const result = [];
                for (let i = 1; i < lines.length; i++) {
                    if (!lines[i].trim()) continue;
                    const vals = parseCSVLine(lines[i]);
                    const obj = {};
                    for (let j = 0; j < headers.length; j++) {
                        obj[headers[j]] = vals[j] || "";
                    }
                    result.push(obj);
                }
                return result;
            }

            function parseCSVLine(line) {
                const result = [];
                let current = "";
                let inQuotes = false;
                for (let i = 0; i < line.length; i++) {
                    const ch = line[i];
                    if (inQuotes) {
                        if (ch === '"') {
                            if (i + 1 < line.length && line[i + 1] === '"') {
                                current += '"';
                                i++;
                            } else {
                                inQuotes = false;
                            }
                        } else {
                            current += ch;
                        }
                    } else {
                        if (ch === '"') {
                            inQuotes = true;
                        } else if (ch === ",") {
                            result.push(current.trim());
                            current = "";
                        } else {
                            current += ch;
                        }
                    }
                }
                result.push(current.trim());
                return result;
            }

            // --- Hex to RGB ---
            function hexToRGB(hex) {
                hex = hex.replace("#", "");
                return [
                    parseInt(hex.substring(0, 2), 16),
                    parseInt(hex.substring(2, 4), 16),
                    parseInt(hex.substring(4, 6), 16),
                ];
            }

            function hexToLightness(hex) {
                const [r, g, b] = hexToRGB(hex || "#888888");
                const max = Math.max(r, g, b) / 255;
                const min = Math.min(r, g, b) / 255;
                return (max + min) / 2;
            }

            // --- Grid Calculation ---
            function computeGrid() {
                canvasW = window.innerWidth;
                canvasH = window.innerHeight;
                canvas.width = canvasW * dpr;
                canvas.height = canvasH * dpr;
                canvas.style.width = canvasW + "px";
                canvas.style.height = canvasH + "px";
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

                if (N === 0) return;

                // Size squares to fill the available viewport (below navbar)
                const availH = canvasH - navH;
                cols = Math.ceil(Math.sqrt((N * canvasW) / availH));
                rows = Math.ceil(N / cols);
                pixelSize = Math.min(canvasW / cols, availH / rows);
                cols = Math.floor(canvasW / pixelSize);
                rows = Math.ceil(N / cols);
                pixelSize = Math.min(canvasW / cols, availH / rows);

                // Recompute all positions
                computeAllPositions();
            }

            // --- Sort Helpers ---
            function getSortedIndices(sortKey) {
                const indices = Array.from({ length: N }, (_, i) => i);

                switch (sortKey) {
                    case "chronological":
                        indices.sort((a, b) => {
                            const da =
                                parseInt(artworks[a].objectBeginDate) || 0;
                            const db =
                                parseInt(artworks[b].objectBeginDate) || 0;
                            return da - db;
                        });
                        break;
                    case "culture":
                        indices.sort((a, b) => {
                            const ca = (
                                artworks[a].culture || "Unknown"
                            ).toLowerCase();
                            const cb = (
                                artworks[b].culture || "Unknown"
                            ).toLowerCase();
                            return ca < cb ? -1 : ca > cb ? 1 : 0;
                        });
                        break;
                    case "medium":
                        indices.sort((a, b) => {
                            const ma = simplifyMedium(
                                artworks[a].medium || "Unknown",
                            ).toLowerCase();
                            const mb = simplifyMedium(
                                artworks[b].medium || "Unknown",
                            ).toLowerCase();
                            return ma < mb ? -1 : ma > mb ? 1 : 0;
                        });
                        break;
                    case "hue":
                        indices.sort((a, b) => {
                            const ha = parseFloat(artworks[a].hue) || 0;
                            const hb = parseFloat(artworks[b].hue) || 0;
                            if (Math.abs(ha - hb) > 0.5) return hb - ha;
                            const la = hexToLightness(artworks[a].hex);
                            const lb = hexToLightness(artworks[b].hex);
                            return lb - la;
                        });
                        break;
                }
                return indices;
            }

            function simplifyMedium(medium) {
                const lower = medium.toLowerCase();
                if (lower.includes("oil")) return "Oil paint";
                if (lower.includes("watercolor")) return "Watercolor";
                if (lower.includes("woodblock") || lower.includes("woodcut"))
                    return "Woodblock print";
                if (lower.includes("photograph") || lower.includes("gelatin"))
                    return "Photography";
                if (lower.includes("silk")) return "Silk";
                if (lower.includes("cotton")) return "Cotton";
                if (lower.includes("wool")) return "Wool";
                if (
                    lower.includes("ceramic") ||
                    lower.includes("terracotta") ||
                    lower.includes("earthenware") ||
                    lower.includes("stoneware") ||
                    lower.includes("porcelain")
                )
                    return "Ceramics";
                if (lower.includes("bronze")) return "Bronze";
                if (lower.includes("silver")) return "Silver";
                if (lower.includes("gold")) return "Gold";
                if (lower.includes("iron") || lower.includes("steel"))
                    return "Iron/Steel";
                if (lower.includes("wood")) return "Wood";
                if (
                    lower.includes("stone") ||
                    lower.includes("marble") ||
                    lower.includes("limestone")
                )
                    return "Stone";
                if (lower.includes("paper") || lower.includes("ink"))
                    return "Ink on paper";
                if (lower.includes("engraving") || lower.includes("etching"))
                    return "Engraving";
                if (lower.includes("lithograph")) return "Lithograph";
                if (lower.includes("glass")) return "Glass";
                if (lower.includes("ivory")) return "Ivory";
                if (lower.includes("leather")) return "Leather";
                const comma = medium.indexOf(",");
                return comma > 0
                    ? medium.substring(0, comma)
                    : medium.substring(0, 30);
            }

            function computePositionsForSort(sortKey) {
                const sorted = getSortedIndices(sortKey);
                const posArr = new Float32Array(N * 2);

                // Simple grid layout
                for (let i = 0; i < sorted.length; i++) {
                    const origIdx = sorted[i];
                    const gridCol = i % cols;
                    const gridRow = Math.floor(i / cols);
                    posArr[origIdx * 2] = gridCol * pixelSize;
                    posArr[origIdx * 2 + 1] = gridRow * pixelSize + navH;
                }

                return posArr;
            }

            function computeAllPositions() {
                const sorts = ["chronological", "culture", "medium", "hue"];
                for (const s of sorts) {
                    positions[s] = computePositionsForSort(s);
                }
            }

            // --- Easing ---
            function easeInOutCubic(t) {
                return t < 0.5
                    ? 4 * t * t * t
                    : 1 - Math.pow(-2 * t + 2, 3) / 2;
            }

            // --- Render ---
            function render(timestamp) {
                if (animProgress < 1) {
                    const elapsed = timestamp - animStart;
                    animProgress = Math.min(1, elapsed / ANIM_DURATION);
                }

                const t = easeInOutCubic(animProgress);

                ctx.clearRect(0, 0, canvasW, canvasH);

                const fromPos = positions[currentSort];
                const toPos = positions[targetSort];

                if (!fromPos || !toPos) {
                    requestAnimationFrame(render);
                    return;
                }

                for (let i = 0; i < N; i++) {
                    const fi = i * 2;
                    let x, y;

                    if (animProgress >= 1) {
                        x = toPos[fi];
                        y = toPos[fi + 1];
                    } else {
                        x = fromPos[fi] + (toPos[fi] - fromPos[fi]) * t;
                        y =
                            fromPos[fi + 1] +
                            (toPos[fi + 1] - fromPos[fi + 1]) * t;
                    }

                    const c = colors[i];
                    ctx.fillStyle = c;
                    ctx.fillRect(x, y, pixelSize - 0.5, pixelSize - 0.5);
                }

                if (animProgress >= 1 && currentSort !== targetSort) {
                    currentSort = targetSort;
                }

                requestAnimationFrame(render);
            }

            // --- Transition ---
            function transitionTo(sortName) {
                if (sortName === targetSort && animProgress >= 1) return;
                if (!positions[sortName]) return;
                targetSort = sortName;
                animProgress = 0;
                animStart = performance.now();
            }

            // --- Intersection Observer for scroll sections ---
            function setupScrollObserver() {
                const sections = document.querySelectorAll(".scroll-section");

                const observer = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            if (entry.isIntersecting) {
                                const sort =
                                    entry.target.getAttribute("data-sort");
                                if (sort) transitionTo(sort);
                            }
                        }
                    },
                    { threshold: 0.5 },
                );

                sections.forEach((s) => observer.observe(s));
            }

            // --- Tooltip on hover/tap ---
            function setupTooltip() {
                const tooltipText = document.getElementById("tooltip-text");
                const tooltipImgWrap =
                    document.getElementById("tooltip-img-wrap");
                const tooltipImg = document.getElementById("tooltip-img");
                const tooltipImgLoader =
                    document.getElementById("tooltip-img-loader");
                let currentTooltipIdx = -1;
                let imgLoadedFor = -1;

                tooltipImg.addEventListener("load", () => {
                    tooltipImgLoader.style.display = "none";
                    imgLoadedFor = currentTooltipIdx;
                });
                tooltipImg.addEventListener("error", () => {
                    tooltipImgWrap.style.display = "none";
                    imgLoadedFor = -1;
                });

                function showTooltipAt(mx, my) {
                    if (N === 0 || animProgress < 1) {
                        tooltip.style.display = "none";
                        currentTooltipIdx = -1;
                        return;
                    }

                    const pos = positions[currentSort];
                    let found = -1;

                    for (let i = 0; i < N; i++) {
                        const px = pos[i * 2];
                        const py = pos[i * 2 + 1];
                        if (
                            mx >= px &&
                            mx < px + pixelSize &&
                            my >= py &&
                            my < py + pixelSize
                        ) {
                            found = i;
                            break;
                        }
                    }

                    if (found >= 0) {
                        const a = artworks[found];
                        const year = parseInt(a.objectBeginDate);
                        const yearStr =
                            year < 0 ? `${Math.abs(year)} BCE` : `${year} CE`;

                        tooltipText.innerHTML = `
            <strong style="color:${a.hex};">\u25A0</strong>
            <strong>${a.objectName || "Untitled"}</strong><br>
            <span style="color:#ccc;font-size:12px;">
              ${a.culture || "Unknown culture"} &middot; ${yearStr}<br>
              ${a.department ? "<b>Dept:</b> " + a.department + "<br>" : ""}
              ${a.medium ? "<b>Medium:</b> " + a.medium + "<br>" : ""}
              <b>Color:</b> <span style="color:${a.hex};">${a.hex}</span>
            </span>
          `;

                        if (found !== currentTooltipIdx) {
                            currentTooltipIdx = found;
                            const imgUrl = a.imageUrl;
                            if (imgUrl) {
                                tooltipImgWrap.style.display = "block";
                                tooltipImgLoader.style.display = "flex";
                                tooltipImg.src = imgUrl;
                            } else {
                                tooltipImgWrap.style.display = "none";
                            }
                        }

                        tooltip.style.display = "block";

                        const tooltipH = tooltip.offsetHeight || 250;
                        const tooltipW = 300;
                        let tx = mx + 14;
                        let ty = my + 14;
                        if (tx + tooltipW > window.innerWidth)
                            tx = mx - tooltipW - 10;
                        if (ty + tooltipH > window.innerHeight)
                            ty = my - tooltipH - 10;
                        if (tx < 0) tx = 4;
                        if (ty < 0) ty = 4;
                        tooltip.style.left = tx + "px";
                        tooltip.style.top = ty + "px";
                    } else {
                        tooltip.style.display = "none";
                        currentTooltipIdx = -1;
                    }
                }

                function hideTooltip() {
                    tooltip.style.display = "none";
                    currentTooltipIdx = -1;
                }

                // Track whether input is touch-based to avoid conflicts
                let isTouch = false;

                // Desktop: mouse events (skip if touch device)
                canvas.addEventListener("mousemove", (e) => {
                    if (isTouch) return;
                    showTooltipAt(e.clientX, e.clientY);
                });
                canvas.addEventListener("mouseleave", () => {
                    if (isTouch) return;
                    hideTooltip();
                });

                // Mobile: tap to toggle tooltip
                canvas.addEventListener(
                    "touchstart",
                    () => {
                        isTouch = true;
                    },
                    { passive: true },
                );

                canvas.addEventListener("click", (e) => {
                    if (!isTouch) return;
                    if (N === 0 || animProgress < 1) return;

                    // If a tooltip is currently showing, always close it first
                    if (tooltip.style.display === "block") {
                        hideTooltip();
                        return;
                    }

                    const pos = positions[currentSort];
                    let found = -1;
                    for (let i = 0; i < N; i++) {
                        const px = pos[i * 2];
                        const py = pos[i * 2 + 1];
                        if (
                            e.clientX >= px &&
                            e.clientX < px + pixelSize &&
                            e.clientY >= py &&
                            e.clientY < py + pixelSize
                        ) {
                            found = i;
                            break;
                        }
                    }

                    if (found >= 0) {
                        showTooltipAt(e.clientX, e.clientY);
                    }
                });
            }

            // --- Resize handler ---
            let resizeTimer;
            window.addEventListener("resize", () => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(() => {
                    computeGrid();
                    animProgress = 1; // snap to current sort
                }, 200);
            });

            // --- Load data and start ---
            async function init() {
                try {
                    const resp = await fetch("/data/met_colors.csv");
                    if (!resp.ok)
                        throw new Error(
                            "CSV not found. Run the Python script first.",
                        );
                    const text = await resp.text();
                    artworks = parseCSV(text);
                    N = artworks.length;

                    // Pre-parse colors as hex strings
                    colors = artworks.map((a) => a.hex || "#888888");

                    // Setup canvas and positions
                    computeGrid();

                    // Start render loop
                    requestAnimationFrame(render);

                    // Setup interactions
                    setupScrollObserver();
                    setupTooltip();

                    // Hide loading
                    const overlay = document.getElementById("loading-overlay");
                    if (overlay) overlay.classList.add("hidden");
                    setTimeout(() => {
                        if (overlay) overlay.remove();
                    }, 600);
                } catch (err) {
                    console.error("Met visualization error:", err);
                    const overlay = document.getElementById("loading-overlay");
                    if (overlay) {
                        overlay.innerHTML = `
            <div style="text-align:center;padding:2rem;">
              <p style="color:#ef4444;font-size:1.1rem;font-weight:600;margin-bottom:0.5rem;">Could not load artwork data</p>
              <p style="color:#666;font-size:0.9rem;">Run <code style="background:#f1f5f9;padding:2px 6px;border-radius:4px;">python scripts/met_color_extract.py</code> to generate the dataset.</p>
            </div>
          `;
                    }
                }
            }

            // Wait for DOM
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", init);
            } else {
                init();
            }
        })();
    </script>
</BaseLayout>
