---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Claire Nyquist | Data Visualization";
const description =
    "Claire Nyquist builds interactive data visualizations about public health. Master of Public Health + graphic design + R, Python, JavaScript, and D3. Based in Minneapolis.";

// Every card on this page comes from this one list. To add a visualization,
// drop its GIF in public/images/gifs/ and add an entry here.
const works = [
    {
        href: "/nonhuman-neighbors",
        gif: "/images/gifs/nonhuman-neighbors.gif",
        w: 538,
        h: 720,
        title: "Nonhuman Neighbors",
        blurb: "Every species recorded in one Northeast Minneapolis neighborhood, each drawn as line art of the organism itself and tinted its own color, chickadees to slime molds.",
    },
    {
        href: "/minnesota-bryophytes",
        gif: "/images/gifs/minnesota-bryophytes.gif",
        w: 656,
        h: 720,
        title: "Minnesota Mosses",
        blurb: "A century of moss observations built into a 3D map you can turn in your hands. Bar height is how much was recorded, and the stacked colors are taxonomic orders.",
    },
    {
        href: "/malaria",
        gif: "/images/gifs/malaria.gif",
        w: 570,
        h: 730,
        title: "Mosquitoes, Malaria & Sickle Cell",
        blurb: "A scrolling atlas of how mosquito range, malaria burden and sickle cell trait fall across the same ground, and the evolutionary pressure that links them.",
    },
    {
        href: "/themet",
        gif: "/images/gifs/themet.gif",
        w: 772,
        h: 812,
        title: "The Met Collection",
        blurb: "Thousands of artworks sorted into a single colour spectrum, each one reduced to the hue it is most saturated in.",
    },
    {
        href: "/wilddyeplants",
        gif: "/images/gifs/wilddyeplants.gif",
        w: 606,
        h: 720,
        title: "Wild Dye Plants",
        blurb: "A radial index of plants that yield dye, arranged by the colour each one gives up.",
    },
    {
        href: "/exoplanets",
        gif: "/images/gifs/exoplanets.gif",
        w: 826,
        h: 712,
        title: "Exoplanet Discoveries",
        blurb: "Every confirmed exoplanet by distance, mass and the method that found it, showing how detection has reached steadily farther from Earth.",
    },
    {
        href: "/ai-models-timeline",
        gif: "/images/gifs/ai-models-timeline.png",
        w: 718,
        h: 770,
        title: "AI Models Timeline",
        blurb: "Notable AI models year by year from Epoch AI data, coloured by the organization that trained them.",
    },
    {
        href: "/stanford-torus-explorer",
        gif: "/images/gifs/stanford-torus-explorer.gif",
        w: 720,
        h: 632,
        title: "Stanford Torus Explorer",
        blurb: "A parametric walk through the 1975 NASA design for a rotating space colony, at true scale and adjustable.",
    },
    {
        href: "/tuberculosis",
        gif: "/images/gifs/tuberculosis.gif",
        w: 862,
        h: 582,
        title: "Global Tuberculosis",
        blurb: "Estimated incidence, detected cases and deaths for every country from 2000 onward, drawn from WHO programme data.",
    },
    {
        href: "/respiratoryviruses",
        gif: "/images/gifs/respiratoryviruses.gif",
        w: 810,
        h: 638,
        title: "Respiratory Viruses in Minnesota",
        blurb: "RSV, influenza and COVID-19 hospitalizations and laboratory detections, tracked season over season from state surveillance data.",
    },
    {
        href: "/octopuses",
        gif: "/images/gifs/octopuses.gif",
        w: 772,
        h: 744,
        title: "Octopuses",
        blurb: "Where octopus species have been observed worldwide, species by species across a quarter century of records.",
    },
    {
        href: "/meps",
        gif: "/images/gifs/meps.gif",
        w: 831,
        h: 900,
        title: "Medical Expenditure Panel Survey",
        blurb: "Healthcare use, spending and insurance coverage across American households, normalized so variables measured in different units can be read side by side.",
    },
    {
        href: "/audiobooks",
        gif: "/images/gifs/audiobooks.webp",
        w: 1100,
        h: 904,
        title: "Audiobooks",
        blurb: "An Audible library as one long bookshelf: every spine coloured from its cover art, its thickness the book's length, its height the year of release.",
    },
    {
        href: "/music",
        gif: "/images/gifs/music.gif",
        w: 810,
        h: 760,
        title: "Music",
        blurb: "A whole music library turned into a bar chart you can hear, each artist a beat whose pitch and colour follow how many songs are theirs.",
    },
];
---

<BaseLayout title={title} description={description}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Hero -->
        <div class="text-center mb-12">
            <h1 class="text-4xl md:text-6xl name-gradient mb-6">
                I build data visualizations<br />about science and health.
            </h1>
            <p
                class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed mb-4"
            >
                I have a Master of Public Health (University of Minnesota), a
                degree in graphic communication design (University of
                Westminster, First Class Honors), and expertise in R, Python,
                JavaScript, and D3.
            </p>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
                I've worked in public health consulting at ICF, vaccine
                distribution at the Minnesota Department of Health, and rapid
                diagnostic development at the University of Minnesota. I also
                founded
                <a
                    href="/tcplot"
                    class="text-blue-600 hover:text-blue-800 underline"
                    >tcplot</a
                >, the Twin Cities data visualization community.
            </p>
        </div>

        <!-- Gallery Section -->
        <div class="mb-16">
            <div class="masonry-container">
                {
                    works.map((w) => (
                        <a
                            href={w.href}
                            class="masonry-item bg-white rounded-lg overflow-hidden mb-6 block"
                        >
                            <div class="relative">
                                <img
                                    src={
                                        w.gif.endsWith(".gif")
                                            ? w.gif.replace(
                                                  /\.gif$/,
                                                  "-poster.webp",
                                              )
                                            : w.gif
                                    }
                                    data-gif={
                                        w.gif.endsWith(".gif")
                                            ? w.gif
                                            : undefined
                                    }
                                    alt={w.blurb}
                                    width={w.w}
                                    height={w.h}
                                    loading="lazy"
                                    decoding="async"
                                    class="w-full h-auto object-contain"
                                />
                            </div>
                        </a>
                    ))
                }
            </div>
            <script is:inline>
                // Shuffle the cards on every load. Runs synchronously right
                // after the grid parses, so the order is set before first
                // paint. The two still images (no data-gif) are kept apart.
                (function () {
                    var c = document.querySelector(".masonry-container");
                    if (!c) return;
                    var items = Array.prototype.slice.call(c.children);
                    for (var i = items.length - 1; i > 0; i--) {
                        var j = Math.floor(Math.random() * (i + 1));
                        var t = items[i];
                        items[i] = items[j];
                        items[j] = t;
                    }
                    var isStill = function (el) {
                        var img = el.querySelector("img");
                        return img && !img.hasAttribute("data-gif");
                    };
                    for (var k = 0; k + 1 < items.length; k++) {
                        if (isStill(items[k]) && isStill(items[k + 1])) {
                            var target = (k + 3) % items.length;
                            if (isStill(items[target]))
                                target = (target + 1) % items.length;
                            var s = items[k + 1];
                            items[k + 1] = items[target];
                            items[target] = s;
                        }
                    }
                    items.forEach(function (el) {
                        c.appendChild(el);
                    });
                })();
            </script>
        </div>
    </div>
    </div>

    <style>
        .masonry-container {
            /* Two columns on mobile, three on desktop */
            column-count: 2;
            column-gap: 1rem;
            width: 100%;
            max-width: 100%;
        }

        @media (min-width: 768px) {
            .masonry-container {
                column-gap: 2rem;
            }
            .masonry-item {
                margin-bottom: 2rem;
            }
        }

        @media (min-width: 1200px) {
            .masonry-container {
                column-count: 3;
            }
        }

        /* Masonry items */
        .masonry-item {
            display: block;
            /* break-inside is the key for columns */
            break-inside: avoid;
            -webkit-column-break-inside: avoid;
            page-break-inside: avoid;

            width: 100%;
            margin-bottom: 1rem;
            background: white;
            border-radius: 0.5rem;
            overflow: hidden;

            /* Simplify stacking to avoid Chrome rendering bugs in columns */
            position: relative;
        }

        /* Natural image sizing - no cropping for masonry */
        .masonry-item img {
            display: block;
            width: 100%;
            height: auto;
            object-fit: contain;
            transition: transform 0.3s ease;
            will-change: transform;
        }

        /* Image zoom effect on hover */
        .masonry-item:hover img {
            transform: scale(1.03);
        }

        /* Ensure image container doesn't show overflow */
        .masonry-item .relative {
            overflow: hidden;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        /* Text container stability */

        /* Prevent column breaks within cards */
        .masonry-item * {
            break-inside: avoid;
        }
    </style>

    <script>
        // Cards rest as static posters. A scheduler wakes at most MAX_PLAYING
        // cards at a time, lets each run for one loop, then puts it back to
        // sleep — so the grid always has motion somewhere but never everywhere.
        // Hovering (or keyboard-focusing) a card always plays it immediately.
        const MAX_PLAYING = 2;
        const PLAY_MS = 7000;
        const TICK_MS = 2000;

        const cards = [];
        document.querySelectorAll(".masonry-item").forEach((card) => {
            const img = card.querySelector("img[data-gif]");
            if (!img) return;
            const poster = img.getAttribute("src");
            const gif = img.getAttribute("data-gif");
            if (!poster || !gif) return;
            const c = {
                img,
                poster,
                gif,
                hover: false,
                scheduled: false,
                visible: false,
                loaded: false,
            };
            const show = () => c.img.setAttribute("src", c.gif);
            const rest = () => {
                if (!c.hover && !c.scheduled)
                    c.img.setAttribute("src", c.poster);
            };
            c.show = show;
            c.rest = rest;
            card.addEventListener("mouseenter", () => {
                c.hover = true;
                show();
            });
            card.addEventListener("mouseleave", () => {
                c.hover = false;
                rest();
            });
            card.addEventListener("focus", () => {
                c.hover = true;
                show();
            });
            card.addEventListener("blur", () => {
                c.hover = false;
                rest();
            });
            cards.push(c);
        });

        if (
            cards.length &&
            !window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
            const io = new IntersectionObserver((entries) => {
                entries.forEach((e) => {
                    const c = cards.find(
                        (x) => x.img === e.target.querySelector("img[data-gif]")
                    );
                    if (c) c.visible = e.isIntersecting;
                });
            });
            document
                .querySelectorAll(".masonry-item")
                .forEach((el) => io.observe(el));

            const startWindow = (c) => {
                c.scheduled = true;
                c.show();
                setTimeout(() => {
                    c.scheduled = false;
                    c.rest();
                }, PLAY_MS);
            };

            // Random pick among eligible cards; `recent` keeps the last couple
            // of woken cards out of the pool so nothing repeats back-to-back.
            const recent = [];
            setInterval(() => {
                const playing = cards.filter(
                    (c) => c.scheduled || c.hover
                ).length;
                if (playing >= MAX_PLAYING) return;
                let pool = cards.filter(
                    (c) =>
                        c.visible &&
                        !c.scheduled &&
                        !c.hover &&
                        !recent.includes(c)
                );
                if (!pool.length)
                    pool = cards.filter(
                        (c) => c.visible && !c.scheduled && !c.hover
                    );
                if (!pool.length) return;
                const c = pool[Math.floor(Math.random() * pool.length)];
                recent.push(c);
                if (recent.length > 2) recent.shift();
                if (c.loaded) {
                    startWindow(c);
                } else {
                    // First play: fetch the GIF, start its window once it's
                    // ready so loading time doesn't eat the loop.
                    const pre = new Image();
                    pre.onload = () => {
                        c.loaded = true;
                        startWindow(c);
                    };
                    pre.src = c.gif;
                }
            }, TICK_MS);
        }
    </script>
</BaseLayout>
