---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Claire Nyquist | Data Visualization";
const description =
    "Claire Nyquist builds interactive data visualizations about public health. Master of Public Health + graphic design + R, Python, JavaScript, and D3. Based in Minneapolis.";

// Every card on this page comes from this one list. To add a visualization,
// build its clip with scripts/videoify.py (bouncing H.264 in public/videos/),
// drop a first-frame poster at /images/gifs/<slug>-poster.webp, and add an
// entry with `video:`. Entries with `gif:` are static images.
// Optional per-card title overrides:
//   titleColor    — solid color for the title (sampled from the image);
//                   without it the title is white + difference-blended.
//   titleKeepBlend — keep difference blending even with a titleColor set.
//   titleLines    — explicit line breaks for the fitted title.
//   titleSmall    — small static title in the upper left, not fitted.
//   titleBlend    — explicit mix-blend-mode override (e.g. "multiply"
//                   deepens whatever the letters sit on).
const works = [
    {
        href: "/nonhuman-neighbors",
        video: "/videos/nonhuman-neighbors.mp4",
        w: 538,
        h: 720,
        title: "Nonhuman Neighbors",
        // Brighter bunting blue, semi-transparent so the drawings read
        // through the letters.
        titleColor: "rgba(47, 111, 237, 0.65)",
        blurb: "Every species recorded in one Northeast Minneapolis neighborhood, each drawn as line art of the organism itself and tinted its own color, chickadees to slime molds.",
    },
    {
        href: "/minnesota-bryophytes",
        video: "/videos/minnesota-bryophytes.mp4",
        w: 656,
        h: 720,
        title: "Minnesota Mosses",
        titleColor: "#386a48",
        blurb: "A century of moss observations built into a 3D map you can turn in your hands. Bar height is how much was recorded, and the stacked colors are taxonomic orders.",
    },
    {
        href: "/malaria",
        video: "/videos/malaria.mp4",
        w: 570,
        h: 730,
        title: "Mosquitoes, Malaria & Sickle Cell",
        titleColor: "#274593",
        blurb: "A scrolling atlas of how mosquito range, malaria burden and sickle cell trait fall across the same ground, and the evolutionary pressure that links them.",
    },
    {
        href: "/themet",
        video: "/videos/themet.mp4",
        w: 772,
        h: 812,
        title: "The Met Collection",
        blurb: "Explore the Metropolitan Museum of Art collections.",
    },
    {
        href: "/wilddyeplants",
        video: "/videos/wilddyeplants.mp4",
        w: 606,
        h: 720,
        title: "Wild Dye Plants",
        titleColor: "#f03236",
        blurb: "A radial index of plants that yield dye, arranged by the color each one gives up.",
    },
    {
        href: "/exoplanets",
        video: "/videos/exoplanets.mp4",
        w: 826,
        h: 712,
        title: "Exoplanet Discoveries",
        // Difference-blended complement: renders as the sampled green
        // (#3eac1d) over the white background and inverts where the
        // exoplanet dots pass under the text.
        titleColor: "#c153e2",
        titleKeepBlend: true,
        blurb: "Every confirmed exoplanet by distance, mass and the method that found it, showing how detection has reached steadily farther from Earth.",
    },
    {
        href: "/ai-models-timeline",
        gif: "/images/gifs/ai-models-timeline.png",
        w: 718,
        h: 770,
        title: "AI Models Timeline",
        // Difference-blended complement: renders as the chart's purple
        // (#b27df1) over the near-white background and inverts where
        // the dots/bars pass under the text.
        titleColor: "#4d820e",
        titleKeepBlend: true,
        blurb: "Notable AI models year by year from Epoch AI data, colored by the organization that trained them.",
    },
    {
        href: "/stanford-torus-explorer",
        video: "/videos/stanford-torus-explorer.mp4",
        w: 720,
        h: 632,
        title: "Stanford Torus Explorer",
        blurb: "A parametric walk through the 1975 NASA design for a rotating space colony, at true scale and adjustable.",
    },
    {
        href: "/tuberculosis",
        video: "/videos/tuberculosis.mp4",
        w: 862,
        h: 582,
        title: "Global Tuberculosis",
        // Multiply-blended: a transparent deepening of the dark pink, so
        // the title darkens the pale rings and still reads as a deeper
        // plum over the dark circles.
        titleColor: "#6b215f",
        titleBlend: "multiply",
        blurb: "Estimated incidence, detected cases and deaths for every country from 2000 onward, drawn from WHO program data.",
    },
    {
        href: "/respiratoryviruses",
        video: "/videos/respiratoryviruses.mp4",
        w: 810,
        h: 638,
        title: "Respiratory Viruses in Minnesota",
        titleColor: "#e54f17",
        blurb: "RSV, influenza and COVID-19 hospitalizations and laboratory detections, tracked season over season from state surveillance data.",
    },
    {
        href: "/octopuses",
        video: "/videos/octopuses.mp4",
        w: 772,
        h: 744,
        title: "Octopuses",
        // Difference-blended complement: renders as a bright orange
        // (#ff7a1e) over the white ocean, a touch deeper over the gray
        // landmass, and inverts where the observation dots pass under.
        titleColor: "#0085e1",
        titleKeepBlend: true,
        titleLines: ["Octo-", "puses"],
        blurb: "Where octopus species have been observed worldwide, species by species across a quarter century of records.",
    },
    {
        href: "/meps",
        video: "/videos/meps.mp4",
        w: 830,
        h: 898,
        title: "Medical Expenditure Panel Survey",
        blurb: "Healthcare use, spending and insurance coverage across American households, normalized so variables measured in different units can be read side by side.",
    },
    {
        href: "/audiobooks",
        gif: "/images/gifs/audiobooks.webp",
        w: 1100,
        h: 904,
        title: "Audiobooks",
        titleColor: "#000000",
        blurb: "An Audible library as one long bookshelf: every spine colored from its cover art, its thickness the book's length, its height the year of release.",
    },
    {
        href: "/music",
        video: "/videos/music.mp4",
        w: 810,
        h: 760,
        title: "Music",
        // Difference-blended, so this is the complement of the color that
        // actually shows: over the near-white poster it renders as bright
        // yellow (#ffe600) and inverts against the colored bars.
        titleColor: "#0019ff",
        titleKeepBlend: true,
        blurb: "A whole music library turned into a bar chart you can hear, each artist a beat whose pitch and color follow how many songs are theirs.",
    },
];
---

<BaseLayout title={title} description={description}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Hero -->
        <div class="text-center mb-12">
            <h1 class="text-4xl md:text-6xl name-gradient mb-6">
                I build data visualizations<br />about science and health.
            </h1>
            <p
                class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed mb-4"
            >
                I have a Master of Public Health (University of Minnesota), a
                degree in graphic communication design (University of
                Westminster, First Class Honors), and expertise in R, Python,
                JavaScript, and D3.
            </p>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
                I've worked in public health consulting at ICF, vaccine
                distribution at the Minnesota Department of Health, and rapid
                diagnostic development at the University of Minnesota. I also
                founded
                <a
                    href="/tcplot"
                    class="font-silkscreen text-blue-600 hover:text-blue-800"
                    >tcplot</a
                >, the Twin Cities data visualization community.
            </p>
        </div>

        <!-- Gallery Section -->
        <div class="mb-16">
            <h1
                class="font-space-grotesk text-2xl text-blue-600 text-center mb-6"
            >
                Data Visualization Projects
            </h1>
            <div class="masonry-container">
                {
                    works.map((w) => (
                        <a
                            href={w.href}
                            class="masonry-item bg-white rounded-lg overflow-hidden mb-6 block"
                        >
                            <div class="relative">
                                {w.video ? (
                                    <video
                                        class="w-full h-auto object-contain"
                                        muted
                                        loop
                                        playsinline
                                        preload="none"
                                        poster={w.video
                                            .replace("/videos/", "/images/gifs/")
                                            .replace(".mp4", "-poster.webp")}
                                        width={w.w}
                                        height={w.h}
                                        aria-label={w.title}
                                    >
                                        <source src={w.video} type="video/mp4" />
                                    </video>
                                ) : (
                                    <img
                                        src={w.gif}
                                        alt={w.title}
                                        width={w.w}
                                        height={w.h}
                                        loading="lazy"
                                        decoding="async"
                                        class="w-full h-auto object-contain"
                                    />
                                )}
                                <span
                                    class={`card-title font-space-grotesk${w.titleSmall ? " card-title-small" : ""}`}
                                    style={`color: ${w.titleColor ?? "#fff"}; mix-blend-mode: ${w.titleBlend ?? (!w.titleColor || w.titleKeepBlend ? "difference" : "normal")};`}
                                >
                                    {w.titleLines ? (
                                        <span
                                            class="card-title-inner font-space-grotesk"
                                            style="white-space: nowrap"
                                            set:html={w.titleLines.join(
                                                "<br>",
                                            )}
                                        />
                                    ) : (
                                        <span class="card-title-inner font-space-grotesk">
                                            {w.title}
                                        </span>
                                    )}
                                </span>
                            </div>
                            <p class="card-blurb">{w.blurb}</p>
                        </a>
                    ))
                }
            </div>
            <script is:inline>
                // Shuffle the cards on every load. Runs synchronously right
                // after the grid parses, so the order is set before first
                // paint. The two still images (no data-gif) are kept apart.
                (function () {
                    var c = document.querySelector(".masonry-container");
                    if (!c) return;
                    var items = Array.prototype.slice.call(c.children);
                    for (var i = items.length - 1; i > 0; i--) {
                        var j = Math.floor(Math.random() * (i + 1));
                        var t = items[i];
                        items[i] = items[j];
                        items[j] = t;
                    }
                    var isStill = function (el) {
                        return !el.querySelector("video");
                    };
                    for (var k = 0; k + 1 < items.length; k++) {
                        if (isStill(items[k]) && isStill(items[k + 1])) {
                            var target = (k + 3) % items.length;
                            if (isStill(items[target]))
                                target = (target + 1) % items.length;
                            var s = items[k + 1];
                            items[k + 1] = items[target];
                            items[target] = s;
                        }
                    }
                    items.forEach(function (el) {
                        c.appendChild(el);
                    });
                })();
            </script>
        </div>
    </div>
    </div>

    <style>
        .masonry-container {
            /* One column on mobile, two on tablet, three on desktop */
            column-count: 1;
            column-gap: 1rem;
            width: 100%;
            max-width: 100%;
        }

        @media (min-width: 768px) {
            .masonry-container {
                column-count: 2;
                column-gap: 2rem;
            }
            .masonry-item {
                margin-bottom: 2rem;
            }
        }

        @media (min-width: 1200px) {
            .masonry-container {
                column-count: 3;
            }
        }

        /* Masonry items */
        .masonry-item {
            display: block;
            /* break-inside is the key for columns */
            break-inside: avoid;
            -webkit-column-break-inside: avoid;
            page-break-inside: avoid;

            width: 100%;
            margin-bottom: 1rem;
            background: white;
            border-radius: 0.5rem;
            overflow: hidden;

            /* Simplify stacking to avoid Chrome rendering bugs in columns */
            position: relative;
        }

        /* Natural image sizing - no cropping for masonry */
        .masonry-item img {
            display: block;
            width: 100%;
            height: auto;
            object-fit: contain;
            transition: transform 0.3s ease;
            will-change: transform;
        }

        /* Image zoom effect on hover */
        .masonry-item:hover img {
            transform: scale(1.03);
        }

        /* Ensure image container doesn't show overflow */
        .masonry-item .relative {
            overflow: hidden;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            /* Keep difference-blended titles blending against the image
               while the browser composites during scroll; without an
               isolated stacking context the blend can drop out and the
               title flashes plain white. */
            isolation: isolate;
        }

        /* Project title overlaid on the image. White text with
           mix-blend-mode: difference inverts whatever is behind each
           letter (white -> black, orange -> blue, etc.). The overlay
           covers the whole image; a script sets the largest font-size
           at which the title still fits inside the rectangle. */
        .card-title {
            position: absolute;
            inset: 0;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #fff;
            font-weight: 700;
            mix-blend-mode: difference;
            line-height: 1.05;
            pointer-events: none;
            overflow: hidden;
        }
        .card-title-inner {
            display: inline-block;
        }

        /* One-sentence project description under each image. */
        .card-blurb {
            padding: 0.6rem 0.75rem 0.75rem;
            font-size: 0.875rem;
            line-height: 1.45;
            color: #6b7280;
        }

        /* Small static variant: sits in the upper-left corner at a fixed
           size instead of being fitted to fill the rectangle. */
        .card-title-small {
            inset: auto;
            top: 0.6rem;
            left: 0.6rem;
            display: block;
            text-align: left;
            font-size: 0.9rem;
            line-height: 1.2;
        }

        /* Text container stability */

        /* Prevent column breaks within cards */
        .masonry-item * {
            break-inside: avoid;
        }
    </style>

    <script>
        // Size each overlaid title to fill its card: binary-search the
        // largest font-size at which the text still fits both dimensions
        // of the image rectangle. Re-run when fonts arrive (metrics
        // change) and when the window resizes (card widths change).
        const fitTitle = (outer) => {
            const inner = outer.firstElementChild;
            const bw = outer.clientWidth;
            const bh = outer.clientHeight;
            if (!inner || !bw || !bh) return;
            let lo = 6;
            let hi = 600;
            for (let i = 0; i < 14; i++) {
                const mid = (lo + hi) / 2;
                outer.style.fontSize = mid + "px";
                if (inner.offsetWidth <= bw && inner.offsetHeight <= bh) {
                    lo = mid;
                } else {
                    hi = mid;
                }
            }
            outer.style.fontSize = lo + "px";
        };
        const fitAllTitles = () => {
            document
                .querySelectorAll(".card-title:not(.card-title-small)")
                .forEach(fitTitle);
        };
        fitAllTitles();
        document.fonts.ready.then(fitAllTitles);
        let fitTimer;
        window.addEventListener("resize", () => {
            clearTimeout(fitTimer);
            fitTimer = setTimeout(fitAllTitles, 150);
        });

        // Every card's video plays while it is on screen and pauses off
        // screen. H.264 is hardware-decoded, so all visible cards can move
        // at once without taxing the browser. Users who prefer reduced
        // motion keep the static posters.
        const videos = Array.from(
            document.querySelectorAll(".masonry-item video")
        );
        if (
            videos.length &&
            !window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
            const tryPlay = (v) => {
                const p = v.play();
                if (p) p.catch(() => {});
            };
            const io = new IntersectionObserver(
                (entries) => {
                    entries.forEach((e) => {
                        if (e.isIntersecting) tryPlay(e.target);
                        else e.target.pause();
                    });
                },
                { rootMargin: "100px" }
            );
            videos.forEach((v) => io.observe(v));

            // Back/forward restores from the browser's cache with videos
            // paused; resume the ones in view.
            window.addEventListener("pageshow", (event) => {
                if (!event.persisted) return;
                videos.forEach((v) => {
                    const r = v.getBoundingClientRect();
                    if (r.bottom > 0 && r.top < window.innerHeight)
                        tryPlay(v);
                });
            });
        }
    </script>
</BaseLayout>
