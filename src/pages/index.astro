---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Claire Nyquist | Health Data Visualization";
const description =
    "Claire Nyquist builds interactive data visualizations about public health. Master of Public Health + graphic design + R, Python, JavaScript, and D3. Based in Minneapolis.";

// Cells for the MEPS card preview (static mini-heatmap)
const heatRows = 5;
const heatCols = 9;
const heatCells = Array.from({ length: heatRows * heatCols }, (_, i) => {
    const r = Math.floor(i / heatCols);
    const c = i % heatCols;
    // deterministic pseudo-pattern, darker toward one corner
    const v =
        ((r * 37 + c * 53) % 70) / 100 + (r + c) / (heatRows + heatCols) / 2.5;
    return Math.min(0.95, v);
});

const moreViz = [
    { href: "/malaria", label: "Malaria" },
    { href: "/respiratoryviruses", label: "Respiratory Viruses" },
    { href: "/minnesota-bryophytes", label: "Minnesota Mosses" },
    { href: "/octopuses", label: "Octopuses" },
    { href: "/wilddyeplants", label: "Wild Dye Plants" },
    { href: "/ai-models-timeline", label: "AI Models Timeline" },
    { href: "/stanford-torus-explorer", label: "Stanford Torus Explorer" },
];
---

<script is:inline src="https://d3js.org/d3.v7.min.js"></script>

<BaseLayout title={title} description={description}>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Hero -->
        <section class="py-16 md:py-24">
            <div class="grid grid-cols-1 gap-10 items-start">
                <div class="max-w-3xl">
                    <p
                        class="text-5xl md:text-7xl mb-4 leading-tight name-gradient"
                        style="font-weight: 400;"
                    >
                        Claire Nyquist
                    </p>
                    <h1
                        class="text-2xl md:text-4xl text-gray-900 mb-6 leading-tight"
                    >
                        I build data visualizations about health.
                    </h1>
                    <p class="text-xl text-gray-600 leading-relaxed mb-4">
                        I have a Master of Public Health (University of
                        Minnesota), a degree in graphic communication design
                        (University of Westminster, First Class Honors), and
                        expertise in R, Python, JavaScript, and D3.
                    </p>
                    <p class="text-lg text-gray-600 leading-relaxed mb-8">
                        I've worked in public health consulting at ICF, vaccine
                        distribution at the Minnesota Department of Health, and
                        rapid diagnostic development at the University of
                        Minnesota. I also founded
                        <a
                            href="/tcplot"
                            class="text-blue-600 hover:text-blue-800 underline"
                            >tcplot</a
                        >, the Twin Cities data visualization community.
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <a
                            href="#work"
                            class="inline-flex items-center px-6 py-3 rounded-lg bg-blue-600 text-white font-medium hover:bg-blue-700 transition-colors"
                            >See the work</a
                        >
                        <a
                            href="/resume"
                            class="inline-flex items-center px-6 py-3 rounded-lg border border-gray-300 text-gray-700 font-medium hover:border-blue-600 hover:text-blue-600 transition-colors"
                            >Resumé</a
                        >
                        <a
                            href="mailto:clairenyquist@gmail.com"
                            class="inline-flex items-center px-6 py-3 rounded-lg border border-gray-300 text-gray-700 font-medium hover:border-blue-600 hover:text-blue-600 transition-colors"
                            >Get in touch</a
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- Featured work -->
        <section id="work" class="pb-16">
            <h2 class="text-2xl md:text-3xl font-semibold text-gray-900 mb-2">
                Featured work
            </h2>
            <p class="text-gray-600 mb-8">
                Interactive pieces created from public datasets — with the
                methods shown.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- MEPS card -->
                <a
                    href="/meps"
                    class="group bg-white rounded-lg shadow-md border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow"
                >
                    <div
                        class="h-40 bg-gray-50 flex items-center justify-center p-4"
                    >
                        <svg
                            viewBox={`0 0 ${heatCols * 20} ${heatRows * 20}`}
                            class="w-full h-full"
                            role="img"
                            aria-label="Stylized heatmap preview"
                        >
                            {
                                heatCells.map((v, i) => (
                                    <rect
                                        class="meps-cell"
                                        data-v={v}
                                        x={(i % heatCols) * 20 + 1}
                                        y={Math.floor(i / heatCols) * 20 + 1}
                                        width="18"
                                        height="18"
                                        rx="2"
                                        fill={`rgba(79, 70, 229, ${v})`}
                                    />
                                ))
                            }
                        </svg>
                    </div>
                    <div class="p-5">
                        <h3
                            class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 transition-colors"
                        >
                            Medical Expenditure Panel Survey
                        </h3>
                        <p class="text-sm text-gray-600 mt-2 leading-relaxed">
                            U.S. healthcare use, spending, and insurance
                            coverage by region and age — an animated D3 heatmap
                            of AHRQ survey data.
                        </p>
                        <p class="text-xs text-gray-400 mt-3">
                            D3 · AHRQ data · normalization methods included
                        </p>
                    </div>
                </a>

                <!-- Tuberculosis card -->
                <a
                    href="/tuberculosis"
                    class="group bg-white rounded-lg shadow-md border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow"
                >
                    <div
                        id="tb-preview"
                        class="h-40 bg-gray-50 flex items-center justify-center"
                        role="img"
                        aria-label="Concentric circles showing estimated tuberculosis incidence, notified cases, and deaths"
                    >
                    </div>
                    <div class="p-5">
                        <h3
                            class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 transition-colors"
                        >
                            Tuberculosis
                        </h3>
                        <p class="text-sm text-gray-600 mt-2 leading-relaxed">
                            The world's deadliest infectious disease — estimated
                            incidence and mortality by country, 2000–2024.
                        </p>
                        <p class="text-xs text-gray-400 mt-3">
                            D3 · WHO Global Tuberculosis Programme data
                        </p>
                    </div>
                </a>

                <!-- Met card -->
                <a
                    href="/themet"
                    class="group bg-white rounded-lg shadow-md border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow"
                >
                    <div class="h-40 bg-gray-100 relative overflow-hidden">
                        <img
                            id="met-img-a"
                            class="met-fade-img"
                            src="/images/met-initial.jpg"
                            style="opacity:1;"
                            alt=""
                            aria-hidden="true"
                        />
                        <img
                            id="met-img-b"
                            class="met-fade-img"
                            alt=""
                            aria-hidden="true"
                        />
                    </div>
                    <div class="p-5">
                        <h3
                            class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 transition-colors"
                        >
                            The Met Collection
                        </h3>
                        <p class="text-sm text-gray-600 mt-2 leading-relaxed">
                            1,000+ artworks from the Met's open-access
                            collection, colored by dominant hue and re-sorted as
                            you scroll.
                        </p>
                        <p class="text-xs text-gray-400 mt-3">
                            Canvas animation · Met Museum API
                        </p>
                    </div>
                </a>
            </div>

            <!-- More work -->
            <div class="mt-10">
                <p class="text-sm font-medium text-gray-500 mb-3">
                    More visualizations
                </p>
                <div class="flex flex-wrap gap-2">
                    {
                        moreViz.map((p) => (
                            <a
                                href={p.href}
                                class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-blue-600 hover:text-blue-600 transition-colors"
                            >
                                {p.label}
                            </a>
                        ))
                    }
                    <a
                        href="/graphic-design"
                        class="px-4 py-2 rounded-full border border-gray-200 text-sm text-gray-700 hover:border-blue-600 hover:text-blue-600 transition-colors"
                    >
                        Graphic Design
                    </a>
                </div>
            </div>
        </section>

        <!-- tcplot strip -->
        <section class="pb-20">
            <div
                class="bg-gray-50 border border-gray-200 rounded-lg p-8 md:flex md:items-center md:justify-between"
            >
                <div class="md:max-w-2xl">
                    <h2 class="text-xl font-semibold text-gray-900 mb-2">
                        tcplot — Twin Cities data visualization
                    </h2>
                    <p class="text-gray-600 leading-relaxed">
                        I founded and organize tcplot, a meetup for the Twin
                        Cities creative coding and data visualization community.
                        If you're local and you make charts, come say hi.
                    </p>
                </div>
                <a
                    href="/tcplot"
                    class="inline-flex items-center mt-6 md:mt-0 px-6 py-3 rounded-lg bg-gray-900 text-white font-medium hover:bg-gray-700 transition-colors"
                    >About tcplot</a
                >
            </div>
        </section>
    </div>

    <style>
        .met-fade-img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0;
            transition: opacity 1.2s ease;
        }
        /* .name-gradient now lives in BaseLayout's global styles. */
    </style>

    <script is:inline>
        (function () {
            "use strict";
            if (typeof d3 === "undefined") return;

            // --- MEPS card: recolor cells with the page's viridis scale ---
            d3.selectAll(".meps-cell").attr("fill", function () {
                var v = parseFloat(this.getAttribute("data-v")) || 0;
                return d3.interpolateViridis(v);
            });

            // --- TB card: concentric circles from the TB viz, outer pulsing ---
            (function tbPreview() {
                var container = document.getElementById("tb-preview");
                if (!container) return;
                var W = 300,
                    H = 160,
                    cx = W / 2,
                    cy = H / 2;
                var svg = d3
                    .select(container)
                    .append("svg")
                    .attr("viewBox", "0 0 " + W + " " + H)
                    .attr("width", "100%")
                    .attr("height", "100%");

                // Same encoding and palette as /tuberculosis:
                // outer = estimated incidence, middle = notified cases, inner = deaths
                var R_INC = 54,
                    R_NOT = 36,
                    R_DTH = 16;
                var incidence = svg
                    .append("circle")
                    .attr("cx", cx)
                    .attr("cy", cy)
                    .attr("r", R_INC)
                    .attr("fill", "#f0d0e8");
                svg.append("circle")
                    .attr("cx", cx)
                    .attr("cy", cy)
                    .attr("r", R_NOT)
                    .attr("fill", "#c054a0");
                svg.append("circle")
                    .attr("cx", cx)
                    .attr("cy", cy)
                    .attr("r", R_DTH)
                    .attr("fill", "#7b2d6e");

                function pulse() {
                    incidence
                        .transition()
                        .duration(1400)
                        .ease(d3.easeSinInOut)
                        .attr("r", R_INC + 9)
                        .transition()
                        .duration(1400)
                        .ease(d3.easeSinInOut)
                        .attr("r", R_INC)
                        .on("end", pulse);
                }
                pulse();
            })();

            // --- Met card: crossfade between random artworks every 2s ---
            (function metFade() {
                var imgA = document.getElementById("met-img-a");
                var imgB = document.getElementById("met-img-b");
                if (!imgA || !imgB) return;

                d3.csv("/data/met_colors.csv")
                    .then(function (rows) {
                        var artworks = rows.filter(function (r) {
                            return r.imageUrl;
                        });
                        if (artworks.length === 0) return;

                        var layers = [imgA, imgB];
                        var active = 0;

                        function randomUrl() {
                            return artworks[
                                Math.floor(Math.random() * artworks.length)
                            ].imageUrl;
                        }

                        function showNext() {
                            var next = 1 - active;
                            var loader = new Image();
                            loader.onload = function () {
                                layers[next].src = loader.src;
                                layers[next].style.opacity = "1";
                                layers[active].style.opacity = "0";
                                active = next;
                            };
                            // Skip silently on a broken image; try again next tick
                            loader.src = randomUrl();
                        }

                        // The static initial image (met-img-a) holds for the
                        // first interval, then crossfades to random artworks.
                        setInterval(showNext, 2000);
                    })
                    .catch(function () {
                        // CSV unavailable — the static initial image remains.
                    });
            })();
        })();
    </script>
</BaseLayout>
