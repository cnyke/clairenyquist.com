---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Whale Painting - Claire Nyquist" description="Marine life artistic study exploring ocean conservation themes">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Back Navigation -->
    <div class="mb-8">
      <a href="/graphic-design" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium">
        ← Back to Graphic Design
      </a>
    </div>

    <!-- Project Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl name-gradient mb-6">
        Whale Painting
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
        The whale is inspired by the small colored pencil drawings of Frank Lloyd Wright, such as his “Saguaro Forms and Cactus Flowers” and his geometric designs for stained glass or carpets of his innovative buildings. The whale’s bright colors of acrylics contrast with the natural wood. The whale painting sought to celebrate nature and the beauty of whales with color. 
      </p>
    </div>

    <!-- Project Gallery -->
    <div class="mb-16 flex justify-center">
      <div>
        <!-- Gallery Item 1 -->
        <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300">
          <div class="relative">
            <img
              src="/images/whale.jpg"
              alt="Tall geometric whale painted on wood grain, its body a dense patchwork of multicolored stripes, squares, and dots."
              class="featured-art h-auto object-contain"
            />
          </div>
        </div>
      </div>
    </div>


    <!-- Navigation -->
    <div class="mt-12 pt-8 border-t border-gray-200">
      <div class="flex justify-between items-center">
        <a href="/graphic-design" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium">
          ← Back to Graphic Design
        </a>
        <div class="text-sm text-gray-500">
          Artistic Work
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Natural image sizing - no cropping */
    img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: contain;
      transition: transform 0.3s ease;
    }

    /* Featured painting: sized to fit on screen without scrolling */
    .featured-art {
      width: auto;
      max-width: 100%;
      max-height: 150vh;
    }

    /* Card hover effects */
    .bg-white:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    /* Image zoom effect on hover */
    .bg-white:hover img {
      transform: scale(1.05);
    }

    /* Ensure image container doesn't show overflow */
    .relative {
      overflow: hidden;
    }
  </style>
</BaseLayout>
