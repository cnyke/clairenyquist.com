        /* ===== FLASHCARDS ===== */
        let order = DATA.map((_, i) => i);
        let pos = 0,
            flipped = false,
            activeGroup = "All";
        function groups() {
            return ["All", ...new Set(DATA.map((d) => d.group))];
        }
        function buildFilters() {
            const wrap = document.getElementById("cardFilters");
            wrap.innerHTML = "";
            groups().forEach((g) => {
                const b = document.createElement("button");
                b.textContent = g === "All" ? "All (" + DATA.length + ")" : g;
                if (g === activeGroup) b.className = "on";
                b.onclick = () => {
                    activeGroup = g;
                    rebuildOrder();
                    buildFilters();
                };
                wrap.appendChild(b);
            });
        }
        function rebuildOrder() {
            order = DATA.map((_, i) => i).filter(
                (i) => activeGroup === "All" || DATA[i].group === activeGroup,
            );
            pos = 0;
            flipped = false;
            render();
        }
        function render() {
            const d = DATA[order[pos]];
            document.getElementById("counter").textContent =
                pos + 1 + " / " + order.length + "  —  " + d.group;
            const c = document.getElementById("card");
            if (!flipped) {
                c.innerHTML = `<div class="group">${d.group}</div>
        <h2>${d.name}</h2>
        <div class="tap">▼ tap card to reveal how to ID it &amp; what to find ▼</div>`;
            } else {
                const items = d.structures
                    .map((s) => `<li><b>${s.name}</b> — ${s.desc}</li>`)
                    .join("");
                c.innerHTML = `<div class="group">${d.group}</div>
        <h2>${d.name}</h2>
        <div class="body">
          <div class="field"><div class="lab">How to spot it</div><div class="val">${d.idtip}</div></div>
          <div class="field"><div class="lab">Structures to identify</div><ul class="struct">${items}</ul></div>
          <div class="field"><div class="lab">Where / Function</div><div class="val">${d.location}<br><i>${d.func}</i></div></div>
        </div>`;
            }
        }
        function histoFlip() {
            flipped = !flipped;
            render();
        }
        function histoNext(e) {
            if (e) e.stopPropagation();
            pos = (pos + 1) % order.length;
            flipped = false;
            render();
        }
        function histoPrev(e) {
            if (e) e.stopPropagation();
            pos = (pos - 1 + order.length) % order.length;
            flipped = false;
            render();
        }
        function histoShuffle() {
            for (let i = order.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [order[i], order[j]] = [order[j], order[i]];
            }
            pos = 0;
            flipped = false;
            render();
        }

        /* ===== TABLE ===== */
        function buildTable() {
            const tb = document.getElementById("tbody");
            tb.innerHTML = "";
            let lastGroup = "";
            DATA.forEach((d) => {
                if (d.group !== lastGroup) {
                    lastGroup = d.group;
                    const gr = document.createElement("tr");
                    gr.className = "grouprow";
                    gr.innerHTML = `<td colspan="4">${d.group}</td>`;
                    tb.appendChild(gr);
                }
                const tr = document.createElement("tr");
                const struct = d.structures
                    .map((s) => `<b style="color:#2563eb">${s.name}</b>`)
                    .join(", ");
                tr.innerHTML = `<td class="name">${d.name}</td>
        <td>${d.idtip}</td>
        <td>${struct}</td>
        <td>${d.location}<br><i style="color:#6b7280">${d.func}</i></td>`;
                tb.appendChild(tr);
            });
        }

        /* ===== QUIZ ===== */
        let qSet = [],
            qIndex = 0,
            qScore = 0,
            qScope = "All";
        function startQuizScreen() {
            const w = document.getElementById("quizwrap");
            const opts = groups()
                .map(
                    (g) =>
                        `<option value="${g}">${g === "All" ? "All tissues" : g}</option>`,
                )
                .join("");
            w.innerHTML = `<div class="qstart">
      <h2 style="color:#2563eb;font-size:22px">Quiz Me</h2>
      <p style="color:#6b7280">Mixed questions: identify a tissue from its description, name its location/function, and match structures to the right tissue.</p>
      <p>Focus on: <select id="scope">${opts}</select></p>
      <button class="next" style="max-width:240px;margin:18px auto 0" onclick="histoBeginQuiz()">Start</button>
    </div>`;
        }
        function buildQuestions(scope) {
            const pool = DATA.filter(
                (d) => scope === "All" || d.group === scope,
            );
            let qs = [];
            pool.forEach((d) => {
                qs.push({
                    type: "ID this tissue",
                    q: d.idtip,
                    answer: d.name,
                    choices: pickChoices(
                        d.name,
                        DATA.map((x) => x.name),
                    ),
                });
                qs.push({
                    type: "Where is it found?",
                    q: d.name,
                    answer: d.location,
                    choices: pickChoices(
                        d.location,
                        DATA.map((x) => x.location),
                    ),
                });
                const s = d.structures[0];
                qs.push({
                    type: "Which tissue has this?",
                    q: `<b>${s.name}</b> — ${s.desc}`,
                    answer: d.name,
                    choices: pickChoices(
                        d.name,
                        DATA.map((x) => x.name),
                    ),
                });
            });
            shuffleArr(qs);
            return qs.slice(0, Math.min(15, qs.length));
        }
        function pickChoices(correct, all) {
            const others = [...new Set(all.filter((x) => x !== correct))];
            shuffleArr(others);
            const set = [correct, ...others.slice(0, 3)];
            shuffleArr(set);
            return set;
        }
        function shuffleArr(a) {
            for (let i = a.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [a[i], a[j]] = [a[j], a[i]];
            }
        }
        function histoBeginQuiz() {
            qScope = document.getElementById("scope").value;
            qSet = buildQuestions(qScope);
            qIndex = 0;
            qScore = 0;
            renderQuestion();
        }
        function renderQuestion() {
            const w = document.getElementById("quizwrap");
            if (qIndex >= qSet.length) {
                const pct = Math.round((100 * qScore) / qSet.length);
                w.innerHTML = `<div class="qend">
        <div class="scoreBig">${qScore} / ${qSet.length}</div>
        <p style="color:#6b7280">${pct}% — ${pct >= 85 ? "Excellent, you know these cold." : pct >= 65 ? "Solid. Re-run the ones that tripped you." : "Keep going — flip through the flashcards then quiz again."}</p>
        <button class="next" style="max-width:240px;margin:16px auto 0" onclick="startQuizScreen()">Again</button>
      </div>`;
                return;
            }
            const item = qSet[qIndex];
            const btns = item.choices
                .map(
                    (c) =>
                        `<button class="opt" onclick="histoAnswer(this,'${escAttr(c)}')">${c}</button>`,
                )
                .join("");
            w.innerHTML = `<div class="qmeta"><span>Question ${qIndex + 1} / ${qSet.length}</span><span>Score ${qScore}</span></div>
      <div class="qcard">
        <div class="qq"><small>${item.type}</small>${item.q}</div>
        ${btns}
        <div class="feedback" id="fb"></div>
      </div>`;
        }
        function escAttr(s) {
            return s.replace(/'/g, "\\'").replace(/"/g, "&quot;");
        }
        function histoAnswer(btn, choice) {
            const item = qSet[qIndex];
            const correct = choice === item.answer;
            document.querySelectorAll(".histo .opt").forEach((b) => {
                b.disabled = true;
                if (b.textContent === item.answer) b.classList.add("correct");
                else if (b === btn) b.classList.add("wrong");
            });
            const fb = document.getElementById("fb");
            if (correct) {
                qScore++;
                fb.className = "feedback ok";
                fb.textContent = "✓ Correct";
            } else {
                fb.className = "feedback no";
                fb.innerHTML = "✗ Answer: <b>" + item.answer + "</b>";
            }
            const card = document.querySelector(".histo .qcard");
            const nb = document.createElement("button");
            nb.className = "next";
            nb.textContent =
                qIndex + 1 >= qSet.length ? "See score" : "Next question";
            nb.onclick = () => {
                qIndex++;
                renderQuestion();
            };
            card.appendChild(nb);
        }

