                            result: "Skeletal muscle",
                            group: "Muscle",
                            why: "Striations + multinucleate + peripheral nuclei = voluntary skeletal.",
                        },
                    },
                    {
                        label: "Striped — short, BRANCHED cells; ONE central nucleus; dark cross-lines join them",
                        go: {
                            result: "Cardiac muscle",
                            group: "Muscle",
                            why: "Intercalated discs + branching + central nucleus = heart only.",
                        },
                    },
                    {
                        label: "NO stripes — spindle cells, ONE central football-shaped nucleus each",
                        go: {
                            result: "Smooth muscle",
                            group: "Muscle",
                            why: "No striations, single central nucleus = involuntary (gut, vessels).",
                        },
                    },
                ],
            },
            nerv: {
                q: "Nervous tissue — what are you looking at?",
                opts: [
                    {
                        label: "A large cell body with a big round nucleus + nucleolus, with arms (processes) extending out",
                        go: {
                            result: "Neuron",
                            group: "Nervous",
                            why: "Big soma + visible processes (axon/dendrites) = the neuron.",
                        },
                    },
                    {
                        label: "Just lots of small dark nuclei scattered around (between/around neurons)",
                        go: {
                            result: "Supporting cells (neuroglia)",
                            group: "Nervous",
                            why: "Small scattered nuclei, no processes visible = the glial cells.",
                        },
                    },
                ],
            },
        };
        let keyPath = [];
        function renderKey(nodeId) {
            const box = document.getElementById("keybox");
            const node = KEY[nodeId];
            const crumbs = keyPath.length
                ? `<div class="kpath">Your path: ${keyPath.map((p) => `<b>${p}</b>`).join(" &rarr; ")}</div>`
                : "";
            const opts = node.opts
                .map(
                    (o, i) =>
                        `<button class="kopt" onclick="histoKeyChoose('${nodeId}',${i})">${o.label}</button>`,
                )
                .join("");
            box.innerHTML = `<div class="kquestion">${crumbs}<div class="kq">${node.q}</div>${opts}</div>`;
        }
        function histoKeyChoose(nodeId, i) {
            const opt = KEY[nodeId].opts[i];
            keyPath.push(shortTag(opt.label));
            if (typeof opt.go === "object") {
                renderResult(opt.go);
            } else {
                renderKey(opt.go);
            }
        }
        function shortTag(label) {
            const w = label
                .replace(/[—–].*$/, "")
                .trim()
                .split(/\s+/)
                .slice(0, 4)
                .join(" ");
            return w.replace(/[,;].*$/, "");
        }
        function renderResult(r) {
            const box = document.getElementById("keybox");
            box.innerHTML = `<div class="kquestion kresult">
      <div class="gp">${r.group}</div>
      <div class="nm">${r.result}</div>
      <div class="why">${r.why}</div>
      <div class="kpath" style="text-align:center">Path: ${keyPath.map((p) => `<b>${p}</b>`).join(" &rarr; ")}</div>
      <div class="kbtns">
        <button onclick="histoOpenCard('${r.result.replace(/'/g, "\\'")}')">See full card</button>
        <button onclick="histoResetKey()">Start over</button>
      </div></div>`;
        }
        function histoResetKey() {
            keyPath = [];
            renderKey("start");
        }
        function histoOpenCard(name) {
            activeGroup = "All";
            rebuildOrder();
            buildFilters();
            const idx = order.findIndex((i) => DATA[i].name === name);
            if (idx >= 0) {
                pos = idx;
                flipped = true;
                render();
            }
            document
                .querySelector('.histo-tabs button[data-view="cards"]')
                .click();
        }

        /* ===== LOOK-ALIKES ===== */
        const CONFUSE = [
            {
                vs: "Simple cuboidal  vs.  Simple columnar",
                tell: "Both are a single layer with one nucleus per cell — judge the <span class='a'>height</span>.",
                key: "Cuboidal = <b>cube, round central nucleus</b>. Columnar = <b>tall, oval nucleus down at the base</b>.",
            },
            {
                vs: "Simple columnar  vs.  Pseudostratified columnar",
                tell: "Both have tall cells — look at the <span class='a'>nuclei</span>.",
                key: "Simple columnar = nuclei in <b>one tidy row</b>. Pseudostratified = nuclei at <b>many heights</b> (and usually <b>cilia + goblet cells</b>).",
            },
            {
                vs: "Pseudostratified columnar  vs.  true Stratified",
                tell: "Decide whether every cell reaches the <span class='a'>basement membrane</span>.",
                key: "Pseudostratified = <b>all cells touch the base</b> (only looks layered). Stratified = <b>real stacked layers</b>; top cells don't reach the bottom.",
            },
            {
                vs: "Transitional  vs.  Stratified squamous",
                tell: "Both are multilayered — look at the <span class='a'>surface cells</span>.",
                key: "Transitional = <b>large rounded 'dome/umbrella' top cells</b> (urinary). Stratified squamous = <b>flat top cells</b> (skin/mouth).",
            },
            {
                vs: "Areolar (loose)  vs.  Reticular c.t.",
                tell: "Both are fibrous and cell-sparse — judge fiber <span class='a'>type & density</span>.",
                key: "Areolar = <b>loose mix of collagen + elastic in gel</b>. Reticular = <b>fine branching net</b> (silver-black), forms lymph-organ scaffold.",
            },
            {
                vs: "Dense regular  vs.  Dense irregular c.t.",
                tell: "Both are packed with collagen — look for a <span class='a'>grain</span>.",
                key: "Regular = fibers <b>all parallel</b> (one direction, tendon). Irregular = fibers <b>every direction</b> (no grain, dermis).",
            },
            {
                vs: "Dense regular c.t.  vs.  Smooth muscle",
                tell: "Both are pink with long nuclei and no striations — a classic mix-up.",
                key: "Dense regular = <b>wavy collagen fibers</b>, very <b>flat/thin nuclei</b> in rows, no cytoplasm visible. Smooth muscle = <b>solid spindle cells</b> with plumper <b>football nuclei</b>, no fibers between them.",
            },
            {
                vs: "Hyaline  vs.  Elastic  vs.  Fibrocartilage",
                tell: "All three have chondrocytes in lacunae — read the <span class='a'>matrix</span>.",
                key: "Hyaline = <b>smooth glassy, no fibers</b>. Elastic = <b>dark branching elastic fibers</b>. Fibrocartilage = <b>thick collagen bundles + chondrocytes in rows</b>.",
            },
            {
                vs: "Hyaline cartilage  vs.  Bone",
                tell: "Both are firm with cells in lacunae — look for <span class='a'>rings</span>.",
                key: "Cartilage = <b>smooth matrix, no rings</b>. Bone = <b>osteons</b> — concentric <b>lamellae</b> around a <b>central canal</b>.",
            },
            {
                vs: "Fibrocartilage  vs.  Dense regular c.t.",
                tell: "Both show parallel collagen — look for <span class='a'>lacunae</span>.",
                key: "Fibrocartilage has <b>chondrocytes sitting in lacunae</b> between the fibers. Dense regular has <b>only flat fibroblast nuclei</b> — no lacunae.",
            },
            {
                vs: "Skeletal  vs.  Cardiac  vs.  Smooth muscle",
                tell: "Work it as striations &rarr; nuclei.",
                key: "Skeletal = <b>striped, many nuclei at the edge</b>. Cardiac = <b>striped, branched, one central nucleus, intercalated discs</b>. Smooth = <b>no stripes, one central nucleus</b>.",
            },
            {
                vs: "Neuron  vs.  Neuroglia",
                tell: "Both are in nervous tissue — judge the <span class='a'>cell size</span>.",
                key: "Neuron = <b>large body, big nucleus + nucleolus, visible processes</b>. Glia = <b>small scattered nuclei</b>, no processes seen (and far more numerous).",
            },
        ];
        function buildConfuse() {
            document.getElementById("confuse").innerHTML = CONFUSE.map(
                (c) => `<div class="pair">
      <div class="vs">${c.vs}</div>
      <div class="tell">${c.tell}</div>
      <div class="key">${c.key}</div></div>`,
            ).join("");
        }

        /* ===== SLIDE IMAGES (Google Images links) ===== */
        function imgQuery(name) {
            const q =
                name.replace(/c\.t\./gi, "connective tissue") + " histology";
            return (
                "https://www.google.com/search?tbm=isch&q=" +
                encodeURIComponent(q)
            );
        }
        function buildImages() {
            let html = "",
                lastGroup = "";
            DATA.forEach((d) => {
                if (d.group !== lastGroup) {
                    if (lastGroup) html += "</div></div>";
                    lastGroup = d.group;
                    html += `<div class="imggroup"><h4>${d.group}</h4><div class="imglinks">`;
                }
                html += `<a class="imglink" href="${imgQuery(d.name)}" target="_blank" rel="noopener noreferrer">
        <span>${d.name}</span><span class="arrow">Images &#8599;</span></a>`;
            });
            if (lastGroup) html += "</div></div>";
            document.getElementById("imagebox").innerHTML = html;
        }

        /* ===== VIEW SWITCHING ===== */
        document.querySelectorAll(".histo-tabs button").forEach((b) => {
            b.onclick = () => {
                document
                    .querySelectorAll(".histo-tabs button")
                    .forEach((x) => x.classList.remove("active"));
                b.classList.add("active");
                const v = b.dataset.view;
                ["key", "cards", "table", "images", "quiz"].forEach((id) =>
                    document
                        .getElementById(id)
                        .classList.toggle("hide", id !== v),
                );
                if (v === "quiz") startQuizScreen();
            };
        });
        document.getElementById("card").addEventListener("click", histoFlip);

        /* init */
        buildFilters();
        rebuildOrder();
        buildTable();
        renderKey("start");
        buildConfuse();
        buildImages();
    </script>
</BaseLayout>
