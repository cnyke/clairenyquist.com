                    ["moth", [20, 18], "Agrochola Antheraea Halysidota Hypoprepia Pyrrharctia Cucullia Caenurgina Idia Lacinipolia Mythimna Orthonama Phaeoura Galgula Udea Pyrausta Pyralis Microcrambus Psyche Emmelina Hemaris"],
                    ["honey-bee", [15, 16], "Apis"],
                    ["boxelder-bug", [21, 14], "Boisea Arocatus Oncopeltus Leptopterna Poecilocapsus Orius"],
                    ["leafhopper", [11, 14], "Graphocephala Jikradia Orientus Acanalonia Metcalfa Cyrtolobus Pachypsylla Daktulosphaira"],
                    ["stink-bug", [12, 14], "Halyomorpha Cosmopepla Acholla"],
                    ["ant", [19, 10], "Camponotus Lasius Prenolepis"],
                ],
                Plants: [
                    ["milkweed", [15, 20], "Asclepias"],
                    ["aster", [11, 20], "Achillea Ageratina Ambrosia Arctium Artemisia Cichorium Cirsium Cosmos Echinacea Erechtites Erigeron Eutrochium Gaillardia Heliopsis Heterotheca Nabalus Ratibida Rudbeckia Silphium Solidago Tanacetum Tragopogon"],
                    ["grapevine", [22, 20], "Vitis Parthenocissus Sicyos Campsis Convolvulus"],
                    ["tree-leaf", [12, 20], "Acer Amelanchier Berberis Catalpa Celtis Fraxinus Juglans Morus Ostrya Philadelphus Physocarpus Populus Prunus Rhamnus Sorbaria Sorbus Ulmus"],
