                    ["mullein", [8, 22], "Verbascum"],
                    ["violet", [16, 18], "Viola"],
                    ["creeping-charlie", [19, 16], "Glechoma"],
                    ["conifer", [10, 22], "Juniperus Larix"],
                    ["berry-branch", [19, 20], "Sambucus Lonicera"],
                ],
                Arachnids: [
                    ["orb-weaver", [20, 20], "Argiope Neoscona"],
                    ["jumping-spider", [21, 14], "Phidippus Salticus Attulus Eris"],
                    ["tick", [13, 14], "Dermacentor Amblyomma"],
                    ["harvestman", [27, 18], "Phalangium"],
                    ["grass-spider", [17, 18], "Agelenopsis"],
                ],
                Mammals: [
                    ["squirrel", [19, 20], "Sciurus"],
                    ["rabbit", [18, 20], "Sylvilagus"],
                    ["chipmunk", [19, 18], "Tamias"],
                    ["raccoon", [28, 18], "Procyon"],
                    ["shrew", [28, 12], "Blarina"],
                ],
                Fungi: [
                    ["bracket-fungus", [17, 18], "Trametes Laetiporus"],
                    ["lichen", [17, 16], "Oxneria"],
                ],
                Other: [
                    ["pillbug", [14, 14], "Porcellio Porcellionides Armadillidium"],
                    ["turtle", [32, 16], "Chrysemys"],
                    ["millipede", [22, 14], "Oxidus"],
                    ["slime-mold", [14, 14], "Fuligo"],
                ],
            };
            const iconDefByGenus = {};
            const defByIconName = {};
            GROUPS.forEach((g) => (defByIconName[g.icon] = g));
            Object.entries(SUBICONS).forEach(([groupKey, list]) => {
                iconDefByGenus[groupKey] = {};
                list.forEach(([icon, size, genera]) => {
                    const def = { icon, size };
                    defByIconName[icon] = def;
                    genera.split(" ").forEach(
                        (genus) => (iconDefByGenus[groupKey][genus] = def),
                    );
                });
            });
            function iconDefFor(groupKey, species) {
                const genus = (species || "").split(" ")[0];
                return (
                    iconDefByGenus[groupKey][genus] ||
                    GROUPS.find((g) => g.key === groupKey)
                );
            }

            // Estimated dominant color per genus — the color you'd name if
            // asked "what color is a cardinal?" — with species overrides
            // where one genus spans very different looks. Anything unlisted
            // falls back to its lifeform's color. Very-pale species are
            // nudged toward a readable gray so they survive a white map.
            const SPECIES_COLOR = {
                "Spinus pinus": "#9b8455", // pine siskin: streaky brown, not goldfinch gold
            };
            const GENUS_COLOR = {
                // Birds
                Poecile: "#8a9099", Cardinalis: "#d21f26", Passer: "#8a6f4b",
                Corvus: "#4d545c", Haemorhous: "#c8506b", Spinus: "#e6b90c",
                Dryobates: "#454a52", Leuconotopicus: "#454a52", Dryocopus: "#2e2b2b",
                Melanerpes: "#b3503c", Colaptes: "#a8763f", Sphyrapicus: "#9c5748",
                Turdus: "#c25e28", Cyanocitta: "#3f7fd6", Sitta: "#6e87a8",
                Troglodytes: "#a3743f", Thryothorus: "#a3743f", Chaetura: "#6d625a",
                Anas: "#2e7d4f", Aix: "#916044", Spatula: "#5b7f68",
                Lophodytes: "#3c3f45", Gavia: "#2f3438", Zenaida: "#b09a86",
