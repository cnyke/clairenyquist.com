                Astur: "#8a6a48", Buteo: "#8a6a48", Falco: "#7a5f4a",
                Circus: "#7d7469", Haliaeetus: "#5a4c3c", Pandion: "#5a4c3c",
                Cathartes: "#4a3f3c", Bubo: "#8a7355", Strix: "#8a7355",
                Agelaius: "#322a28", Quiscalus: "#3d3a55", Molothrus: "#4a3c33",
