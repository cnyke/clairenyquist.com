---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Audubon Park | Claire Nyquist"
    description="A map of every species occurrence recorded in GBIF for the Audubon Park neighborhood of Northeast Minneapolis, drawn as lifeform icons on a minimalist basemap."
>
    <div class="px-4 py-8">
        <!-- Hero Section -->
        <div class="text-center mb-8">
            <h1 class="text-4xl md:text-6xl name-gradient mb-4">
                Audubon Park
            </h1>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
                Every species occurrence recorded in the Global Biodiversity
                Information Facility for the Audubon Park neighborhood of
                Northeast Minneapolis, mapped where it was observed.
            </p>
            <p
                class="text-lg text-gray-600 max-w-4xl mx-auto leading-relaxed mt-4"
            >
                Each icon marks a spot where a species was recorded — a sparrow
                for birds, a butterfly for insects, a fern for plants. Click
                any icon for the species behind it, with a photo where an
                observer shared one. Species recorded at the very same spot
                are fanned out into a small spiral so each one stays visible.
            </p>
        </div>

        <!-- Legend -->
        <div
            id="legend"
            class="flex flex-wrap justify-center gap-x-5 gap-y-2 mb-4 text-sm text-gray-700"
        >
        </div>

        <!-- Map -->
        <div class="max-w-6xl mx-auto">
            <div
                id="map"
                class="w-full rounded-lg border border-gray-200"
                style="height: 640px; background:#fafafa;"
            >
            </div>
            <p id="stat-line" class="text-sm text-gray-500 mt-2 text-center"></p>
        </div>

        <!-- Sources & citations -->
        <div class="max-w-4xl mx-auto mt-10 text-xs text-gray-400 space-y-2">
            <p>
                <strong class="text-gray-500">Data:</strong> GBIF occurrence
                records queried within the OpenStreetMap boundary of the
                Audubon Park neighborhood, Minneapolis — mostly eBird and
                iNaturalist observations, plus a 2015&ndash;2018 wild-bee
                survey. GBIF reflects what observers have recorded and shared,
                not a complete inventory. Citation: GBIF.org (21 August 2026),
                GBIF Occurrence Search, retrieved via the
                <a
                    href="https://techdocs.gbif.org/en/openapi/v1/occurrence"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline hover:text-gray-600">GBIF API</a
                >. Global Biodiversity Information Facility,
                <a
                    href="https://www.gbif.org"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline hover:text-gray-600">gbif.org</a
                >.
            </p>
            <p id="icon-citations">
                <strong class="text-gray-500">Icons:</strong>
            </p>
            <p>
                <strong class="text-gray-500">Basemap:</strong> &copy;
                <a
                    href="https://www.openstreetmap.org/copyright"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline hover:text-gray-600"
                    >OpenStreetMap contributors</a
                >, tiles by
                <a
                    href="https://carto.com/attributions"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline hover:text-gray-600">CARTO</a
                >. Neighborhood boundary from OpenStreetMap.
            </p>
        </div>
    </div>

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    ></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/d3-dsv@3/dist/d3-dsv.min.js"
    ></script>

    <style is:global>
        .species-icon {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .species-icon svg {
            width: 100%;
            height: 100%;
            filter: drop-shadow(0 0 1.5px rgba(255, 255, 255, 0.9));
        }
        .leaflet-popup-content {
            font-family: "Helvetica Neue", Inter, sans-serif;
            font-size: 13px;
            line-height: 1.5;
        }
    </style>

    <script is:inline>
        (function () {
            // One icon + one color per lifeform. Icons are game-icons.net
            // (CC BY 3.0), recolored via currentColor; colors are a
            // CVD-validated categorical palette.
            const GROUPS = [
                { key: "Birds", color: "#2a78d6", icon: "sparrow", iconName: "Sparrow", author: "Lorc", match: (d) => d.class === "Aves" },
                { key: "Insects", color: "#eb6834", icon: "butterfly", iconName: "Butterfly", author: "Lorc", match: (d) => d.class === "Insecta" },
                { key: "Plants", color: "#1baf7a", icon: "fern", iconName: "Fern", author: "Delapouite", match: (d) => d.kingdom === "Plantae" },
                { key: "Arachnids", color: "#eda100", icon: "hanging-spider", iconName: "Hanging spider", author: "Lorc", match: (d) => d.class === "Arachnida" },
                { key: "Mammals", color: "#e87ba4", icon: "paw-print", iconName: "Paw print", author: "Lorc", match: (d) => d.class === "Mammalia" },
                { key: "Fungi", color: "#008300", icon: "mushrooms", iconName: "Mushrooms", author: "Delapouite", match: (d) => d.kingdom === "Fungi" },
                { key: "Other", color: "#4a3aa7", icon: "snail", iconName: "Snail", author: "Lorc", match: () => true },
            ];
            const groupOf = (d) => GROUPS.find((g) => g.match(d));

            // Icon citations (CC BY 3.0 requires attribution)
            const cit = document.getElementById("icon-citations");
            GROUPS.forEach((g, i) => {
                cit.innerHTML +=
                    `${g.key}: “${g.iconName}” by ${g.author}` +
                    (i < GROUPS.length - 1 ? " · " : "");
            });
            cit.innerHTML +=
                ` — all from <a href="https://game-icons.net" target="_blank" rel="noopener noreferrer" class="underline hover:text-gray-600">game-icons.net</a>, licensed <a href="https://creativecommons.org/licenses/by/3.0/" target="_blank" rel="noopener noreferrer" class="underline hover:text-gray-600">CC BY 3.0</a>.`;

            // Minimalist white & gray basemap
            const map = L.map("map", { scrollWheelZoom: false });
            L.tileLayer(
                "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
                {
                    attribution:
                        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
                    maxZoom: 20,
                },
            ).addTo(map);

            const svgCache = {};
            function loadIcons() {
                return Promise.all(
                    GROUPS.map((g) =>
                        fetch(`/images/species-icons/${g.icon}.svg`)
                            .then((r) => r.text())
                            .then((t) => (svgCache[g.icon] = t)),
                    ),
                );
            }

            function makeIcon(g) {
                return L.divIcon({
                    className: "species-icon",
                    html: `<span style="color:${g.color};display:block;width:20px;height:20px">${svgCache[g.icon]}</span>`,
                    iconSize: [20, 20],
                    iconAnchor: [10, 10],
                    popupAnchor: [0, -10],
                });
            }

            function yearsLabel(a, b) {
                return a === b ? String(a) : `${a}–${b}`;
            }

            Promise.all([
                loadIcons(),
                fetch("/data/audubon_neighborhood_occurrences.csv").then((r) =>
                    r.text(),
                ),
                fetch("/data/audubon_neighborhood_boundary.geojson").then((r) =>
                    r.json(),
                ),
            ]).then(([, csvText, boundary]) => {
                const rows = d3.csvParse(csvText);

                // Any record of a species may carry its common name — share
                // them so every popup can show one where it exists.
                const commonOf = {};
                rows.forEach((d) => {
                    if (d.common && !commonOf[d.species])
                        commonOf[d.species] = d.common;
                });

                // Aggregate: one marker per species per exact spot, so a
                // hotspot's 1,400 checklists become one icon with a count.
                const spots = new Map();
                const speciesPerGroup = {};
                const speciesSeen = {};
                rows.forEach((d) => {
                    if (!d.lat || !d.lon) return;
                    const g = groupOf(d);
                    (speciesSeen[g.key] = speciesSeen[g.key] || new Set()).add(
                        d.species,
                    );
                    const key = `${d.species}|${d.lat}|${d.lon}`;
                    let s = spots.get(key);
                    if (!s) {
                        s = {
                            species: d.species,
                            group: g,
                            lat: +d.lat,
                            lon: +d.lon,
                            count: 0,
                            minYear: Infinity,
                            maxYear: -Infinity,
                            photo: "",
                            photoBy: "",
                            photoLicense: "",
                        };
                        spots.set(key, s);
                    }
                    s.count += 1;
                    if (d.photo && !s.photo) {
                        s.photo = d.photo;
                        s.photoBy = d.photoBy;
                        s.photoLicense = d.photoLicense;
                    }
                    const y = +d.year;
                    if (y) {
                        s.minYear = Math.min(s.minYear, y);
                        s.maxYear = Math.max(s.maxYear, y);
                    }
                });

                GROUPS.forEach(
                    (g) => (speciesPerGroup[g.key] = (speciesSeen[g.key] || new Set()).size),
                );

                // Legend
                const legend = document.getElementById("legend");
                GROUPS.forEach((g) => {
                    if (!speciesPerGroup[g.key]) return;
                    const span = document.createElement("span");
                    span.className = "inline-flex items-center gap-1.5";
                    span.innerHTML = `<span style="color:${g.color};display:inline-block;width:18px;height:18px">${svgCache[g.icon]}</span>${g.key} <span class="text-gray-400">(${speciesPerGroup[g.key]} species)</span>`;
                    legend.appendChild(span);
                });

                // Neighborhood boundary
                const boundaryLayer = L.geoJSON(boundary, {
                    style: {
                        color: "#9ca3af",
                        weight: 2,
                        dashArray: "6 6",
                        fill: false,
                    },
                }).addTo(map);
                map.fitBounds(boundaryLayer.getBounds().pad(0.05));

                // Markers: icons only, no clustering. Species stacked at the
                // exact same coordinate (eBird hotspots) are dodged into a
                // small golden-angle spiral so every icon stays visible.
                const byCoord = new Map();
                spots.forEach((s) => {
                    const k = `${s.lat}|${s.lon}`;
                    (byCoord.get(k) || byCoord.set(k, []).get(k)).push(s);
                });
                const STEP = 0.000055; // ~6 m per spiral step
                const cosLat = Math.cos((45.02 * Math.PI) / 180);
                byCoord.forEach((group) => {
                    if (group.length === 1) return;
                    group.forEach((s, i) => {
                        const r = STEP * Math.sqrt(i);
                        const a = i * 2.39996;
                        s.lat += r * Math.cos(a);
                        s.lon += (r * Math.sin(a)) / cosLat;
                    });
                });

                const icons = {};
                GROUPS.forEach((g) => (icons[g.key] = makeIcon(g)));

                function licenseShort(url) {
                    const m = (url || "").match(
                        /licenses\/([a-z-]+)\/([0-9.]+)/i,
                    );
                    return m ? `CC ${m[1].toUpperCase()} ${m[2]}` : "";
                }

                spots.forEach((s) => {
                    const m = L.marker([s.lat, s.lon], {
                        icon: icons[s.group.key],
                    });
                    const common = commonOf[s.species];
                    let html = "";
                    if (s.photo) {
                        const src = s.photo.replace(
                            "/original.",
                            "/medium.",
                        );
                        html += `<img src="${src}" alt="${common || s.species}" loading="lazy" style="width:220px;max-height:170px;object-fit:cover;border-radius:6px;margin-bottom:6px;display:block">`;
                    }
                    if (common) html += `<strong>${common}</strong><br>`;
                    html += `<em>${s.species}</em>`;
                    html += `<br><span style="color:#666">${s.group.key}</span>`;
                    html += `<br>${s.count.toLocaleString()} observation${s.count === 1 ? "" : "s"} here`;
                    if (s.minYear !== Infinity)
                        html += ` · ${yearsLabel(s.minYear, s.maxYear)}`;
                    if (s.photo && (s.photoBy || s.photoLicense))
                        html += `<br><span style="color:#999;font-size:11px">Photo: ${s.photoBy || "unknown"}${licenseShort(s.photoLicense) ? ", " + licenseShort(s.photoLicense) : ""}, via iNaturalist/GBIF</span>`;
                    m.bindPopup(html, { maxWidth: 240 });
                    m.addTo(map);
                });

                const totalObs = rows.length;
                const totalSpecies = new Set(rows.map((d) => d.species)).size;
                document.getElementById("stat-line").textContent =
                    `${totalSpecies} species · ${totalObs.toLocaleString()} observations · ${spots.size.toLocaleString()} mapped locations`;
            });
        })();
    </script>
</BaseLayout>
