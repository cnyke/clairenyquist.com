                Roeseliana: "#7c8250", Polistes: "#8a6222", Vespula: "#d9b31c",
                Dolichovespula: "#43403a", Boisea: "#63302e", Halyomorpha: "#7a6b5c",
                Cosmopepla: "#3d3a45", Oncopeltus: "#d4581f", Graphocephala: "#38a457",
                Jikradia: "#8a7a5c", Libellula: "#4f7fae", Aeshna: "#2f7f7a",
                Anax: "#2e8f66", Sympetrum: "#c04a30", Argia: "#3b7fd0",
                Toxomerus: "#c2a02c", Eristalis: "#8a6a35", Helophilus: "#b1912c",
                Sericomyia: "#a5892e", Camponotus: "#3a3230", Lasius: "#6b4b2f",
                Prenolepis: "#7a5a3a", Tipula: "#9a8a70", Antheraea: "#b57f3f",
                Pyrrharctia: "#c78f3a", Hypoprepia: "#c14a58", Hemaris: "#8a6f3f",
                // Plants that aren't dominantly green
                Asclepias: "#cf7a5f", Solidago: "#dcb50f", Rudbeckia: "#dfa50f",
                Heliopsis: "#dfaf12", Heterotheca: "#dcb015", Gaillardia: "#d97a2a",
                Ratibida: "#dca818", Silphium: "#dcb012", Echinacea: "#b65fa0",
                Cirsium: "#b05fa8", Arctium: "#9a5f9a", Cosmos: "#c9679a",
                Cichorium: "#6f8fd8", Campanula: "#6f7fd8", Scilla: "#4a5fd0",
                Mertensia: "#5b6fd0", Aquilegia: "#b0507a", Viola: "#7a4fd0",
                Verbena: "#7a5fd0", Monarda: "#b05f8a", Nepeta: "#8a7fd0",
                Leonurus: "#b08ab0", Agastache: "#8a7fd8", Blephilia: "#a58ac0",
                Ajuga: "#6a5fd0", Tradescantia: "#6a5fc9", Phlox: "#b06fc0",
                Dianthus: "#cf4f7a", Saponaria: "#cf9ab0", Persicaria: "#c97a9a",
                Chelone: "#cf9ab8", Geum: "#b56a6a", Crocus: "#9a6fd0",
                Hackelia: "#8a92c9", Borago: "#4f7fd8", Eryngium: "#7a8fc0",
                Hydrophyllum: "#8a92c9", Verbascum: "#d9c520", Oxalis: "#dcc520",
                Ranunculus: "#e0c318", Lotus: "#d9b520", Lamium: "#cfc030",
                Linaria: "#dcc030", Lysimachia: "#dcb818", Zizia: "#dcbf1c",
                Tanacetum: "#dcc020", Lithospermum: "#dcaf1c", Chamaecrista: "#dcb51c",
                Impatiens: "#e08a2f", Hemerocallis: "#e0812f", Campsis: "#d05f2a",
                Trifolium: "#a2597b", Melilotus: "#d9cf9a", Coronilla: "#c987a5",
                Sambucus: "#4f3f5f", Lonicera: "#b5584a", Artemisia: "#9aa383",
                Mirabilis: "#c05f9a", Portulaca: "#d9a02f",
                // Mammals
                Sciurus: "#8a8d92", Tamias: "#a5623a", Sylvilagus: "#96826d",
                Procyon: "#6f6f74", Blarina: "#4f5257", Vulpes: "#c2542a",
                // Fungi & lichen
                Trametes: "#a58a5f", Laetiporus: "#e0912a", Oxneria: "#d9a025",
                Xylaria: "#3a3734", Puccinia: "#c9701c", Agaricaceae: "#b5a487",
                // Arachnids
                Argiope: "#c8a51c", Neoscona: "#8a6a45", Agelenopsis: "#8a7050",
                Phidippus: "#4a3f3d", Salticus: "#5a5a58", Attulus: "#6a6258",
                Eris: "#5f4f42", Dermacentor: "#6b4032", Amblyomma: "#7a4f35",
                Phalangium: "#8a7a5f", Theridion: "#8a7562", Misumessus: "#7ec253",
                // Other
                Chrysemys: "#4f6b4a", Porcellio: "#6a6f76", Porcellionides: "#6a6f76",
                Armadillidium: "#5f646b", Oxidus: "#6b5b45", Fuligo: "#e3c318",
                Ladislavella: "#8a7355",
            };
            function colorFor(s) {
                return (
                    SPECIES_COLOR[s.species] ||
                    GENUS_COLOR[(s.species || "").split(" ")[0]] ||
                    s.group.color
                );
            }

            document.getElementById("icon-citations").innerHTML =
                `<strong class="text-gray-500">Icons:</strong> line-art icon set generated with Google Gemini for this page, then cropped, recolored, and matched to species for the map.`;

            // Minimalist white & gray basemap
            // zoomSnap 0 allows an exact fractional starting zoom, so the
            // boundary's edges can sit right at the frame instead of
            // snapping a whole level out. gestureHandling makes touch
            // friendly: one finger scrolls the page, two fingers move the
            // map (and desktop wheel zoom needs ctrl/cmd).
            const map = L.map("map", { zoomSnap: 0, gestureHandling: true });
            L.tileLayer(
                "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
                {
                    attribution:
                        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
                    maxZoom: 20,
                },
            ).addTo(map);

            function iconImg(def, h, src, flip) {
                const w = Math.round((def.size[0] / def.size[1]) * h);
                return `<img src="${src || `/images/species-icons/${def.icon}.png`}" alt="" style="width:${w}px;height:${h}px;object-fit:contain${flip ? ";transform:scaleX(-1)" : ""}">`;
            }

            // One knob for overall marker size; sizes in the tables above
            // stay proportional to each drawing.
            const ICON_SCALE = 2.7;
            function makeIcon(def, src, flip) {
                const w = Math.round(def.size[0] * ICON_SCALE);
                const h = Math.round(def.size[1] * ICON_SCALE);
                return L.divIcon({
                    className: "species-icon",
                    html: iconImg(def, h, src, flip),
                    iconSize: [w, h],
                    iconAnchor: [w / 2, h / 2],
                    popupAnchor: [0, -h / 2],
                });
            }

            // The icon files are black line art on transparency; markers get
            // their viridis color painted in at runtime via canvas.
            const baseImgs = {};
            function preloadIcon(name) {
                return new Promise((resolve) => {
                    const img = new Image();
                    img.onload = () => resolve();
                    img.onerror = () => resolve();
                    img.src = `/images/species-icons/${name}.png`;
                    baseImgs[name] = img;
                });
            }

            const srcCache = {};
            function tintedSrc(iconName, color) {
                const key = iconName + "|" + color;
                if (!srcCache[key]) {
                    const img = baseImgs[iconName];
                    const c = document.createElement("canvas");
                    c.width = img.naturalWidth;
                    c.height = img.naturalHeight;
                    const ctx = c.getContext("2d");
                    ctx.drawImage(img, 0, 0);
                    ctx.globalCompositeOperation = "source-in";
                    ctx.fillStyle = color;
                    ctx.fillRect(0, 0, c.width, c.height);
                    srcCache[key] = c.toDataURL();
                }
                return srcCache[key];
            }

            const tintCache = {};
            function tintedIcon(def, color, flip) {
                const key = def.icon + "|" + color + (flip ? "|f" : "");
                if (!tintCache[key])
                    tintCache[key] = makeIcon(
                        def,
                        tintedSrc(def.icon, color),
                        flip,
                    );
                return tintCache[key];
            }

            function yearsLabel(a, b) {
                return a === b ? String(a) : `${a}–${b}`;
            }

            Promise.all([
                fetch("/data/audubon_neighborhood_occurrences.csv").then((r) =>
                    r.text(),
                ),
                fetch("/data/audubon_neighborhood_boundary.geojson").then((r) =>
                    r.json(),
                ),
                Promise.all(Object.keys(defByIconName).map(preloadIcon)),
            ]).then(([csvText, boundary]) => {
                const rows = d3.csvParse(csvText);

                // Total records per species, shown in the popups
                const speciesTotal = {};
                rows.forEach((d) => {
                    if (d.species)
                        speciesTotal[d.species] =
                            (speciesTotal[d.species] || 0) + 1;
                });

                // Any record of a species may carry its common name — share
                // them so every popup can show one where it exists.
                const commonOf = {};
                rows.forEach((d) => {
                    if (d.common && !commonOf[d.species])
                        commonOf[d.species] = d.common;
                });

                // Aggregate: one marker per species per exact spot, so a
                // hotspot's 1,400 checklists become one icon with a count.
                const spots = new Map();
                const speciesPerGroup = {};
                const speciesSeen = {};
                rows.forEach((d) => {
                    if (!d.lat || !d.lon) return;
                    const g = groupOf(d);
                    (speciesSeen[g.key] = speciesSeen[g.key] || new Set()).add(
                        d.species,
                    );
                    const key = `${d.species}|${d.lat}|${d.lon}`;
                    let s = spots.get(key);
                    if (!s) {
                        s = {
                            species: d.species,
                            group: g,
                            lat: +d.lat,
                            lon: +d.lon,
                            count: 0,
                            minYear: Infinity,
                            maxYear: -Infinity,
                            photo: "",
                            photoBy: "",
                            photoLicense: "",
                        };
                        spots.set(key, s);
                    }
                    s.count += 1;
                    if (d.photo && !s.photo) {
                        s.photo = d.photo;
                        s.photoBy = d.photoBy;
                        s.photoLicense = d.photoLicense;
                    }
                    const y = +d.year;
                    if (y) {
                        s.minYear = Math.min(s.minYear, y);
                        s.maxYear = Math.max(s.maxYear, y);
                    }
                });

                GROUPS.forEach(
                    (g) => (speciesPerGroup[g.key] = (speciesSeen[g.key] || new Set()).size),
                );

                // Legend — a row of pill buttons: click one to show only
                // that group, click it again (or "Show all") to reset.
                // Selection is kept in the URL hash so a filtered view is
                // linkable.
                const legend = document.getElementById("legend");
                const legendSpans = {};
                const PILL =
                    "inline-flex items-center gap-1.5 cursor-pointer select-none rounded-full border px-3 py-1 transition hover:bg-gray-100";
                function makePill(label, title, onclick) {
                    const b = document.createElement("button");
                    b.type = "button";
                    b.className = PILL + " border-gray-300";
                    b.title = title;
                    b.innerHTML = label;
                    b.addEventListener("click", onclick);
                    return b;
                }
                const showAllBtn = makePill(
                    "Show all",
                    "Show every group",
                    () => setFilter(null),
                );
                legend.appendChild(showAllBtn);
                GROUPS.forEach((g) => {
                    if (!speciesPerGroup[g.key]) return;
                    const b = makePill(
                        `${iconImg(g, 18)}${g.key} <span class="text-gray-400">(${speciesPerGroup[g.key]} species)</span>`,
                        `Show only ${g.key.toLowerCase()}`,
                        () => setFilter(activeKey === g.key ? null : g.key),
                    );
                    legendSpans[g.key] = b;
                    legend.appendChild(b);
                });

                // Neighborhood boundary
                const boundaryLayer = L.geoJSON(boundary, {
                    style: {
                        color: "#9ca3af",
                        weight: 2,
                        dashArray: "6 6",
                        fill: false,
                    },
                }).addTo(map);
                // Start zoomed so the boundary's left and right edges sit
                // just inside the window edges; the neighborhood's top and
                // bottom may run past the frame.
                const b = boundaryLayer.getBounds();
                map.setView(
                    b.getCenter(),
                    map.getBoundsZoom(b, true) - 0.05,
                );

                // Markers: icons only, no clustering. Species stacked at the
                // exact same coordinate (eBird hotspots) get a generous
                // random-looking jitter so every icon stays visible. The
                // offsets are hashed from the species name, so the scatter
                // is stable across reloads.
                const byCoord = new Map();
                spots.forEach((s) => {
                    const k = `${s.lat}|${s.lon}`;
                    (byCoord.get(k) || byCoord.set(k, []).get(k)).push(s);
                });
                const cosLat = Math.cos((45.02 * Math.PI) / 180);
                function hash01(str) {
                    let h = 2166136261;
                    for (let i = 0; i < str.length; i++) {
                        h ^= str.charCodeAt(i);
                        h = Math.imul(h, 16777619);
                    }
                    return ((h >>> 0) % 100000) / 100000;
                }
                byCoord.forEach((group) => {
                    if (group.length === 1) return;
                    // ~33 m base radius, growing with the size of the stack
                    const R = 0.0003 + 0.00007 * Math.sqrt(group.length);
                    group.forEach((s) => {
                        const r = R * Math.sqrt(hash01(s.species + "|r"));
                        const a = hash01(s.species + "|a") * 2 * Math.PI;
                        s.lat += r * Math.cos(a);
                        s.lon += (r * Math.sin(a)) / cosLat;
                    });
                });

                // Crowded spots collapse into a light gray circle counting
                // the species inside; clicking or zooming opens them up.
                const clusters = L.markerClusterGroup({
                    maxClusterRadius: 44,
                    showCoverageOnHover: false,
                    // Click behavior is custom: drawn creatures open their
                    // tooltip, only count bubbles zoom/expand
                    zoomToBoundsOnClick: false,
                    // No spider legs when a small cluster fans open, and a
                    // wider, taller fan so the icons breathe
                    spiderLegPolylineOptions: { weight: 0, opacity: 0 },
                    spiderfyDistanceMultiplier: 2.2,
                    iconCreateFunction: (cluster) => {
                        const kids = cluster.getAllChildMarkers();
                        // A stack of just 2 lifeforms draws the creatures
                        // themselves, side by side, instead of a bubble
                        if (kids.length <= 2) {
                            let w = 0;
                            let h = 0;
                            const html = kids
                                .map((k) => {
                                    const s = k.options.icon.options.iconSize;
                                    w += s[0] + 2;
                                    h = Math.max(h, s[1]);
                                    return k.options.icon.options.html;
                                })
                                .join("");
                            return L.divIcon({
                                html: `<div style="display:flex;align-items:flex-end;gap:2px">${html}</div>`,
                                className: "species-icon",
                                iconSize: [w, h],
                                iconAnchor: [w / 2, h / 2],
                            });
                        }
                        const species = new Set();
                        kids.forEach((m) => species.add(m.options.species));
                        const n = species.size;
                        const d = n < 10 ? 30 : n < 50 ? 38 : 46;
                        return L.divIcon({
                            html: `<div class="cluster-badge" style="width:${d}px;height:${d}px;line-height:${d - 2}px">${n}</div>`,
                            className: "",
                            iconSize: [d, d],
                        });
                    },
                }).addTo(map);
                const markersByGroup = {};
                GROUPS.forEach((g) => (markersByGroup[g.key] = []));

                function licenseShort(url) {
                    const m = (url || "").match(
                        /licenses\/([a-z-]+)\/([0-9.]+)/i,
                    );
                    return m ? `CC ${m[1].toUpperCase()} ${m[2]}` : "";
                }

                // Popup anchored in page space rather than inside Leaflet's
                // clipped container, so a tall photo can extend past the
                // map's edge instead of being cut off.
                const mapEl = document.getElementById("map");
                const mapWrap = mapEl.parentElement;
                mapWrap.style.position = "relative";
                const pop = document.createElement("div");
                pop.id = "species-popup";
                pop.style.display = "none";
                mapWrap.appendChild(pop);
                let popLatLng = null;
                function positionPopup() {
                    if (!popLatLng) return;
                    const pt = map.latLngToContainerPoint(popLatLng);
                    // Clamp horizontally so the card never leaves the
                    // browser window, and flip below the marker when there
                    // is no room above it in the viewport.
                    const half = pop.offsetWidth / 2 || 125;
                    const x = Math.max(
                        half + 8,
                        Math.min(
                            window.innerWidth - half - 8,
                            mapEl.offsetLeft + pt.x,
                        ),
                    );
                    const spaceAbove =
                        mapEl.getBoundingClientRect().top + pt.y;
                    const below = spaceAbove - pop.offsetHeight - 22 < 8;
                    pop.style.transform = below
                        ? "translate(-50%, 0)"
                        : "translate(-50%, -100%)";
                    pop.style.left = x + "px";
                    pop.style.top =
                        mapEl.offsetTop + pt.y + (below ? 14 : -14) + "px";
                }
                function hidePopup() {
                    popLatLng = null;
                    pop.style.display = "none";
                }
                function showPopup(latlng, html) {
                    pop.innerHTML =
                        `<button id="species-popup-close" aria-label="Close">×</button>` +
                        html;
                    pop.querySelector("#species-popup-close").addEventListener(
                        "click",
                        hidePopup,
                    );
                    popLatLng = latlng;
                    pop.style.display = "block";
                    positionPopup();
                    // A photo loading changes the card's height — re-anchor
                    pop.querySelectorAll("img").forEach((img) =>
                        img.addEventListener("load", positionPopup),
                    );
                }
                map.on("move zoomend", positionPopup);
                map.on("click", hidePopup);

                // Pairs drawn as creatures reveal a combined tooltip on
                // click; count bubbles zoom in (or fan out once zooming
                // can't separate them further)
                clusters.on("clusterclick", (e) => {
                    const kids = e.layer.getAllChildMarkers();
                    if (kids.length <= 2) {
                        const ll = e.layer.getLatLng();
                        showPopup(
                            [ll.lat, ll.lng],
                            kids
                                .map((k) => k.options.popupHtml)
                                .join(
                                    '<hr style="margin:8px 0;border:none;border-top:1px solid #e5e7eb">',
                                ),
                        );
                    } else if (
                        map.getBoundsZoom(e.layer.getBounds()) <=
                        map.getZoom()
                    ) {
                        e.layer.spiderfy();
                    } else {
                        e.layer.zoomToBounds({ padding: [20, 20] });
                    }
                });

                spots.forEach((s) => {
                    // Half the birds face the other way (stable per spot),
                    // so flocks don't all march in one direction
                    const flip =
                        s.group.key === "Birds" &&
                        hash01(`${s.species}|${s.lat}|flip`) < 0.5;
                    const m = L.marker([s.lat, s.lon], {
                        icon: tintedIcon(
                            iconDefFor(s.group.key, s.species),
                            colorFor(s),
                            flip,
                        ),
                        species: s.species,
                    });
                    const common = commonOf[s.species];
                    let html = "";
                    if (s.photo) {
                        const src = s.photo.replace(
                            "/original.",
                            "/medium.",
                        );
                        html += `<img src="${src}" alt="${common || s.species}" loading="lazy" style="width:220px;height:auto;max-height:300px;object-fit:contain;border-radius:6px;margin-bottom:6px;display:block">`;
                    }
                    if (common) html += `<strong>${common}</strong><br>`;
                    html += `<em>${s.species}</em>`;
                    html += `<br><span style="color:#666">${s.group.key}</span>`;
                    html += `<br>${s.count.toLocaleString()} observation${s.count === 1 ? "" : "s"} here`;
                    if (s.minYear !== Infinity)
                        html += ` · ${yearsLabel(s.minYear, s.maxYear)}`;
                    const total = speciesTotal[s.species] || 0;
                    if (total > s.count)
                        html += `<br>${total.toLocaleString()} record${total === 1 ? "" : "s"} of this species in the neighborhood`;
                    if (s.photo && (s.photoBy || s.photoLicense)) {
                        const lic = licenseShort(s.photoLicense)
                            ? `, <a href="${s.photoLicense}" target="_blank" rel="noopener noreferrer" style="color:#999;text-decoration:underline">${licenseShort(s.photoLicense)}</a>`
                            : "";
                        html += `<br><span style="color:#999;font-size:11px">Photo: ${s.photoBy || "unknown"}${lic}, via iNaturalist/GBIF</span>`;
                    }
                    m.options.popupHtml = html;
                    m.on("click", () => showPopup([s.lat, s.lon], html));
                    markersByGroup[s.group.key].push(m);
                });

                // Per-group totals for the stat line when filtered
                const obsPerGroup = {};
                const spotsPerGroup = {};
                rows.forEach((d) => {
                    const k = groupOf(d).key;
                    obsPerGroup[k] = (obsPerGroup[k] || 0) + 1;
                });
                spots.forEach((s) => {
                    const k = s.group.key;
                    spotsPerGroup[k] = (spotsPerGroup[k] || 0) + 1;
                });

                const totalObs = rows.length;
                const totalSpecies = new Set(rows.map((d) => d.species)).size;
                const statLine = document.getElementById("stat-line");
                let activeKey = null;

                function setFilter(key) {
                    activeKey = key;
                    showAllBtn.className =
                        PILL +
                        (key
                            ? " border-gray-300"
                            : " border-gray-800 bg-gray-100 font-medium");
                    const visible = [];
                    GROUPS.forEach((g) => {
                        const on = !key || g.key === key;
                        if (on) visible.push(...markersByGroup[g.key]);
                        const span = legendSpans[g.key];
                        if (!span) return;
                        span.style.opacity = on ? "" : "0.4";
                        span.className =
                            PILL +
                            (key === g.key
                                ? " border-gray-800 bg-gray-100 font-medium"
                                : " border-gray-300");
                        span.title =
                            key === g.key
                                ? "Show all groups"
                                : `Show only ${g.key.toLowerCase()}`;
                    });
                    clusters.clearLayers();
                    clusters.addLayers(visible);
                    statLine.textContent = key
                        ? `${key}: ${speciesPerGroup[key]} species · ${(obsPerGroup[key] || 0).toLocaleString()} observations · ${(spotsPerGroup[key] || 0).toLocaleString()} mapped locations`
                        : `${totalSpecies} species · ${totalObs.toLocaleString()} observations · ${spots.size.toLocaleString()} mapped locations`;
                    history.replaceState(
                        null,
                        "",
                        key ? `#${key.toLowerCase()}` : location.pathname,
                    );
                }

                const fromHash = GROUPS.find(
                    (g) =>
                        g.key.toLowerCase() ===
                        decodeURIComponent(location.hash.slice(1)).toLowerCase(),
                );
                setFilter(fromHash ? fromHash.key : null);
            });
        })();
    </script>
</BaseLayout>
