<BaseLayout
    title="Fiction - Claire Nyquist"
    description="Short science fiction by Claire Nyquist: The Sky Burial and Starkite."
    type="article"
    schemaType="Article"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Hero -->
        <div class="text-center mb-10">
            <h1 class="text-4xl md:text-6xl name-gradient mb-6">Fiction</h1>
            <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
                <a href="#the-sky-burial" class="text-blue-600 hover:text-blue-800 transition-colors">The Sky Burial</a>
                <a href="#starkite" class="text-blue-600 hover:text-blue-800 transition-colors">Starkite</a>
            </nav>
