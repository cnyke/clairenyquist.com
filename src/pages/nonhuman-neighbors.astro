            const iconDefByGenus = {};
            const defByIconName = {};
            GROUPS.forEach((g) => (defByIconName[g.icon] = g));
            Object.entries(SUBICONS).forEach(([groupKey, list]) => {
                iconDefByGenus[groupKey] = {};
                list.forEach(([icon, size, genera]) => {
                    const def = { icon, size };
                    defByIconName[icon] = def;
                    genera.split(" ").forEach(
                        (genus) => (iconDefByGenus[groupKey][genus] = def),
                    );
                });
            });
            function iconDefFor(groupKey, species) {
                const genus = (species || "").split(" ")[0];
                return (
                    iconDefByGenus[groupKey][genus] ||
                    GROUPS.find((g) => g.key === groupKey)
                );
            }

            // Estimated dominant color per genus — the color you'd name if
            // asked "what color is a cardinal?" — with species overrides
            // where one genus spans very different looks. Anything unlisted
            // falls back to its lifeform's color. Very-pale species are
            // nudged toward a readable gray so they survive a white map.
            const SPECIES_COLOR = {
                "Spinus pinus": "#9b8455", // pine siskin: streaky brown, not goldfinch gold
            };
            const GENUS_COLOR = {
                // Birds
                Poecile: "#8a9099", Cardinalis: "#d21f26", Passer: "#8a6f4b",
                Corvus: "#4d545c", Haemorhous: "#c8506b", Spinus: "#e6b90c",
