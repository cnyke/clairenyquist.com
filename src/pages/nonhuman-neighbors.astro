            // One icon shape per lifeform (Claude-cropped line art, stored
            // as black-on-transparent masks); color marks the lifeform
            // group — Claire's palette, deep enough to read on the pale
            // basemap. Marker sizes preserve each drawing's aspect ratio.
            const GROUPS = [
                { key: "Birds", color: "#e13c30", icon: "birds", size: [22, 20], match: (d) => d.class === "Aves" },
                { key: "Insects", color: "#f2601a", icon: "insects", size: [22, 20], match: (d) => d.class === "Insecta" },
                { key: "Plants", color: "#2fae57", icon: "plants", size: [16, 20], match: (d) => d.kingdom === "Plantae" },
                { key: "Arachnids", color: "#d64fc4", icon: "arachnids", size: [20, 20], match: (d) => d.class === "Arachnida" },
                { key: "Mammals", color: "#c9a70a", icon: "mammals", size: [35, 16], match: (d) => d.class === "Mammalia" },
                { key: "Fungi", color: "#3186e0", icon: "fungi", size: [18, 20], match: (d) => d.kingdom === "Fungi" },
                { key: "Other", color: "#6d28d9", icon: "other", size: [26, 16], match: () => true },
