                Leonurus: "#b08ab0", Agastache: "#8a7fd8", Blephilia: "#a58ac0",
                Ajuga: "#6a5fd0", Tradescantia: "#6a5fc9", Phlox: "#b06fc0",
                Dianthus: "#cf4f7a", Saponaria: "#cf9ab0", Persicaria: "#c97a9a",
                Chelone: "#cf9ab8", Geum: "#b56a6a", Crocus: "#9a6fd0",
                Hackelia: "#8a92c9", Borago: "#4f7fd8", Eryngium: "#7a8fc0",
                Hydrophyllum: "#8a92c9", Verbascum: "#d9c520", Oxalis: "#dcc520",
                Ranunculus: "#e0c318", Lotus: "#d9b520", Lamium: "#cfc030",
                Linaria: "#dcc030", Lysimachia: "#dcb818", Zizia: "#dcbf1c",
                Tanacetum: "#dcc020", Lithospermum: "#dcaf1c", Chamaecrista: "#dcb51c",
                Impatiens: "#e08a2f", Hemerocallis: "#e0812f", Campsis: "#d05f2a",
                Trifolium: "#a2597b", Melilotus: "#d9cf9a", Coronilla: "#c987a5",
                Sambucus: "#4f3f5f", Lonicera: "#b5584a", Artemisia: "#9aa383",
                Mirabilis: "#c05f9a", Portulaca: "#d9a02f",
                // Mammals
                Sciurus: "#8a8d92", Tamias: "#a5623a", Sylvilagus: "#96826d",
                Procyon: "#6f6f74", Blarina: "#4f5257", Vulpes: "#c2542a",
                // Fungi & lichen
                Trametes: "#a58a5f", Laetiporus: "#e0912a", Oxneria: "#d9a025",
                Xylaria: "#3a3734", Puccinia: "#c9701c", Agaricaceae: "#b5a487",
                // Arachnids
                Argiope: "#c8a51c", Neoscona: "#8a6a45", Agelenopsis: "#8a7050",
                Phidippus: "#4a3f3d", Salticus: "#5a5a58", Attulus: "#6a6258",
                Eris: "#5f4f42", Dermacentor: "#6b4032", Amblyomma: "#7a4f35",
                Phalangium: "#8a7a5f", Theridion: "#8a7562", Misumessus: "#7ec253",
                // Other
                Chrysemys: "#4f6b4a", Porcellio: "#6a6f76", Porcellionides: "#6a6f76",
                Armadillidium: "#5f646b", Oxidus: "#6b5b45", Fuligo: "#e3c318",
                Ladislavella: "#8a7355",
            };
            function colorFor(s) {
                return (
                    SPECIES_COLOR[s.species] ||
                    GENUS_COLOR[(s.species || "").split(" ")[0]] ||
                    s.group.color
                );
            }


            document.getElementById("icon-citations").innerHTML =
                `<strong class="text-gray-500">Icons:</strong> line-art icon set generated with Google Gemini for this page, then cropped, recolored, and matched to species for the map.`;

            // Minimalist white & gray basemap
            // zoomSnap 0 allows an exact fractional starting zoom, so the
            // boundary's edges can sit right at the frame instead of
            // snapping a whole level out. One finger drags the map on
            // touch; the wheel is left to page scrolling on desktop.
            const map = L.map("map", { zoomSnap: 0, scrollWheelZoom: false });
            L.tileLayer(
                "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
                {
                    attribution:
                        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
                    maxZoom: 20,
                },
            ).addTo(map);

            function iconImg(def, h, src, flip) {
                const w = Math.round((def.size[0] / def.size[1]) * h);
                return `<img src="${src || `/images/species-icons/${def.icon}.png`}" alt="" style="width:${w}px;height:${h}px;object-fit:contain${flip ? ";transform:scaleX(-1)" : ""}">`;
            }

            // One knob for overall marker size; sizes in the tables above
            // stay proportional to each drawing.
            const ICON_SCALE = 2.7;
            function makeIcon(def, src, flip) {
                const w = Math.round(def.size[0] * ICON_SCALE);
                const h = Math.round(def.size[1] * ICON_SCALE);
                return L.divIcon({
                    className: "species-icon",
                    html: iconImg(def, h, src, flip),
                    iconSize: [w, h],
                    iconAnchor: [w / 2, h / 2],
                    popupAnchor: [0, -h / 2],
                });
            }

            // The icon files are black line art on transparency; markers get
            // their viridis color painted in at runtime via canvas.
            const baseImgs = {};
            function preloadIcon(name) {
                return new Promise((resolve) => {
                    const img = new Image();
                    img.onload = () => resolve();
                    img.onerror = () => resolve();
                    img.src = `/images/species-icons/${name}.png`;
                    baseImgs[name] = img;
                });
            }

            const srcCache = {};
            function tintedSrc(iconName, color) {
                const key = iconName + "|" + color;
                if (!srcCache[key]) {
                    const img = baseImgs[iconName];
                    const c = document.createElement("canvas");
                    c.width = img.naturalWidth;
                    c.height = img.naturalHeight;
                    const ctx = c.getContext("2d");
                    ctx.drawImage(img, 0, 0);
                    ctx.globalCompositeOperation = "source-in";
                    ctx.fillStyle = color;
                    ctx.fillRect(0, 0, c.width, c.height);
                    srcCache[key] = c.toDataURL();
                }
                return srcCache[key];
            }

            const tintCache = {};
            function tintedIcon(def, color, flip) {
                const key = def.icon + "|" + color + (flip ? "|f" : "");
                if (!tintCache[key])
                    tintCache[key] = makeIcon(
                        def,
                        tintedSrc(def.icon, color),
                        flip,
                    );
                return tintCache[key];
            }

            function yearsLabel(a, b) {
                return a === b ? String(a) : `${a}–${b}`;
            }

            Promise.all([
                fetch("/data/audubon_neighborhood_occurrences.csv").then((r) =>
                    r.text(),
                ),
                fetch("/data/audubon_neighborhood_boundary.geojson").then((r) =>
                    r.json(),
                ),
                Promise.all(Object.keys(defByIconName).map(preloadIcon)),
            ]).then(([csvText, boundary]) => {
                const rows = d3.csvParse(csvText);

                // Total records per species, shown in the popups
                const speciesTotal = {};
                rows.forEach((d) => {
                    if (d.species)
                        speciesTotal[d.species] =
                            (speciesTotal[d.species] || 0) + 1;
                });

                // Any record of a species may carry its common name — share
                // them so every popup can show one where it exists.
                const commonOf = {};
                rows.forEach((d) => {
                    if (d.common && !commonOf[d.species])
                        commonOf[d.species] = d.common;
                });

                // Aggregate: one marker per species per exact spot, so a
                // hotspot's 1,400 checklists become one icon with a count.
                const spots = new Map();
                rows.forEach((d) => {
                    if (!d.lat || !d.lon) return;
                    const g = groupOf(d);
                    const key = `${d.species}|${d.lat}|${d.lon}`;
                    let s = spots.get(key);
                    if (!s) {
                        s = {
                            species: d.species,
                            group: g,
                            lat: +d.lat,
                            lon: +d.lon,
                            count: 0,
                            minYear: Infinity,
                            maxYear: -Infinity,
                            photo: "",
                            photoBy: "",
                            photoLicense: "",
                        };
                        spots.set(key, s);
                    }
                    s.count += 1;
                    if (d.photo && !s.photo) {
                        s.photo = d.photo;
                        s.photoBy = d.photoBy;
                        s.photoLicense = d.photoLicense;
                    }
                    const y = +d.year;
                    if (y) {
                        s.minYear = Math.min(s.minYear, y);
                        s.maxYear = Math.max(s.maxYear, y);
                    }
                });

                // Neighborhood boundary
                const boundaryLayer = L.geoJSON(boundary, {
                    style: {
                        color: "#9ca3af",
                        weight: 2,
                        dashArray: "6 6",
                        fill: false,
                    },
                }).addTo(map);
                // Start zoomed so the boundary spans almost the width of
                // the screen, centered on the neighborhood; phones start
                // a little deeper.
                const b = boundaryLayer.getBounds();
                const boundsPxW =
                    map.project(b.getNorthEast(), 0).x -
                    map.project(b.getNorthWest(), 0).x;
                const size = map.getSize();
                if (size.x < 640) {
                    // Phones: fit the neighborhood top to bottom, with the
                    // eastern arc just inside the right edge (matched to
                    // Claire's reference framing)
                    const boundsPxH =
                        map.project(b.getSouthEast(), 0).y -
                        map.project(b.getNorthEast(), 0).y;
                    const z0 = Math.log2(size.y / boundsPxH) - 0.03;
                    const cx =
                        map.project(b.getNorthEast(), z0).x -
                        (size.x / 2 - 24);
                    const cy = map.project(b.getCenter(), z0).y;
                    map.setView(map.unproject(L.point(cx, cy), z0), z0);
                } else {
                    map.setView(
                        b.getCenter(),
                        Math.log2(size.x / boundsPxW) - 0.05,
                    );
                }

                // Markers: icons only, no clustering. Species stacked at the
                // exact same coordinate (eBird hotspots) get a generous
                // random-looking jitter so every icon stays visible. The
                // offsets are hashed from the species name, so the scatter
                // is stable across reloads.
                const byCoord = new Map();
                spots.forEach((s) => {
                    const k = `${s.lat}|${s.lon}`;
                    (byCoord.get(k) || byCoord.set(k, []).get(k)).push(s);
                });
                const cosLat = Math.cos((45.02 * Math.PI) / 180);
                function hash01(str) {
                    let h = 2166136261;
                    for (let i = 0; i < str.length; i++) {
                        h ^= str.charCodeAt(i);
                        h = Math.imul(h, 16777619);
                    }
                    return ((h >>> 0) % 100000) / 100000;
                }
                byCoord.forEach((group) => {
                    if (group.length === 1) return;
                    // ~45 m base radius, growing with the size of the stack
                    const R = 0.0004 + 0.0001 * Math.sqrt(group.length);
                    group.forEach((s) => {
                        const r = R * Math.sqrt(hash01(s.species + "|r"));
                        const a = hash01(s.species + "|a") * 2 * Math.PI;
                        s.lat += r * Math.cos(a);
                        s.lon += (r * Math.sin(a)) / cosLat;
                    });
                });

                // Base positions after jitter; every redraw starts over
                // from these
                spots.forEach((s) => {
                    s.baseLat = s.lat;
                    s.baseLon = s.lon;
                });
                const allSpots = [...spots.values()];

                // Relaxation: nudge apart any two shown markers closer
                // than ~30 px at the current zoom until the icons stop
                // piling on each other
                function relax(arr, MIN, frozen) {
                    for (let pass = 0; pass < 6; pass++) {
                        const grid = new Map();
                        arr.forEach((s) => {
                            const k =
                                Math.floor((s.lon * cosLat) / MIN) +
                                "|" +
                                Math.floor(s.lat / MIN);
                            (grid.get(k) || grid.set(k, []).get(k)).push(s);
                        });
                        let moved = 0;
                        arr.forEach((s) => {
                            const gx = Math.floor((s.lon * cosLat) / MIN);
                            const gy = Math.floor(s.lat / MIN);
                            for (let dx = -1; dx <= 1; dx++) {
                                for (let dy = -1; dy <= 1; dy++) {
                                    const cell = grid.get(
                                        gx + dx + "|" + (gy + dy),
                                    );
                                    if (!cell) continue;
                                    cell.forEach((t) => {
                                        if (t === s) return;
                                        const ax =
                                            (t.lon - s.lon) * cosLat;
                                        const ay = t.lat - s.lat;
                                        const d = Math.hypot(ax, ay);
                                        if (d >= MIN || d === 0) return;
                                        // Frozen spots repel but never
                                        // move; their neighbor takes the
                                        // whole push
                                        const sF = frozen && frozen.has(s);
                                        const tF = frozen && frozen.has(t);
                                        if (sF && tF) return;
                                        const sMove = sF ? 0 : tF ? 1 : 0.5;
                                        const tMove = tF ? 0 : sF ? 1 : 0.5;
                                        const over = (MIN - d) / d;
                                        s.lat -= ay * over * sMove;
                                        s.lon -= (ax * over * sMove) / cosLat;
                                        t.lat += ay * over * tMove;
                                        t.lon += (ax * over * tMove) / cosLat;
                                        moved++;
                                    });
                                }
                            }
                        });
                        if (!moved) break;
                    }
                }

                // Sampling: only crowded places are sampled. The screen is
                // divided into ~100 px cells and each cell shows at most a
                // couple of markers, picked by a random priority order that
                // changes on every page load (and on Resample). Sparse
                // records always show, exactly where they are; zooming in
                // shrinks the cells' ground coverage until everything in
                // view is shown. Every species gets a high-priority spot
                // before any species gets a second.
                // Slightly denser on phones
                const CELL_PX = window.innerWidth < 640 ? 78 : 100;
                const PER_CELL = 2;
                const FULL_ZOOM = 18;
                let startZoom = null;
                function shuffle(a) {
                    for (let i = a.length - 1; i > 0; i--) {
                        const j = Math.floor(Math.random() * (i + 1));
                        [a[i], a[j]] = [a[j], a[i]];
                    }
                    return a;
                }
                function assignPriorities() {
                    const bySpecies = new Map();
                    allSpots.forEach((s) => {
                        (
                            bySpecies.get(s.species) ||
                            bySpecies.set(s.species, []).get(s.species)
                        ).push(s);
                    });
                    const firsts = [];
                    const rest = [];
                    bySpecies.forEach((list) => {
                        const i = Math.floor(Math.random() * list.length);
                        list.forEach((s, j) =>
                            (j === i ? firsts : rest).push(s),
                        );
                    });
                    shuffle(firsts);
                    shuffle(rest);
                    firsts.concat(rest).forEach((s, i) => (s.pri = i));
                }
                assignPriorities();

                // No clustering: with one clade shown at a time, every
                // creature draws individually. The active clade's markers
                // live in one layer group.
                const activeLayer = L.layerGroup().addTo(map);

                function licenseShort(url) {
                    const m = (url || "").match(
                        /licenses\/([a-z-]+)\/([0-9.]+)/i,
                    );
                    return m ? `CC ${m[1].toUpperCase()} ${m[2]}` : "";
                }

                // Popup anchored in page space rather than inside Leaflet's
                // clipped container, so a tall photo can extend past the
                // map's edge instead of being cut off.
                const mapEl = document.getElementById("map");
                const mapWrap = mapEl.parentElement;
                mapWrap.style.position = "relative";
                const pop = document.createElement("div");
                pop.id = "species-popup";
                pop.style.display = "none";
                mapWrap.appendChild(pop);
                let popLatLng = null;
                let popSpot = null;
                function positionPopup() {
                    if (!popLatLng) return;
                    const pt = map.latLngToContainerPoint(popLatLng);
                    // Clamp horizontally so the card never leaves the
                    // browser window, and flip below the marker when there
                    // is no room above it in the viewport.
                    const half = pop.offsetWidth / 2 || 125;
                    const x = Math.max(
                        half + 8,
                        Math.min(
                            window.innerWidth - half - 8,
                            mapEl.offsetLeft + pt.x,
                        ),
                    );
                    const spaceAbove =
                        mapEl.getBoundingClientRect().top + pt.y;
                    const below = spaceAbove - pop.offsetHeight - 22 < 8;
                    pop.style.transform = below
                        ? "translate(-50%, 0)"
                        : "translate(-50%, -100%)";
                    pop.style.left = x + "px";
                    pop.style.top =
                        mapEl.offsetTop + pt.y + (below ? 14 : -14) + "px";
                }
                function hidePopup() {
                    popLatLng = null;
                    popSpot = null;
                    pop.style.display = "none";
                }
                function showPopup(latlng, html) {
                    pop.innerHTML =
                        `<button id="species-popup-close" aria-label="Close">×</button>` +
                        html;
                    pop.querySelector("#species-popup-close").addEventListener(
                        "click",
                        hidePopup,
                    );
                    popLatLng = latlng;
                    pop.style.display = "block";
                    positionPopup();
                    // A photo loading changes the card's height — re-anchor
                    pop.querySelectorAll("img").forEach((img) =>
                        img.addEventListener("load", positionPopup),
                    );
                }
                map.on("move zoomend", positionPopup);
                map.on("click", hidePopup);

                spots.forEach((s) => {
                    // Half the birds face the other way (stable per spot),
                    // so flocks don't all march in one direction
                    const flip =
                        s.group.key === "Birds" &&
                        hash01(`${s.species}|${s.lat}|flip`) < 0.5;
                    const def = iconDefFor(s.group.key, s.species);
                    const color = colorFor(s);
                    const m = L.marker([s.lat, s.lon], {
                        icon: tintedIcon(def, color, flip),
                        species: s.species,
                        iconDef: def,
                        iconColor: color,
                        iconFlip: flip,
                    });
                    const common = commonOf[s.species];
                    let html = "";
                    if (s.photo) {
                        const src = s.photo.replace(
                            "/original.",
                            "/medium.",
                        );
                        html += `<img src="${src}" alt="${common || s.species}" loading="lazy" style="width:220px;height:auto;max-height:300px;object-fit:contain;border-radius:6px;margin-bottom:6px;display:block">`;
                    }
                    if (common) html += `<strong>${common}</strong><br>`;
                    html += `<em>${s.species}</em>`;
                    html += `<br><span style="color:#666">${s.group.key}</span>`;
                    html += `<br>${s.count.toLocaleString()} observation${s.count === 1 ? "" : "s"} here`;
                    if (s.minYear !== Infinity)
                        html += ` · ${yearsLabel(s.minYear, s.maxYear)}`;
                    const total = speciesTotal[s.species] || 0;
                    if (total > s.count)
                        html += `<br>${total.toLocaleString()} record${total === 1 ? "" : "s"} of this species in the neighborhood`;
                    if (s.photo && (s.photoBy || s.photoLicense)) {
                        const lic = licenseShort(s.photoLicense)
                            ? `, <a href="${s.photoLicense}" target="_blank" rel="noopener noreferrer" style="color:#999;text-decoration:underline">${licenseShort(s.photoLicense)}</a>`
                            : "";
                        html += `<br><span style="color:#999;font-size:11px">Photo: ${s.photoBy || "unknown"}${lic}, via iNaturalist/GBIF</span>`;
                    }
                    m.on("click", () => {
                        showPopup([s.lat, s.lon], html);
                        popSpot = s;
                    });
                    s.marker = m;
                });

                const totalObs = rows.length;
                const totalSpecies = new Set(rows.map((d) => d.species)).size;
                const statLine = document.getElementById("stat-line");

                // Pixels expressed in degrees latitude at a given zoom
                function pxToDegAt(px, z) {
                    const mpp =
                        (156543.03392 * Math.cos((45.02 * Math.PI) / 180)) /
                        Math.pow(2, z);
                    return (px * mpp) / 111320;
                }
                function pxToDeg(px) {
                    return pxToDegAt(px, map.getZoom());
                }

                // Each spot gets a fixed reveal zoom, computed once per
                // deal: whoever is visible at one zoom stays visible at
                // every deeper zoom, and zooming in only adds neighbors.
                // Levels nest, so nothing swaps or reshuffles as you move
                // in and out.
                function assignLevels() {
                    const visible = new Set();
                    const byPri = [...allSpots].sort(
                        (a, b) => a.pri - b.pri,
                    );
                    for (let z = startZoom; z < FULL_ZOOM; z++) {
                        // Cells grow a little with each zoom step past the
                        // start, so the reveal stays gradual
                        const cellPx =
                            CELL_PX * Math.pow(1.4, z - startZoom);
                        const degCell = pxToDegAt(cellPx, z);
                        const cellOf = (s) =>
                            Math.floor((s.baseLon * cosLat) / degCell) +
                            "|" +
                            Math.floor(s.baseLat / degCell);
                        const counts = new Map();
                        visible.forEach((s) => {
                            const k = cellOf(s);
                            counts.set(k, (counts.get(k) || 0) + 1);
                        });
                        byPri.forEach((s) => {
                            if (visible.has(s)) return;
                            const k = cellOf(s);
                            const n = counts.get(k) || 0;
                            if (n < PER_CELL) {
                                counts.set(k, n + 1);
                                visible.add(s);
                                s.minZ = z;
                            }
                        });
                    }
                    allSpots.forEach((s) => {
                        if (!visible.has(s)) s.minZ = FULL_ZOOM;
                    });

                    // Positions settle once per deal, level by level:
                    // earlier arrivals are frozen so later ones slot in
                    // around them, and nothing moves again while zooming.
                    // Markers then ride the map's own smooth animation.
                    const levels = [];
                    for (let z = startZoom; z < FULL_ZOOM; z++)
                        levels.push(z);
                    levels.push(FULL_ZOOM);
                    const frozen = new Set();
                    levels.forEach((z) => {
                        const levelSpots = allSpots.filter(
                            (s) => s.minZ <= z,
                        );
                        levelSpots.forEach((s) => {
                            if (!frozen.has(s)) {
                                s.lat = s.baseLat;
                                s.lon = s.baseLon;
                            }
                        });
                        relax(
                            levelSpots,
                            Math.min(pxToDegAt(30, z), 0.0011),
                            frozen,
                        );
                        levelSpots.forEach((s) => frozen.add(s));
                    });
                    allSpots.forEach((s) =>
                        s.marker.setLatLng([s.lat, s.lon]),
                    );
                }

                function render() {
                    const z = map.getZoom();
                    if (startZoom === null) {
                        startZoom = z;
                        assignLevels();
                    }
                    const bounds = map.getBounds().pad(0.05);
                    const inView = allSpots.filter((s) =>
                        bounds.contains([s.baseLat, s.baseLon]),
                    );
                    // Past FULL_ZOOM the sampling switches off and the
                    // full density is displayed. Zooming back out keeps
                    // the base deal.
                    const shown =
                        z >= FULL_ZOOM
                            ? inView
                            : inView.filter(
                                  (s) =>
                                      s.minZ <=
                                      Math.max(z, startZoom) + 1e-9,
                              );
                    const shownSet = new Set(shown);
                    if (popSpot && !shownSet.has(popSpot)) hidePopup();
                    activeLayer.clearLayers();
                    shown.forEach((s) => activeLayer.addLayer(s.marker));
                    statLine.textContent =
                        `${totalSpecies} species · ${totalObs.toLocaleString()} observations · ` +
                        (inView.length > shown.length
                            ? `showing ${shown.length.toLocaleString()} of ${inView.length.toLocaleString()} recorded spots in view, sampled where crowded; zoom in or resample to see more`
                            : `showing all ${inView.length.toLocaleString()} recorded spots in view`);
                }
                map.on("moveend", render);

                // Resample control: deal a different random hand
                const ResampleControl = L.Control.extend({
                    options: { position: "topright" },
                    onAdd: () => {
                        const btn = L.DomUtil.create(
                            "button",
                            "resample-btn",
                        );
                        btn.type = "button";
                        btn.innerHTML = "&#8635; Resample";
                        btn.title =
                            "Show a different random sample of the neighbors";
                        L.DomEvent.disableClickPropagation(btn);
                        btn.addEventListener("click", () => {
                            assignPriorities();
                            assignLevels();
                            render();
                        });
                        return btn;
                    },
                });
                map.addControl(new ResampleControl());

                render();
            });
        })();
    </script>
</BaseLayout>
