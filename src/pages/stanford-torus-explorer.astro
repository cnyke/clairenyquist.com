        left: 20px;
        z-index: 10;
        background: rgba(30, 28, 25, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: rgba(255, 255, 255, 0.95);
        font-family: "Helvetica Neue", Inter, Helvetica, Arial, sans-serif;
