---
import BaseLayout from "../layouts/BaseLayout.astro";

const events = [
    { date: "Saturday, January 9th", title: "Sci Art Zine Morning", summary: "Everyone makes a science zine; we bind them all into one club zine." },
    { date: "Saturday, February 6th", title: "Science Fair", summary: "A grown-up science fair: bring a project, set up a table, and tour each other's work." },
    { date: "Saturday, March 6th", title: "Drawing at the Bell Museum", summary: "Sketch the dioramas and specimens at the Bell Museum together." },
    { date: "Saturday, April 3rd", title: "Science Tattoos", summary: "Design the science tattoo you'd get (no needles involved)." },
    { date: "Saturday, May 1st", title: "Trash Pickup and Watercolor", summary: "Pick up trash together, then paint the place we just cleaned." },
    { date: "Saturday, June 5th", title: "Microscope Party", summary: "Kayak Bde Maka Ska, fill vials with lake water, then see what's living in it under the microscope." },
    { date: "Saturday, July 10th", title: "Field Trip to the Science Museum", summary: "A summer field trip to the Science Museum of Minnesota, sketchbooks in hand." },
    { date: "Saturday, August 7th", title: "BYOS: Bring Your Own Sciartist", summary: "Bring a scientist-artist you love and give a short show-and-tell about their work." },
    { date: "Saturday, September 11th", title: "Collaging the Future", summary: "Scissors, glue, and old science magazines: cut out the future you want to live in." },
];
---

<BaseLayout
    title="Sci Art Club | Claire Nyquist"
    description="Sci Art Club: a community for people who make art about science, and science that looks like art."
>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header -->
        <div class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl name-gradient mb-6">
                <span class="font-majormono font-normal">sci ARt club</span>
            </h1>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed mb-4">
                <span class="font-majormono">sci ARt club</span> is a community for
                people who make art about science, and science that looks like art.
                Whether you draw specimens, print from microscope slides, sew
                orbital mechanics, or just love a good anatomical plate, you've
                found your people.
            </p>
        </div>

        <!-- Events -->
        <div class="max-w-4xl mx-auto mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-6">2027 Events</h2>
            <p class="text-lg text-gray-600 leading-relaxed mb-6">
                One a month, Saturday mornings from 10 AM to 12 PM.
            </p>
            <ul class="divide-y divide-gray-100">
                {events.map((e) => (
                    <li class="py-4">
                        <p class="text-sm text-gray-500">{e.date}</p>
                        <p class="text-xl text-gray-900">{e.title}</p>
                        <p class="text-gray-600">{e.summary}</p>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</BaseLayout>
