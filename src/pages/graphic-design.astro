---
import BaseLayout from "../layouts/BaseLayout.astro";

// Same card system as the home page: each project's title is overlaid
// on its image, fitted to fill the rectangle, with a one-line
// description below. Optional per-card title overrides:
//   titleColor    — solid color for the title (sampled from the image);
//                   without it the title is white + difference-blended.
//   titleKeepBlend — keep difference blending even with a titleColor set.
//   titleLines    — explicit line breaks for the fitted title.
//   titleBlend    — explicit mix-blend-mode override (e.g. "multiply").
//   titlePos      — "third" (centered a third down), "bottom", or a
//                   number 0-1: center the title at that fraction of
//                   the image height.
const works = [
    {
        href: "/brick-designer",
        img: "/images/venus2.png",
        w: 1024,
        h: 1024,
        alt: "Pixel-style mosaic of Venus flytrap traps rendered in yellow, green, red, and dark brown squares.",
        title: "Brick Designer",
        titleColor: "#ffffff",
        blurb: "An interactive tool that transforms your images into 32x32 brick mosaic patterns using a classic color palette.",
    },
    {
        href: "/mars-society-poster",
        img: "/images/MarsSocietyPoster3.16.25.webp",
        w: 1553,
        h: 2400,
        alt: "Mars Society convention poster with rusty red Martian terrain, three circular insets of rovers, habitats, and a domed city.",
        title: "Mars Society Poster",
        // The muted turquoise of the poster's own text.
        titleColor: "#78a8a8",
        blurb: "This poster was submitted to the Mars Society's poster competition.",
    },
    {
        href: "/public-health-review-cover",
        img: "/images/phr4.png",
        w: 1027,
        h: 1280,
        alt: "Four marker drawings of striped figures in face masks, including a pink-haired person, an orange cat, and a purple headscarf.",
        title: "Public Health Review",
        // The top-left figure's spiky magenta hair.
        titleColor: "#ce3e91",
        blurb: "This cover won a competition for the student-led public health journal, the Public Health Review.",
    },
    {
        href: "/skull-and-flies-painting",
        img: "/images/skullandflies.jpg",
        w: 2423,
        h: 3455,
        alt: "Painting on wood of a human skull in profile flanked by two black flies with stained-glass patterned wings.",
        title: "Skull and Flies",
        titleColor: "#000000",
        titleLines: ["Skull", "and", "Flies"],
        blurb: "A human skull surrounded by larger than life flies aims to explore the recycling of nutrients and energy in an ecosystem.",
    },
    {
        href: "/whale-painting",
        img: "/images/whale.jpg",
        w: 1599,
        h: 3815,
        alt: "Tall geometric whale painted on wood grain, its body a dense patchwork of multicolored stripes, squares, and dots.",
        title: "Whale",
        titleColor: "#ffffff",
        // Sit the title about a third of the way down the painting.
        titlePos: "third",
        blurb: "The whale is inspired by the small colored pencil drawings of Frank Lloyd Wright.",
    },
    {
        href: "/adaptator-evolution-game",
        img: "/images/adaptatorcreatures.png",
        w: 1242,
        h: 896,
        alt: "Two whimsical cartoon creatures, a blue round bird with talons and a green one with an elephant trunk and insect legs.",
        title: "Adaptator",
        // The blue of the round creature's body.
        titleColor: "#00aae9",
        titlePos: "bottom",
        blurb: "This game concept explores evolution by introducing random chance into the creation of animal body plans.",
    },
    {
        href: "/gene-editing-perspectives",
        img: "/images/gene-editing-parts.webp",
        w: 600,
        h: 960,
        alt: "Animated x-ray style illustration of a curled infant on black, its brain, skeleton, muscles, organs, and vessels glowing white and fading in turn.",
        title: "Genes",
        titlePos: "bottom",
        blurb: "A gallery installation explores what people think about gene editing technologies.",
    },
    {
        href: "/rainbow-bricks",
        img: "/images/lego.jpeg",
        w: 2706,
        h: 2706,
        alt: "Rainbow LEGO mosaic packed with round studs, flowers, hearts, and translucent pieces shifting from red through blue to purple.",
        title: "Rainbow Bricks",
        blurb: "Each toy brick is like a brush stroke in this color composition.",
    },
    {
        href: "/ppe-instructions",
        img: "/images/ppemask.png",
        w: 958,
        h: 788,
        alt: "Simple line drawing of a white N95 respirator mask with yellow straps and a gray nose band.",
        title: "Personal Protective Equipment Instructions",
        // Bright strap yellow.
        titleColor: "#ffd21e",
        blurb: "How do you correctly put on personal protective equipment in a hospital?",
    },
];
---

<BaseLayout
    title="Graphic Design Portfolio - Claire Nyquist"
    description="Science communication and graphic design portfolio by Claire Nyquist. Explore visual storytelling through scientific illustration, public health graphics, and creative design projects combining art and science."
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Hero Section -->
        <div class="text-center mb-12">
            <h1 class="text-4xl md:text-6xl name-gradient mb-6">
                Graphic Design
            </h1>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
                I bridge the gap between information design and storytelling.
                From public health to the natural world, I transform complex
                data into visual experiences that tell a clear, human story.
            </p>
        </div>

        <!-- Gallery Section -->
        <div class="mb-16">
            <div class="masonry-container">
                {
                    works.map((w) => (
                        <a
                            href={w.href}
                            class="masonry-item bg-white rounded-lg overflow-hidden mb-6 block"
                        >
                            <div class="relative">
                                <img
                                    src={w.img}
                                    alt={w.alt}
                                    width={w.w}
                                    height={w.h}
                                    loading="lazy"
                                    decoding="async"
                                    class="w-full h-auto object-contain"
                                />
                                <span
                                    class={`card-title font-space-grotesk${w.titlePos === "third" || typeof w.titlePos === "number" ? " card-title-third" : ""}${w.titlePos === "bottom" ? " card-title-bottom" : ""}`}
                                    data-title-pos={
                                        typeof w.titlePos === "number"
                                            ? w.titlePos
                                            : undefined
                                    }
                                    style={`color: ${w.titleColor ?? "#fff"}; mix-blend-mode: ${w.titleBlend ?? (!w.titleColor || w.titleKeepBlend ? "difference" : "normal")};`}
                                >
                                    {w.titleLines ? (
                                        <span
                                            class="card-title-inner font-space-grotesk"
                                            style="white-space: nowrap"
                                            set:html={w.titleLines.join(
                                                "<br>",
                                            )}
                                        />
                                    ) : (
                                        <span class="card-title-inner font-space-grotesk">
                                            {w.title}
                                        </span>
                                    )}
                                </span>
                            </div>
                            <p class="card-blurb">{w.blurb}</p>
                        </a>
                    ))
                }
            </div>
            <script is:inline>
                // Shuffle the cards on every load, same as the home page.
                // Runs synchronously right after the grid parses, so the
                // order is set before first paint.
                (function () {
                    var c = document.querySelector(".masonry-container");
                    if (!c) return;
                    var items = Array.prototype.slice.call(c.children);
                    for (var i = items.length - 1; i > 0; i--) {
                        var j = Math.floor(Math.random() * (i + 1));
                        var t = items[i];
                        items[i] = items[j];
                        items[j] = t;
                    }
                    items.forEach(function (el) {
                        c.appendChild(el);
                    });
                })();
            </script>
        </div>
    </div>

    <style>
        /* Masonry layout using CSS columns */
        .masonry-container {
            /* Use column-width for more natural responsiveness in Chrome */
            column-width: 320px;
            column-gap: 2rem;
            width: 100%;
            max-width: 100%;
        }

        /* Ensure no more than 3 columns on large screens */
        @media (min-width: 1200px) {
            .masonry-container {
                column-count: 3;
            }
        }

        /* Masonry items */
        .masonry-item {
            display: block;
            /* break-inside is the key for columns */
            break-inside: avoid;
            -webkit-column-break-inside: avoid;
            page-break-inside: avoid;

            width: 100%;
            margin-bottom: 0.1rem;
            background: white;
            border-radius: 0.5rem;
            overflow: hidden;

            /* Simplify stacking to avoid Chrome rendering bugs in columns */
            position: relative;
        }

        /* Natural image sizing - no cropping for masonry */
        .masonry-item img {
            display: block;
            width: 100%;
            height: auto;
            object-fit: contain;
            transition: transform 0.3s ease;
            will-change: transform;
        }

        /* Image zoom effect on hover */
        .masonry-item:hover img {
            transform: scale(1.03);
        }

        /* Ensure image container doesn't show overflow */
        .masonry-item .relative {
            overflow: hidden;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        /* Project title overlaid on the image, fitted by script to the
           largest size that still fits the rectangle. */
        .card-title {
            position: absolute;
            inset: 0;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #fff;
            font-weight: 700;
            mix-blend-mode: difference;
            line-height: 1.05;
            pointer-events: none;
            overflow: hidden;
        }
        .card-title-inner {
            display: inline-block;
        }

        /* Variant: title centered about a third of the way down the
           image instead of the middle; the fit script computes the
           exact padding after sizing the text. */
        .card-title-third {
            align-items: flex-start;
        }

        /* Variant: title sits at the bottom edge of the image. */
        .card-title-bottom {
            align-items: flex-end;
        }

        /* One-sentence project description under each image. */
        .card-blurb {
            padding: 0.6rem 0.75rem 0.75rem;
            font-size: 0.875rem;
            line-height: 1.45;
            color: #6b7280;
        }

        /* Prevent column breaks within cards */
        .masonry-item * {
            break-inside: avoid;
        }
    </style>

    <script>
        // Same title fitting as the home page: binary-search the largest
        // font-size at which the text still fits both dimensions of the
        // image rectangle. Re-run when fonts arrive and on resize.
        const fitTitle = (outer) => {
            const inner = outer.firstElementChild;
            outer.style.paddingTop = "";
            const bw = outer.clientWidth;
            const bh = outer.clientHeight;
            if (!inner || !bw || !bh) return;
            let lo = 6;
            let hi = 600;
            for (let i = 0; i < 14; i++) {
                const mid = (lo + hi) / 2;
                outer.style.fontSize = mid + "px";
                if (inner.offsetWidth <= bw && inner.offsetHeight <= bh) {
                    lo = mid;
                } else {
                    hi = mid;
                }
            }
            outer.style.fontSize = lo + "px";
            if (outer.classList.contains("card-title-third")) {
                const frac = parseFloat(outer.dataset.titlePos) || 0.18;
                const pad = Math.max(0, bh * frac - inner.offsetHeight / 2);
                outer.style.paddingTop = pad + "px";
            }
        };
        const fitAllTitles = () => {
            document.querySelectorAll(".card-title").forEach(fitTitle);
        };
        fitAllTitles();
        document.fonts.ready.then(fitAllTitles);
        window.addEventListener("load", fitAllTitles);
        let fitTimer;
        window.addEventListener("resize", () => {
            clearTimeout(fitTimer);
            fitTimer = setTimeout(fitAllTitles, 150);
        });
    </script>
</BaseLayout>
