---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="The Planetary Data System | Claire Nyquist"
    description="An interactive map of NASA's Planetary Data System: eight federated nodes, their missions, and the datasets inside them, drawn as nested circles you can open one layer at a time."
>
    <div class="px-4 py-8">
        <!-- Hero -->
        <div class="text-center mb-8">
            <h1 class="text-4xl md:text-6xl name-gradient mb-4">
                The Planetary Data System
            </h1>
            <p
                class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed mb-4"
            >
                Every planetary mission NASA has flown, filed.
            </p>
            <p
                class="text-lg text-gray-600 max-w-4xl mx-auto leading-relaxed"
            >
                The PDS is not one archive. It is a federation of seven
                discipline nodes, each run by a different university or
                institute, plus an Engineering Node at JPL that owns the
                standard and the registry. Click any circle to open it. Each
                click drops one layer: node, then mission or theme, then the
                individual instrument archives. Click the space around a
                circle to come back up.
            </p>
        </div>

        <!-- Controls -->
        <div
            class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-4 mb-4"
        >
            <nav
                id="pds-nodes"
                aria-label="Jump to a node"
                class="flex flex-wrap items-center gap-2 w-full order-first"
            >
            </nav>
            <nav
                id="pds-crumbs"
                aria-label="Archive location"
                class="flex flex-wrap items-center gap-1 text-sm text-gray-600 min-h-[2rem]"
            >
            </nav>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
                <div
                    class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-600"
                >
                    <span class="flex items-center gap-2">
                        <span
                            class="inline-block w-3 h-3 rounded-full"
                            style="background:#2a78d6"></span>
                        PDS4
                    </span>
                    <span class="flex items-center gap-2">
                        <span
                            class="inline-block w-3 h-3 rounded-full"
                            style="background:#eb6834"></span>
                        PDS3 (legacy)
                    </span>
                    <span class="flex items-center gap-2">
                        <span
                            class="inline-block w-3 h-3 rounded-full"
                            style="background:#1baf7a"></span>
                        Tools & standards
                    </span>
                </div>
                <button
                    id="pds-view-toggle"
                    type="button"
                    class="font-space-grotesk text-sm text-blue-600 hover:text-blue-800 border border-blue-200 hover:border-blue-400 rounded px-3 py-1"
                >
                    Show as table
                </button>
            </div>
        </div>

        <!-- Map + detail rail -->
        <div
            id="pds-map-view"
            class="max-w-6xl mx-auto grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px] items-start"
        >
            <div id="pds-viz" class="relative">
                <svg
                    id="pds-svg"
                    viewBox="-460 -460 920 920"
                    role="img"
                    aria-label="Nested circle map of the Planetary Data System, sized by approximate archive volume"
                    style="width:100%;height:auto;display:block;cursor:pointer;touch-action:manipulation;"
                >
                </svg>
                <div
                    id="pds-tip"
                    class="pointer-events-none absolute z-10 hidden max-w-xs rounded-md border border-gray-200 bg-white/95 px-3 py-2 text-sm text-gray-700 shadow-lg"
                >
                </div>
            </div>

            <aside
                id="pds-detail"
                class="border border-gray-200 rounded-lg p-5 bg-white lg:sticky lg:top-6"
            >
            </aside>
        </div>

        <!-- Table view -->
        <div id="pds-table-view" class="max-w-6xl mx-auto hidden">
            <div class="overflow-x-auto border border-gray-200 rounded-lg">
                <table class="min-w-full text-sm text-left">
                    <thead
                        class="font-space-grotesk text-xs uppercase tracking-wide text-gray-500 bg-gray-50"
                    >
                        <tr>
                            <th class="px-3 py-2">Node</th>
                            <th class="px-3 py-2">Group</th>
                            <th class="px-3 py-2">Dataset</th>
                            <th class="px-3 py-2">Target</th>
                            <th class="px-3 py-2">Years</th>
                            <th class="px-3 py-2">Standard</th>
                            <th class="px-3 py-2 text-right">Approx. volume</th>
                        </tr>
                    </thead>
                    <tbody id="pds-table-body" class="text-gray-700"></tbody>
                </table>
            </div>
        </div>

        <!-- Notes -->
        <div
            class="max-w-3xl mx-auto mt-10 text-sm text-gray-500 leading-relaxed space-y-3"
        >
            <p>
                <span class="font-space-grotesk text-gray-700"
                    >How to read the sizes.</span
                > Circle area is an order-of-magnitude estimate of how much
                data an archive holds, rounded to the nearest half decade and
                used here to give the map its shape. It is not a citable
                figure. HiRISE really does dwarf whole nodes, and the
                Navigation and Ancillary Information Facility really is tiny,
                but for exact holdings go to the node's own inventory.
            </p>
            <p>
                <span class="font-space-grotesk text-gray-700"
                    >PDS3 and PDS4.</span
                > Color marks which standard a dataset is filed under. PDS3
                labels are keyword-value text files sitting next to fixed-record
                binaries, used from roughly 1990 to 2013. PDS4 is XML validated
                against a formal information model, with every product carrying
                a versioned logical identifier. Most legacy holdings will never
                be migrated, which is why a single mission can span both.
            </p>
            <p>
                <span class="font-space-grotesk text-gray-700"
                    >Node assignments.</span
                > A mission's instruments are frequently split across nodes:
                Mars Reconnaissance Orbiter alone lands in three. A few
                assignments here are simplified, and derived cartographic
                products often live at USGS Astrogeology rather than in the PDS
                itself. The authority is always the node's own catalog at
                <a
                    href="https://pds.nasa.gov/"
                    target="_blank"
                    rel="noopener"
                    class="text-blue-600 hover:text-blue-800">pds.nasa.gov</a
                >.
            </p>
            <p>
                Built with <a
                    href="https://d3js.org/"
                    target="_blank"
                    rel="noopener"
                    class="text-blue-600 hover:text-blue-800">D3</a
                >. Data compiled from the public node catalogs, September 2026.
            </p>
        </div>
    </div>

    <script is:inline src="https://d3js.org/d3.v7.min.js"></script>
    <script is:inline>
        (function () {
            const STD = {
                pds4: { fill: "#2a78d6", label: "PDS4" },
                pds3: { fill: "#eb6834", label: "PDS3" },
                tool: { fill: "#1baf7a", label: "Tools" },
            };
            // Containers recede; only the leaves carry the standard color.
            const CONTAINER = ["#fbfcfd", "#eef1f6", "#e2e8f1"];
            const HAIRLINE = "#cbd5e1";
            const INK = "#1f2937";
            const W = 920;

            const svg = d3.select("#pds-svg");
            const tip = document.getElementById("pds-tip");
            const crumbs = document.getElementById("pds-crumbs");
            const nodeStrip = document.getElementById("pds-nodes");
            const detail = document.getElementById("pds-detail");
            const reduceMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            function volume(tb) {
                if (tb >= 950) return "~" + (tb / 1000).toFixed(1) + " PB";
                if (tb >= 100) return "~" + Math.round(tb / 10) * 10 + " TB";
                return "~" + tb + " TB";
            }

            d3.json("/data/pds-archive.json").then(function (data) {
                const root = d3
                    .pack()
                    .size([W, W])
                    .padding(4)(
                        d3
                            .hierarchy(data)
                            .sum((d) => d.tb || 0)
                            .sort((a, b) => b.value - a.value),
                    );

                let focus = root;
                let selected = root;
                let view;

                const g = svg.append("g");

                const node = g
                    .append("g")
                    .selectAll("circle")
                    .data(root.descendants())
                    .join("circle")
                    .attr("fill", (d) =>
                        d.children
                            ? CONTAINER[d.depth] || CONTAINER[2]
                            : (STD[d.data.std] || STD.pds4).fill,
                    )
                    .attr("stroke", (d) => (d.children ? HAIRLINE : "#ffffff"))
                    .attr("stroke-width", (d) => (d.children ? 1 : 1.5))
                    .attr("tabindex", (d) => (d.depth > 0 ? 0 : null))
                    .attr("role", (d) => (d.depth > 0 ? "button" : null))
                    .attr("aria-label", (d) =>
                        d.depth > 0
                            ? d.data.name +
                              (d.children ? ", open" : ", " + volume(d.data.tb))
                            : null,
                    )
                    .style("cursor", "pointer")
                    .on("mouseenter", showTip)
                    .on("mousemove", moveTip)
                    .on("mouseleave", hideTip)
                    .on("focus", function (event, d) {
                        select(d);
                    })
                    .on("keydown", function (event, d) {
                        if (event.key === "Enter" || event.key === " ") {
                            event.preventDefault();
                            activate(event, d);
                        }
                    })
                    .on("click", activate);

                const label = g
                    .append("g")
                    .style("pointer-events", "none")
                    .selectAll("text")
                    .data(root.descendants())
                    .join("text")
                    .attr("text-anchor", "middle")
                    .attr("fill", (d) => (d.children ? "#334155" : "#ffffff"))
                    .attr("stroke", (d) => (d.children ? "#ffffff" : "none"))
                    .attr("stroke-linejoin", "round")
                    .style("paint-order", "stroke fill")
                    .attr("class", (d) =>
                        d.depth === 1 ? "font-space-grotesk" : null,
                    )
                    .style("display", "none");

                // Pre-split each name into short lines so a label can sit
                // inside its circle instead of running past the edge.
                label.each(function (d) {
                    d.labelText =
                        d.depth === 1 ? d.data.short : d.data.name;
                    const words = d.labelText.split(/\s+/);
                    // Containers get two lines above their children; leaves
                    // can afford three inside their own fill.
                    const target = d.children ? 2 : words.length > 5 ? 3 : 2;
                    const max = Math.max(
                        7,
                        Math.ceil(d.labelText.length / target),
                    );
                    const lines = [];
                    let line = "";
                    words.forEach(function (w) {
                        if (!line) line = w;
                        else if ((line + " " + w).length <= max)
                            line += " " + w;
                        else {
                            lines.push(line);
                            line = w;
                        }
                    });
                    if (line) lines.push(line);
                    d.lines = lines.slice(0, 4);
                    d.widest = d3.max(d.lines, (l) => l.length);
                    const sel = d3.select(this);
                    d.lines.forEach(function (l, i) {
                        sel
                            .append("tspan")
                            .attr("x", 0)
                            .attr("dy", i === 0 ? "0em" : "1.15em")
                            .text(l);
                    });
                });

                svg.on("click", function (event) {
                    if (event.target === svg.node()) {
                        zoom(event, focus.parent || root);
                    }
                });

                function activate(event, d) {
                    event.stopPropagation();
                    select(d);
                    if (d.children && d !== focus) zoom(event, d);
                    else if (!d.children && d.parent !== focus)
                        zoom(event, d.parent);
                }

                function showTip(event, d) {
                    const std = STD[d.data.std];
                    tip.innerHTML =
                        '<span class="font-space-grotesk block text-gray-900">' +
                        d.data.name +
                        "</span>" +
                        '<span class="block text-gray-500">' +
                        (d.children
                            ? (d.depth === 0
                                  ? "The whole archive"
                                  : d.depth === 1
                                    ? "Node"
                                    : "Group") +
                              " · " +
                              d.leaves().length +
                              " datasets · " +
                              volume(d.value)
                            : (std ? std.label + " · " : "") +
                              d.data.target +
                              " · " +
                              volume(d.data.tb)) +
                        "</span>";
                    tip.classList.remove("hidden");
                    moveTip(event);
                }
                function moveTip(event) {
                    const box = document
                        .getElementById("pds-viz")
                        .getBoundingClientRect();
                    const x = event.clientX - box.left;
                    const y = event.clientY - box.top;
                    tip.style.left =
                        Math.min(x + 14, box.width - tip.offsetWidth - 8) + "px";
                    tip.style.top = Math.max(y - 12, 4) + "px";
                }
                function hideTip() {
                    tip.classList.add("hidden");
                }

                function select(d) {
                    selected = d;
                    renderDetail(d);
                    renderCrumbs();
                }

                function renderCrumbs() {
                    const path = focus.ancestors().reverse();
                    crumbs.innerHTML = "";
                    path.forEach(function (d, i) {
                        if (i)
                            crumbs.insertAdjacentHTML(
                                "beforeend",
                                '<span class="text-gray-300 px-1">/</span>',
                            );
                        const b = document.createElement("button");
                        b.type = "button";
                        b.className =
                            "font-space-grotesk hover:text-blue-800 " +
                            (i === path.length - 1
                                ? "text-gray-900"
                                : "text-blue-600");
                        b.textContent = d.data.short || d.data.name;
                        b.addEventListener("click", function (e) {
                            select(d);
                            zoom(e, d);
                        });
                        crumbs.appendChild(b);
                    });
                }

                function renderDetail(d) {
                    const std = STD[d.data.std];
                    let html = "";
                    if (std) {
                        html +=
                            '<span class="font-space-grotesk text-xs uppercase tracking-wider" style="color:' +
                            std.fill +
                            '">' +
                            std.label +
                            "</span>";
                    } else {
                        html +=
                            '<span class="font-space-grotesk text-xs uppercase tracking-wider text-gray-400">' +
                            (d.depth === 0
                                ? "Archive"
                                : d.depth === 1
                                  ? "Discipline node"
                                  : "Group") +
                            "</span>";
                    }
                    html +=
                        '<h2 class="font-space-grotesk text-lg text-gray-900 mt-1 mb-2 leading-snug">' +
                        d.data.name +
                        "</h2>";

                    const rows = [];
                    if (d.data.host) rows.push(["Host", d.data.host]);
                    if (d.data.target) rows.push(["Target", d.data.target]);
                    if (d.data.years) rows.push(["Years", d.data.years]);
                    if (d.children) {
                        rows.push(["Datasets", String(d.leaves().length)]);
                        rows.push(["Approx. volume", volume(d.value)]);
                        const mix = {};
                        d.leaves().forEach(function (l) {
                            mix[l.data.std] = (mix[l.data.std] || 0) + 1;
                        });
                        const parts = Object.keys(mix)
                            .filter((k) => STD[k])
                            .map((k) => mix[k] + " " + STD[k].label);
                        if (parts.length) rows.push(["Filed as", parts.join(", ")]);
                    } else {
                        rows.push(["Approx. volume", volume(d.data.tb)]);
                        rows.push([
                            "Curated by",
                            d.ancestors()[d.ancestors().length - 2].data.name,
                        ]);
                    }
                    html += '<dl class="text-sm space-y-1 mb-3">';
                    rows.forEach(function (r) {
                        html +=
                            '<div class="flex gap-3"><dt class="text-gray-400 w-28 shrink-0">' +
                            r[0] +
                            '</dt><dd class="text-gray-700">' +
                            r[1] +
                            "</dd></div>";
                    });
                    html += "</dl>";
                    const blurb = d.data.blurb || d.data.note;
                    if (blurb)
                        html +=
                            '<p class="text-sm text-gray-600 leading-relaxed">' +
                            blurb +
                            "</p>";
                    if (d.children && d.depth > 0)
                        html +=
                            '<p class="text-xs text-gray-400 mt-3">Click the circle to open it.</p>';
                    detail.innerHTML = html;
                }

                function zoomTo(v) {
                    const k = W / v[2];
                    view = v;
                    node
                        .attr(
                            "transform",
                            (d) =>
                                "translate(" +
                                (d.x - v[0]) * k +
                                "," +
                                (d.y - v[1]) * k +
                                ")",
                        )
                        .attr("r", (d) => d.r * k);
                    label
                        .attr(
                            "transform",
                            (d) =>
                                "translate(" +
                                (d.x - v[0]) * k +
                                "," +
                                (d.y - v[1]) * k +
                                ")",
                        )
                        .each(function (d) {
                            const R = d.r * k;
                            const visible =
                                d.parent === focus ||
                                (d === focus && !d.children);
                            if (!visible) {
                                this.style.display = "none";
                                return;
                            }
                            // A container's label rides the top of its
                            // circle, above the children packed inside it; a
                            // leaf's sits in the middle of its own fill. Both
                            // are fitted to the chord they actually cross,
                            // never the full diameter.
                            const chord = d.children ? R * 1.35 : R * 1.72;
                            const size = Math.min(
                                chord / (d.widest * 0.55),
                                (R * (d.children ? 0.9 : 1.4)) /
                                    (d.lines.length * 1.15),
                                d.children ? 26 : 15,
                            );
                            if (size < 7) {
                                this.style.display = "none";
                                return;
                            }
                            this.style.display = "";
                            this.style.fontSize = size.toFixed(1) + "px";
                            this.style.strokeWidth = d.children
                                ? (size * 0.26).toFixed(1) + "px"
                                : "0";
                            d3.select(this).attr(
                                "y",
                                d.children
                                    ? -R + size * 1.15
                                    : -((d.lines.length - 1) * 0.575 * size) +
                                          size * 0.34,
                            );
                        });
                }

                function zoom(event, d) {
                    focus = d;
                    renderCrumbs();
                    markStrip();
                    const target = [focus.x, focus.y, focus.r * 2.05];
                    if (reduceMotion) {
                        zoomTo(target);
                        return;
                    }
                    svg
                        .transition()
                        .duration(650)
                        .tween("zoom", function () {
                            const i = d3.interpolateZoom(view, target);
                            return (t) => zoomTo(i(t));
                        });
                }

                // Volume decides circle size, which leaves NAIF a speck.
                // The strip keeps every node one click away regardless.
                root.children.forEach(function (d) {
                    const b = document.createElement("button");
                    b.type = "button";
                    b.className =
                        "font-space-grotesk text-xs rounded-full border px-3 py-1 " +
                        "border-gray-200 text-gray-600 hover:border-blue-400 hover:text-blue-700";
                    b.dataset.node = d.data.short;
                    b.textContent = d.data.short;
                    b.addEventListener("click", function (e) {
                        select(d);
                        zoom(e, d);
                    });
                    nodeStrip.appendChild(b);
                });
                const resetBtn = document.createElement("button");
                resetBtn.type = "button";
                resetBtn.className =
                    "font-space-grotesk text-xs rounded-full border px-3 py-1 " +
                    "border-gray-200 text-gray-400 hover:border-gray-400 hover:text-gray-700";
                resetBtn.textContent = "All nodes";
                resetBtn.addEventListener("click", function (e) {
                    select(root);
                    zoom(e, root);
                });
                nodeStrip.appendChild(resetBtn);

                function markStrip() {
                    const here = focus.ancestors().map((a) => a.data.short);
                    nodeStrip.querySelectorAll("button[data-node]").forEach(
                        function (b) {
                            const on = here.indexOf(b.dataset.node) > -1;
                            b.classList.toggle("border-blue-500", on);
                            b.classList.toggle("text-blue-700", on);
                            b.classList.toggle("border-gray-200", !on);
                            b.classList.toggle("text-gray-600", !on);
                        },
                    );
                }

                zoomTo([root.x, root.y, root.r * 2.05]);
                select(root);

                // Table view: the same 114 rows, readable without color.
                const tbody = document.getElementById("pds-table-body");
                let lastNode = null;
                let lastGroup = null;
                root.leaves().forEach(function (l) {
                    const anc = l.ancestors().reverse();
                    const nodeName = anc[1].data.short;
                    const groupName = anc[2].data.name;
                    const std = STD[l.data.std] || STD.pds4;
                    const tr = document.createElement("tr");
                    tr.className = "border-t border-gray-100 align-top";
                    tr.innerHTML =
                        '<td class="px-3 py-2 text-gray-500">' +
                        (nodeName === lastNode ? "" : nodeName) +
                        '</td><td class="px-3 py-2 text-gray-500">' +
                        (groupName === lastGroup ? "" : groupName) +
                        '</td><td class="px-3 py-2 text-gray-900">' +
                        l.data.name +
                        '</td><td class="px-3 py-2">' +
                        l.data.target +
                        '</td><td class="px-3 py-2 whitespace-nowrap">' +
                        l.data.years +
                        '</td><td class="px-3 py-2 whitespace-nowrap"><span class="inline-block w-2 h-2 rounded-full mr-2 align-middle" style="background:' +
                        std.fill +
                        '"></span>' +
                        std.label +
                        '</td><td class="px-3 py-2 text-right whitespace-nowrap">' +
                        volume(l.data.tb) +
                        "</td>";
                    tbody.appendChild(tr);
                    lastNode = nodeName;
                    lastGroup = groupName;
                });

                const mapView = document.getElementById("pds-map-view");
                const tableView = document.getElementById("pds-table-view");
                const toggle = document.getElementById("pds-view-toggle");
                toggle.addEventListener("click", function () {
                    const showTable = tableView.classList.contains("hidden");
                    tableView.classList.toggle("hidden", !showTable);
                    mapView.classList.toggle("hidden", showTable);
                    toggle.textContent = showTable ? "Show as map" : "Show as table";
                });
            });
        })();
    </script>
</BaseLayout>
