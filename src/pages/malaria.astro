                MYT: "175",
            };

            var allData = [];
            var worldTopo = null;
            var globeAnimId = null;
            var currentMetric = "MALARIA_EST_CASES";

            function parseCSV(text) {
                var lines = text.split("\n");
                var headers = parseCSVLine(lines[0]);
                var result = [];
                for (var i = 1; i < lines.length; i++) {
                    if (!lines[i].trim()) continue;
                    var vals = parseCSVLine(lines[i]);
                    var obj = {};
                    for (var j = 0; j < headers.length; j++)
                        obj[headers[j]] = vals[j] || "";
                    result.push(obj);
                }
                return result;
            }

            function parseCSVLine(line) {
                var result = [];
                var current = "",
                    inQuotes = false;
                for (var i = 0; i < line.length; i++) {
                    var ch = line[i];
                    if (inQuotes) {
                        if (ch === '"') {
                            if (i + 1 < line.length && line[i + 1] === '"') {
                                current += '"';
                                i++;
                            } else inQuotes = false;
                        } else current += ch;
                    } else {
                        if (ch === '"') inQuotes = true;
                        else if (ch === ",") {
                            result.push(current.trim());
                            current = "";
                        } else current += ch;
                    }
                }
                result.push(current.trim());
                return result;
            }

            function formatNum(n) {
                if (n >= 1e6) return (n / 1e6).toFixed(1) + "M";
                if (n >= 1e3) return (n / 1e3).toFixed(0) + "K";
                return String(n);
            }

            function padId(id) {
                return String(id).padStart(3, "0");
            }

            // =========================================================
            // GLOBE
            // =========================================================
            function drawGlobe(data) {
                var container = document.getElementById("globe-chart");
                if (!container) return;
                container.innerHTML = "";

                // Cancel any running animation
                if (globeAnimId) {
                    cancelAnimationFrame(globeAnimId);
                    globeAnimId = null;
                }

                if (!worldTopo) {
                    container.innerHTML =
                        '<p style="text-align:center;color:#999;padding:3rem 0">Loading globe data&hellip;</p>';
                    return;
                }

                var yearSelect = document.getElementById("globe-year-select");
                var year = yearSelect ? +yearSelect.value : 2024;

                // Build case lookup keyed by zero-padded numeric id
                // Stores {cases, low, high} or null for missing
                var isIncidence = currentMetric === "MALARIA_EST_INCIDENCE";
                var caseLookup = {};
                var numToName = {};
                for (var i = 0; i < data.length; i++) {
                    var d = data[i];
                    var numCode = ISO_A3_TO_NUM[d.SpatialDimValueCode];
                    if (!numCode) continue;
                    var pid = padId(numCode);
                    if (d.Location) numToName[pid] = d.Location;
                    if (d.IndicatorCode !== currentMetric) continue;
                    if (+d.Period === year) {
                        var raw = d.FactValueNumeric;
                        var parsed = Number(raw);
                        // Only record if there is an actual numeric value in the field
                        if (raw !== "" && raw !== undefined && !isNaN(parsed)) {
                            caseLookup[pid] = {
                                cases: parsed,
                                low: Number(d.FactValueNumericLow) || 0,
                                high: Number(d.FactValueNumericHigh) || 0,
                            };
                        }
                    }
                }

                var rect = container.getBoundingClientRect();
                var size = Math.min(rect.width, 640);
                if (size < 50) size = 300;

                // Projection & path
                var projection = d3
                    .geoOrthographic()
                    .scale(size * 0.45)
                    .translate([size / 2, size / 2])
                    .clipAngle(90);

                var pathGen = d3.geoPath().projection(projection);

                var svg = d3
                    .select(container)
                    .append("svg")
                    .attr("width", size)
                    .attr("height", size)
                    .style("touch-action", "none")
                    .style("cursor", "grab")
                    .style("-webkit-user-select", "none")
                    .style("user-select", "none");

                // Ocean
                var sphere = { type: "Sphere" };
                svg.append("path")
                    .datum(sphere)
                    .attr("d", pathGen)
                    .attr("fill", "#ffffff")
                    .attr("stroke", "#ccc")
                    .attr("stroke-width", 1.5);

                // Graticule
                var graticulePath = svg
                    .append("path")
                    .datum(d3.geoGraticule10())
                    .attr("d", pathGen)
                    .attr("fill", "none")
                    .attr("stroke", "#ddd")
                    .attr("stroke-width", 0.4);

                // Color scale (log for better spread)
                var caseValues = Object.values(caseLookup)
                    .map(function (v) {
                        return v.cases;
                    })
                    .filter(function (v) {
                        return v > 0;
                    });
                var minPositive = d3.min(caseValues) || 1;
                var maxCases = d3.max(caseValues) || 1;
                // For cases use domain [1, max] (log(0) undefined, but label shows 0)
                // For incidence use actual min since values can be fractional
                var domainMin = isIncidence ? minPositive : 1;
                var colorScale = d3
                    .scaleSequentialLog(d3.interpolateBlues)
                    .domain([domainMin, maxCases]);

                // Convert TopoJSON → GeoJSON
                var countries = topojson.feature(
                    worldTopo,
                    worldTopo.objects.countries,
                );

                // Draw countries
                var countryPaths = svg
                    .selectAll(".country")
                    .data(countries.features)
                    .enter()
                    .append("path")
                    .attr("class", "country")
                    .attr("d", pathGen)
                    .attr("fill", function (d) {
                        var id = padId(d.id);
                        if (!(id in caseLookup)) return "#d1d5db";
                        var entry = caseLookup[id];
                        return entry.cases > 0
                            ? colorScale(entry.cases)
                            : "#f5f5f0";
                    })
                    .attr("stroke", "#fff")
                    .attr("stroke-width", 0.3);

                // Borders (mesh)
                var bordersPath = svg
                    .append("path")
                    .datum(
                        topojson.mesh(
                            worldTopo,
                            worldTopo.objects.countries,
                            function (a, b) {
                                return a !== b;
                            },
                        ),
                    )
                    .attr("d", pathGen)
                    .attr("fill", "none")
                    .attr("stroke", "#fff")
                    .attr("stroke-width", 0.5);

                // Sphere outline on top
                var spherePath = svg
                    .append("path")
                    .datum(sphere)
                    .attr("d", pathGen)
                    .attr("fill", "none")
                    .attr("stroke", "#ccc")
                    .attr("stroke-width", 1.5);

                // Tooltip div
                var tooltip = d3
                    .select(container)
                    .append("div")
                    .style("position", "absolute")
                    .style("pointer-events", "none")
                    .style("background", "rgba(0,0,0,0.85)")
                    .style("color", "#fff")
                    .style("padding", "8px 12px")
                    .style("border-radius", "6px")
                    .style("font-size", "13px")
                    .style("line-height", "1.4")
                    .style("display", "none")
                    .style("white-space", "pre-line")
                    .style("max-width", "280px")
                    .style("z-index", "10")
                    .style("box-shadow", "0 2px 8px rgba(0,0,0,0.25)");

                // Tooltip helpers
                function fmtIncidence(v) {
                    return v < 0.1 ? v.toPrecision(2) : v.toFixed(1);
                }

                function buildTooltipHtml(id) {
                    var name = numToName[id] || "Unknown";
                    var hasData = id in caseLookup;
                    if (hasData) {
                        var entry = caseLookup[id];
                        if (entry.cases > 0) {
                            var label = isIncidence
                                ? fmtIncidence(entry.cases) +
                                  " per 1,000 at risk"
                                : entry.cases.toLocaleString() + " cases";
                            var html =
                                "<strong>" + name + "</strong><br>" + label;
                            if (entry.low > 0 || entry.high > 0) {
                                var ciLow = isIncidence
                                    ? fmtIncidence(entry.low)
                                    : entry.low.toLocaleString();
                                var ciHigh = isIncidence
                                    ? fmtIncidence(entry.high)
                                    : entry.high.toLocaleString();
                                html +=
                                    "<br><span style='font-size:11px;color:#aaa'>95% CI: " +
                                    ciLow +
                                    " \u2013 " +
                                    ciHigh +
                                    "</span>";
                            }
                            return html;
                        }
                        return "<strong>" + name + "</strong><br>" +
                            (isIncidence ? "0 per 1,000 at risk" : "0 cases");
                    }
                    return "<strong>" + name + "</strong><br>No data";
                }

                function positionTooltip(px, py) {
                    var cw = container.offsetWidth;
                    var ch = container.offsetHeight;
                    // Show tooltip, measure it, then clamp position
                    var ttNode = tooltip.node();
                    var tw = ttNode.offsetWidth || 150;
                    var th = ttNode.offsetHeight || 40;
                    var x = px + 14;
                    var y = py - 12;
                    // Keep within container bounds
                    if (x + tw > cw - 8) x = px - tw - 8;
                    if (y + th > ch - 8) y = ch - th - 8;
                    if (y < 4) y = 4;
                    if (x < 4) x = 4;
                    tooltip.style("left", x + "px").style("top", y + "px");
                }

                var activeCountry = null;

                countryPaths
                    .on("mouseover", function (event, d) {
                        var id = padId(d.id);
                        tooltip
                            .style("display", "block")
                            .html(buildTooltipHtml(id));
                        d3.select(this)
                            .attr("stroke", "#222")
                            .attr("stroke-width", 1.5)
                            .raise();
                        activeCountry = this;
                    })
                    .on("mousemove", function (event) {
                        var coords = d3.pointer(event, container);
                        positionTooltip(coords[0], coords[1]);
                    })
                    .on("mouseout", function () {
                        tooltip.style("display", "none");
                        d3.select(this)
                            .attr("stroke", "#fff")
                            .attr("stroke-width", 0.3);
                        activeCountry = null;
                    });

                // Touch: tap a country to show tooltip, tap elsewhere to dismiss
                svg.on("click", function (event) {
                    var coords = d3.pointer(event, container);
                    var svgCoords = d3.pointer(event, svg.node());
                    // Find which country was tapped using projection inversion
                    var lonlat = projection.invert(svgCoords);
                    if (!lonlat) {
                        tooltip.style("display", "none");
                        return;
                    }
                    var tapped = null;
                    countries.features.forEach(function (f) {
                        if (d3.geoContains(f, lonlat)) tapped = f;
                    });
                    // Reset previous highlight
                    if (activeCountry) {
                        d3.select(activeCountry)
                            .attr("stroke", "#fff")
                            .attr("stroke-width", 0.3);
                    }
                    if (tapped) {
                        var id = padId(tapped.id);
                        tooltip
                            .style("display", "block")
                            .html(buildTooltipHtml(id));
                        positionTooltip(coords[0], coords[1]);
                        // Highlight tapped country
                        countryPaths.each(function (dd) {
                            if (dd === tapped) {
                                d3.select(this)
                                    .attr("stroke", "#222")
                                    .attr("stroke-width", 1.5)
                                    .raise();
                                activeCountry = this;
                            }
                        });
                    } else {
                        tooltip.style("display", "none");
                        activeCountry = null;
                    }
                });

                // --- Redraw helper ---
                function redraw() {
                    countryPaths.attr("d", pathGen);
                    graticulePath.attr("d", pathGen);
                    bordersPath.attr("d", pathGen);
                    spherePath.attr("d", pathGen);
                }

                // --- Drag rotation (mouse + touch) ---
                var dragging = false;
                var velocity = [0, 0];

                svg.call(
                    d3
                        .drag()
                        .on("start", function (event) {
                            dragging = true;
                            stopSpin();
                            svg.style("cursor", "grabbing");
                            var r = projection.rotate();
                            this._r0 = [r[0], r[1]];
                            this._xy0 = [event.x, event.y];
                            this._last = {
                                x: event.x,
                                y: event.y,
                                t: Date.now(),
                            };
                            velocity = [0, 0];
                        })
                        .on("drag", function (event) {
                            var sens = 0.4;
                            projection.rotate([
                                this._r0[0] + (event.x - this._xy0[0]) * sens,
                                Math.max(
                                    -60,
                                    Math.min(
                                        60,
                                        this._r0[1] -
                                            (event.y - this._xy0[1]) * sens,
                                    ),
                                ),
                            ]);
                            redraw();

                            var now = Date.now();
                            var dt = Math.max(1, now - this._last.t);
                            velocity = [
                                ((event.x - this._last.x) / dt) * 16,
                                ((event.y - this._last.y) / dt) * 16,
                            ];
                            this._last = { x: event.x, y: event.y, t: now };
                        })
                        .on("end", function () {
                            dragging = false;
                            svg.style("cursor", "grab");

                            // Momentum
                            var vx = velocity[0] * 0.3;
                            var vy = velocity[1] * 0.3;
                            if (Math.abs(vx) > 0.2 || Math.abs(vy) > 0.2) {
                                (function coast() {
                                    if (dragging) return;
                                    vx *= 0.95;
                                    vy *= 0.95;
                                    if (
                                        Math.abs(vx) < 0.01 &&
                                        Math.abs(vy) < 0.01
                                    ) {
                                        startSpin();
                                        return;
                                    }
                                    var r = projection.rotate();
                                    projection.rotate([
                                        r[0] + vx,
                                        Math.max(-60, Math.min(60, r[1] - vy)),
                                    ]);
                                    redraw();
                                    globeAnimId = requestAnimationFrame(coast);
                                })();
                            } else {
                                startSpin();
                            }
                        }),
                );

                // --- Auto-spin ---
                var paused = false;

                function startSpin() {
                    if (dragging || paused) return;
                    (function spin() {
                        if (dragging || paused) return;
                        var r = projection.rotate();
                        projection.rotate([r[0] + 0.15, r[1]]);
                        redraw();
                        globeAnimId = requestAnimationFrame(spin);
                    })();
                }

                function stopSpin() {
                    if (globeAnimId) {
                        cancelAnimationFrame(globeAnimId);
                        globeAnimId = null;
                    }
                }

                // Pause button (upper-left of globe container)
                var pauseBtn = document.createElement("button");
                pauseBtn.innerHTML = "&#10074;&#10074;";
                pauseBtn.title = "Pause rotation";
                pauseBtn.style.cssText =
                    "position:absolute;top:6px;left:6px;width:36px;height:36px;border-radius:50%;border:1px solid #d1d5db;background:#fff;color:#6b7280;font-size:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;opacity:0.6;transition:opacity 0.2s;z-index:5";
                pauseBtn.addEventListener("mouseenter", function () {
                    this.style.opacity = "1";
                });
                pauseBtn.addEventListener("mouseleave", function () {
                    this.style.opacity = "0.6";
                });
                pauseBtn.addEventListener("click", function () {
                    paused = !paused;
                    if (paused) {
                        stopSpin();
                        pauseBtn.innerHTML = "&#9654;";
                        pauseBtn.title = "Resume rotation";
                    } else {
                        pauseBtn.innerHTML = "&#10074;&#10074;";
                        pauseBtn.title = "Pause rotation";
                        startSpin();
                    }
                });
                container.appendChild(pauseBtn);

                // Kick off the spin
                startSpin();

                // --- Legend ---
                var legendW = Math.min(180, size * 0.4);
                var legendH = 10;
                var legendX = size - legendW - 14;
                var legendY = size - 40;

                var defs = svg.append("defs");
                var grad = defs.append("linearGradient").attr("id", "globe-lg");
                var numStops = 10;
                for (var si = 0; si <= numStops; si++) {
                    var t = si / numStops;
                    var val =
                        domainMin *
                        Math.pow(maxCases / domainMin, t);
                    grad.append("stop")
                        .attr("offset", t * 100 + "%")
                        .attr("stop-color", colorScale(val));
                }

                svg.append("rect")
                    .attr("x", legendX)
                    .attr("y", legendY)
                    .attr("width", legendW)
                    .attr("height", legendH)
                    .attr("rx", 2)
                    .attr("fill", "url(#globe-lg)")
                    .attr("stroke", "#bbb");

                // No-data / zero legend indicators
                var swatchY = legendY - 14;
                // No data swatch
                svg.append("rect")
                    .attr("x", legendX)
                    .attr("y", swatchY)
                    .attr("width", 8)
                    .attr("height", 8)
                    .attr("rx", 1)
                    .attr("fill", "#d1d5db")
                    .attr("stroke", "#bbb");
                svg.append("text")
                    .attr("x", legendX + 11)
                    .attr("y", swatchY + 7)
                    .attr("font-size", "8px")
                    .attr("fill", "#666")
                    .text("No data");
                // Zero / eliminated swatch
                svg.append("rect")
                    .attr("x", legendX + 52)
                    .attr("y", swatchY)
                    .attr("width", 8)
                    .attr("height", 8)
                    .attr("rx", 1)
                    .attr("fill", "#f5f5f0")
                    .attr("stroke", "#bbb");
                svg.append("text")
                    .attr("x", legendX + 63)
                    .attr("y", swatchY + 7)
                    .attr("font-size", "8px")
                    .attr("fill", "#666")
                    .text("0 cases");

                var minLabel = isIncidence
                    ? (minPositive < 1 ? "<1" : fmtIncidence(minPositive))
                    : "0";
                var maxLabel = isIncidence
                    ? (maxCases >= 10
                        ? maxCases.toFixed(0)
                        : maxCases.toFixed(1)) + "/1K"
                    : formatNum(maxCases);

                svg.append("text")
                    .attr("x", legendX)
                    .attr("y", legendY + legendH + 9)
                    .attr("font-size", "9px")
                    .attr("fill", "#666")
                    .text(minLabel);
                svg.append("text")
                    .attr("x", legendX + legendW)
                    .attr("y", legendY + legendH + 9)
                    .attr("text-anchor", "end")
                    .attr("font-size", "9px")
                    .attr("fill", "#666")
                    .text(maxLabel);
            }

            // =========================================================
            // INIT
            // =========================================================

            function init() {
                Promise.all([
                    fetch("/data/malariadata.csv").then(function (r) {
                        if (!r.ok)
                            throw new Error("CSV fetch failed: " + r.status);
                        return r.text();
                    }),
                    d3.json(
                        "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
                    ),
                ])
                    .then(function (results) {
                        allData = parseCSV(results[0]);
                        worldTopo = results[1];

                        // Build year dropdown options
                        var yearSelect =
                            document.getElementById("globe-year-select");
                        for (var yr = 2000; yr <= 2024; yr++) {
                            var opt = document.createElement("option");
                            opt.value = yr;
                            opt.textContent = yr;
                            if (yr === 2024) opt.selected = true;
                            yearSelect.appendChild(opt);
                        }
                        yearSelect.addEventListener("change", function () {
                            drawGlobe(allData);
                        });

                        // Metric toggle
                        var btnCases =
                            document.getElementById("metric-cases");
                        var btnIncidence =
                            document.getElementById("metric-incidence");
                        function setMetricBtn(active, inactive) {
                            active.className =
                                "rounded px-3 py-1 text-sm font-medium transition-colors bg-gray-500 text-white";
                            inactive.className =
                                "rounded px-3 py-1 text-sm font-medium transition-colors text-gray-600 hover:bg-gray-100";
                        }
                        btnCases.addEventListener("click", function () {
                            currentMetric = "MALARIA_EST_CASES";
                            setMetricBtn(btnCases, btnIncidence);
                            drawGlobe(allData);
                        });
                        btnIncidence.addEventListener("click", function () {
                            currentMetric = "MALARIA_EST_INCIDENCE";
                            setMetricBtn(btnIncidence, btnCases);
                            drawGlobe(allData);
                        });

                        // Draw
                        drawGlobe(allData);

                        // Responsive redraw
                        var resizeTimer;
                        window.addEventListener("resize", function () {
                            clearTimeout(resizeTimer);
                            resizeTimer = setTimeout(function () {
                                drawGlobe(allData);
                            }, 200);
                        });
                    })
                    .catch(function (err) {
                        console.error("Malaria globe error:", err);
                        var c = document.getElementById("globe-chart");
                        if (c)
                            c.innerHTML =
                                '<p style="color:red;text-align:center;padding:2rem">Error loading data. Check console.</p>';
                    });
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", init);
            } else {
                init();
            }
        })();
    </script>
</BaseLayout>
