                    unit: "",
                },
                3: {
                    title: "Sickle Cell Incidence",
                    colorScheme: "purples",
                    dataKey: "sickle",
                    label: "Estimated new cases",
                    unit: "",
                },
            };

            // --- State ---
            let worldGeo = null;
            let worldTopo = null;
            let dataByStep = { anopheles: {}, malaria: {}, sickle: {} };
            let currentStep = 0;
            let svg, g, projection, pathGen;
            const tooltip = document.getElementById("tooltip");
            const legend = document.getElementById("legend");
            const legendTitle = document.getElementById("legend-title");
            const legendBar = document.getElementById("legend-bar");
            const legendMin = document.getElementById("legend-min");
            const legendMax = document.getElementById("legend-max");

            // --- Color interpolators (manual, no D3 dependency for color) ---
            // D3-style interpolation
            function interpolateGreens(t) {
                const r = Math.round(247 - t * 203);
                const g = Math.round(252 - t * 120);
                const b = Math.round(245 - t * 200);
                return `rgb(${r},${g},${b})`;
            }
            function interpolateBlues(t) {
                const r = Math.round(247 - t * 179);
                const g = Math.round(251 - t * 139);
                const b = Math.round(255 - t * 51);
                return `rgb(${r},${g},${b})`;
            }
            function interpolatePurples(t) {
                const r = Math.round(252 - t * 139);
                const g = Math.round(251 - t * 172);
                const b = Math.round(253 - t * 51);
                return `rgb(${r},${g},${b})`;
            }

            function getInterpolator(scheme) {
                if (scheme === "greens") return interpolateGreens;
                if (scheme === "blues") return interpolateBlues;
                if (scheme === "purples") return interpolatePurples;
                return () => "#e5e7eb";
            }

            function getGradientCSS(scheme) {
                const interp = getInterpolator(scheme);
                const stops = [0, 0.25, 0.5, 0.75, 1]
                    .map((t) => interp(t))
                    .join(", ");
                return `linear-gradient(to right, ${stops})`;
            }

            // Power scale (exponent 0.5 = sqrt) for better visual distribution
            function powerScale(value, max, exponent) {
                if (max <= 0 || value <= 0) return 0;
                return Math.pow(value / max, exponent);
            }

            // --- CSV parsing ---
            function parseCSV(text) {
                const lines = text.split("\n");
                const headers = lines[0].split(",").map((h) => h.trim());
                const rows = [];
                for (let i = 1; i < lines.length; i++) {
                    if (!lines[i].trim()) continue;
                    const vals = lines[i].split(",").map((v) => v.trim());
                    const obj = {};
                    for (let j = 0; j < headers.length; j++) {
                        obj[headers[j]] = vals[j] || "";
                    }
                    rows.push(obj);
                }
                return rows;
            }

            // --- Load all data ---
            async function loadData() {
                const [anophelesResp, whoResp, sickleResp, topoResp] =
                    await Promise.all([
                        fetch("/data/malariadata/anopheles_by_country.csv"),
                        fetch("/data/malariadata/whomalariadata.csv"),
                        fetch("/data/malariadata/ihme_sickle_cell.csv"),
                        fetch(
                            "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
                        ),
                    ]);

                // Parse anopheles
                const anophelesRows = parseCSV(await anophelesResp.text());
                for (const row of anophelesRows) {
                    const code = row.iso_a3;
                    const count = parseFloat(row.count);
                    if (code && !isNaN(count)) {
                        dataByStep.anopheles[code] = count;
                    }
                }

                // Parse WHO malaria — filter: MALARIA_EST_INCIDENCE, Period == 2021
                const whoText = await whoResp.text();
                const whoLines = whoText.split("\n");
                for (let i = 1; i < whoLines.length; i++) {
                    const line = whoLines[i];
                    if (!line.includes("MALARIA_EST_CASES")) continue;
                    const parts = line.split(",");
                    const period = parts[9];
                    if (period !== "2021") continue;
                    const code = parts[6];
                    const value = parseFloat(parts[23]);
                    if (code && !isNaN(value)) {
                        dataByStep.malaria[code] = value;
                    }
                }

                // Parse sickle cell — filter: year == 2021
                const sickleRows = parseCSV(await sickleResp.text());
                for (const row of sickleRows) {
                    if (row.year !== "2021") continue;
                    const code = row.iso_a3;
                    const value = parseFloat(row.incidence);
                    if (code && !isNaN(value)) {
                        dataByStep.sickle[code] = value;
                    }
                }

                // Parse TopoJSON
                const topoData = await topoResp.json();
                worldTopo = topoData;
                worldGeo = topojson.feature(
                    topoData,
                    topoData.objects.countries,
                );
            }

            // --- Map rendering ---
            function isMobile() {
                return window.innerWidth < 768;
            }

            function applyProjection(width, height) {
                projection = d3
                    .geoNaturalEarth1()
                    .fitSize([width, height], worldGeo);

                if (isMobile()) {
                    // Center on Africa, filling the mobile screen
                    projection = d3.geoNaturalEarth1()
                        .center([20, 5])
                        .scale(projection.scale() * 3.5)
                        .translate([width / 2, height / 2]);
                } else {
                    projection.translate([
                        width / 2,
                        height / 2 + height * 0.08,
                    ]);
                }
            }

            function initMap() {
                const width = window.innerWidth;
                const height = window.innerHeight;

                svg = d3
                    .select("#map-svg")
                    .attr("viewBox", `0 0 ${width} ${height}`)
                    .attr("preserveAspectRatio", "xMidYMid meet");

                applyProjection(width, height);

                pathGen = d3.geoPath().projection(projection);

                // We need iso_a3 codes — world-atlas uses numeric IDs, so build a lookup
                g = svg.append("g");

                g.selectAll("path")
                    .data(worldGeo.features)
                    .enter()
                    .append("path")
                    .attr("class", "country")
                    .attr("d", pathGen)
                    .attr("fill", "#e5e7eb")
                    .attr("data-id", (d) => d.id)
                    .attr("data-name", (d) => d.properties.name)
                    .on("mouseenter", handleMouseEnter)
                    .on("mousemove", handleMouseMove)
                    .on("mouseleave", handleMouseLeave)
                    .on("click", handleClick);

                // Draw uniform border mesh on top
                g.append("path")
                    .datum(
                        topojson.mesh(
                            worldTopo,
                            worldTopo.objects.countries,
                            (a, b) => a !== b,
                        ),
                    )
                    .attr("class", "borders")
                    .attr("d", pathGen);

                // Hover highlight path — sits on top of everything
                g.append("path")
                    .attr("class", "country-highlight")
                    .attr("d", null);
            }

