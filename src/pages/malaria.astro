---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<script is:inline src="https://d3js.org/d3.v7.min.js"></script>
<script is:inline src="https://unpkg.com/topojson-client@3"></script>

<BaseLayout
    title="Global Malaria Cases | Claire Nyquist"
    description="Interactive visualization of estimated malaria cases worldwide from 2000–2024, using WHO Global Health Observatory data."
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Hero Section -->
        <div class="text-center mb-8 md:mb-12">
            <h1
                class="text-3xl sm:text-4xl md:text-6xl font-bold text-gray-900 mb-4 md:mb-6"
            >
                Malaria
            </h1>
            <p
                class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed px-4"
            >
                Estimated malaria cases by country from 2000 to 2024.
            </p>
            <p
                class="text-base sm:text-lg text-gray-600 max-w-4xl mx-auto leading-relaxed mt-4 px-4"
            >
                This visualization uses WHO estimates of malaria cases across
                110 countries. Drag the globe to explore, hover for details, and
                select a year to see how the burden has shifted over 25 years.
                Use the toggle to switch between absolute case counts and
                incidence per 1,000 population at risk. Absolute counts show
                where the most people are affected; incidence reveals
                transmission intensity regardless of country size. Countries shown in gray have no WHO case
                estimates because they eliminated malaria before the reporting
                period. The dataset only covers countries under active WHO
                malaria surveillance.
            </p>
        </div>

        <!-- Interactive Globe -->
        <div class="mb-16">
            <div class="bg-white rounded-lg shadow-sm border overflow-hidden">
                <div class="p-4 sm:p-6 bg-gray-50 border-b">
                    <h2
                        class="text-xl sm:text-2xl font-bold text-gray-900 mb-3 sm:mb-4"
                    >
                        Global Distribution
                    </h2>
                    <p class="text-sm sm:text-base text-gray-600 mb-4">
                        Drag to rotate the globe. <span class="hidden sm:inline"
                            >Hover over</span
                        ><span class="sm:hidden">Tap</span> a country to see estimated
                        malaria cases.
                    </p>
                    <div class="flex flex-wrap items-center gap-3">
                        <div class="flex items-center gap-2">
                            <label
                                for="globe-year-select"
                                class="text-sm font-medium text-gray-700"
                                >Year</label
                            >
                            <select
                                id="globe-year-select"
                                class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 shadow-sm focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-gray-500 cursor-pointer"
                            >
                            </select>
                        </div>
                        <div class="flex items-center gap-1 rounded-md border border-gray-300 bg-white p-0.5">
                            <button
                                id="metric-cases"
                                class="rounded px-3 py-1 text-sm font-medium transition-colors bg-gray-500 text-white"
                                >Total Cases</button
                            >
                            <button
                                id="metric-incidence"
                                class="rounded px-3 py-1 text-sm font-medium transition-colors text-gray-600 hover:bg-gray-100"
                                >Per 1,000 at Risk</button
                            >
                        </div>
                    </div>
                </div>
                <div class="p-4 sm:p-6 flex justify-center">
                    <div
                        id="globe-chart"
                        style="width:100%;max-width:640px;aspect-ratio:1;position:relative;"
                    >
                    </div>
                </div>
                <div
                    class="px-4 pb-4 text-xs text-gray-500 border-t bg-gray-50"
                >
                    <p class="mt-2">
                        <strong>Data Source:</strong> World Health Organization. Estimated
                        number of malaria cases. Global Health Observatory, 2000–2024.
                        Map data from Natural Earth via
                        <a
                            href="https://github.com/topojson/world-atlas"
                            class="text-blue-600 hover:text-blue-800"
                            target="_blank"
                            rel="noopener">world-atlas</a
                        >.
                    </p>
                </div>
            </div>
        </div>

        <!-- Data Sources -->
        <div class="mt-12 bg-white rounded-lg shadow-sm border p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">
                Data Sources
            </h3>
            <p class="text-sm text-gray-600 mb-3">
                World Health Organization. (2025). Estimated number of malaria
                cases. Global Health Observatory. [Data set]. <a
                    href="https://www.who.int/data/gho/data/indicators/indicator-details/GHO/estimated-number-of-malaria-cases"
                    class="text-blue-600 hover:text-blue-800 break-words"
                    target="_blank"
                    rel="noopener"
                    >https://www.who.int/data/gho/data/indicators/indicator-details/GHO/estimated-number-of-malaria-cases</a
                >
            </p>
            <p class="text-sm text-gray-600 mb-3">
                Data covers WHO member state estimates of malaria cases from
                2000 to 2024, reported by country and WHO region. Estimates are
                produced by WHO and partners based on nationally reported data
                adjusted for reporting completeness, diagnostic testing rates,
                and health facility utilization.
            </p>
            <p class="text-sm text-gray-600 mb-3">
                Natural Earth. (2024). Admin 0 – Countries. Via
                <a
                    href="https://github.com/topojson/world-atlas"
                    class="text-blue-600 hover:text-blue-800 break-words"
                    target="_blank"
                    rel="noopener"
                    >world-atlas</a
                > (TopoJSON, 110m resolution).
            </p>
            <p class="text-sm text-gray-600 mb-3">
                D3.js: Mike Bostock. (2024). D3: Data-Driven Documents. <a
                    href="https://d3js.org/"
                    class="text-blue-600 hover:text-blue-800 break-words"
                    target="_blank"
                    rel="noopener">https://d3js.org/</a
                >
            </p>
            <p class="text-sm text-gray-600">
                Roser, M. &amp; Ritchie, H. (2024). Malaria. <em>Our World in Data.</em>
                <a
                    href="https://ourworldindata.org/malaria"
                    class="text-blue-600 hover:text-blue-800 break-words"
                    target="_blank"
                    rel="noopener"
                    >https://ourworldindata.org/malaria</a
                >
            </p>

            <!-- Video Sources (hidden for now)
            <h3 class="text-lg font-semibold text-gray-900 mb-3 mt-6 pt-6 border-t">
                Video Sources
            </h3>
            <ul class="text-sm text-gray-600 space-y-3 list-none">
                <li>
