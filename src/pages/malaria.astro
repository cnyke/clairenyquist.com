---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Malaria, Mosquitoes & Sickle Cell | Claire Nyquist";
const description =
    "A scrollytelling choropleth exploring the geographic overlap between Anopheles mosquitoes, malaria incidence, and sickle cell disease.";
---

<BaseLayout title={title} description={description}>
    <!-- Fixed full-screen map -->
    <div id="map-wrap" class="fixed inset-0 w-full h-full" style="z-index:2;">
        <svg id="map-svg" class="w-full h-full"></svg>
    </div>

    <!-- Legend -->
    <div
        id="legend"
        class="bg-white/90 backdrop-blur rounded-lg shadow-lg p-3 transition-opacity duration-300 opacity-0"
        style="position:fixed; bottom:1.5rem; right:1.5rem; z-index:50; min-width:160px;"
    >
        <div id="legend-title" class="text-xs font-semibold text-gray-700 mb-1">
        </div>
        <div id="legend-bar" class="h-3 rounded" style="width:140px;"></div>
        <div class="flex justify-between text-[10px] text-gray-500 mt-0.5">
            <span id="legend-min"></span>
            <span id="legend-max"></span>
        </div>
    </div>

    <!-- Tooltip -->
    <div
        id="tooltip"
        class="fixed pointer-events-none hidden text-gray-900 text-sm rounded-lg px-3 py-2 shadow-lg"
        style="z-index:100; max-width:220px; background:rgba(255,255,255,0.55); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.5);"
    >
    </div>

    <!-- Scroll sections overlay -->
    <div
        id="scroll-container"
        class="relative pointer-events-none"
        style="z-index:3;"
    >
        <!-- Step 0: Intro — visible immediately -->
        <section
            data-step="0"
            class="scroll-step visible px-4 md:px-12 pt-24 pb-8"
        >
            <div class="glass-card ml-0 md:ml-[5%]">
                <h1 class="text-2xl md:text-4xl font-bold text-gray-900 mb-3">
                    Malaria, Mosquitoes & Sickle Cell
                </h1>
                <p class="text-sm md:text-base text-gray-700 leading-relaxed">
                    Scroll to see how Anopheles mosquito distribution, malaria
                    incidence, and sickle cell disease overlap geographically
                    &mdash; revealing the evolutionary pressure that made a
                    deadly blood disorder a survival advantage.
                </p>
                <p class="text-xs text-gray-400 mt-3">Scroll to continue</p>
            </div>
        </section>

        <!-- Spacer — map visible -->
        <div style="height:80vh;"></div>

        <!-- Step 1: Anopheles -->
        <section
            data-step="1"
            class="scroll-step px-4 md:px-12 py-8 flex justify-end"
        >
            <div class="glass-card mr-0 md:mr-[5%]">
                <h2
                    class="text-xl md:text-2xl font-bold mb-2"
                    style="color:#1a7a3a;"
                >
                    Anopheles Mosquito Distribution
                </h2>
                <p class="text-sm md:text-base text-gray-700 leading-relaxed">
                    Of the roughly 500 known <em>Anopheles</em> species, about 40
                    are competent malaria vectors. The genus thrives in tropical and
                    subtropical climates where standing water, warm temperatures,
                    and humidity support larval development. Countries are shaded
                    by GBIF occurrence records &mdash; a proxy for species diversity
                    and surveillance effort. Sub-Saharan Africa dominates, home to
                    <em>Anopheles gambiae</em> and <em>Anopheles funestus</em>,
                    the most efficient vectors of <em>Plasmodium falciparum</em
                    >. Southeast Asia harbors a distinct complex including <em
                        >Anopheles dirus</em
                    > and <em>Anopheles minimus</em>, adapted to forest-fringe
                    habitats. Note that the United States appears heavily shaded
                    despite having eliminated malaria in 1951 &mdash; this
                    reflects sampling bias, not vector competence. U.S.
                    institutions contribute disproportionately to GBIF, and
                    decades of well-funded entomological surveillance have
                    generated far more digitized specimen records per capita
                    than most tropical countries where <em>Anopheles</em> actually
                    transmits disease. Gaps elsewhere often reflect limited sampling
                    rather than true absence.
                </p>
                <p class="text-xs text-gray-400 mt-3 leading-relaxed">
                    GBIF.org (24 March 2026) GBIF Occurrence Download <a
                        href="https://doi.org/10.15468/dl.zffc2v"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline hover:text-gray-600"
                        >https://doi.org/10.15468/dl.zffc2v</a
                    >
                </p>
            </div>
        </section>

        <!-- Spacer — map visible -->
        <div style="height:80vh;"></div>

        <!-- Step 2: Malaria Incidence -->
        <section data-step="2" class="scroll-step px-4 md:px-12 py-8">
            <div class="glass-card ml-0 md:ml-[5%]">
                <h2
                    class="text-xl md:text-2xl font-bold mb-2"
                    style="color:#1a5fb4;"
                >
                    Malaria Incidence
                </h2>
                <p class="text-sm md:text-base text-gray-700 leading-relaxed">
                    WHO estimated number of malaria cases by country (2021).
                    Nigeria alone accounts for roughly 65 million cases &mdash;
                    about 27% of the global total. Five species of <em>Plasmodium</em>
                    infect humans, but <em>P. falciparum</em>
                    causes over 90% of deaths, concentrated in sub-Saharan Africa.
                    The parasite's complex life cycle &mdash; sexual reproduction
                    in the mosquito, asexual multiplication in human liver and red
                    blood cells &mdash; makes eradication exceptionally difficult.
                    Notice how the case burden tracks the vector distribution:
                    where <em>Anopheles</em> density is highest, malaria follows.
                    Countries with zero cases in the tropics (e.g., Sri Lanka)
                    represent hard-won elimination successes through vector control,
                    surveillance, and treatment access. This map uses absolute case
                    counts rather than per-capita rates to parallel the sickle cell
                    data below &mdash; both show total burden, making the geographic
                    overlap between the two diseases directly comparable. The tradeoff
                    is that populous countries like Nigeria and the DRC dominate the
                    color scale; a per-capita view would more evenly highlight
                    smaller high-burden nations like Niger and Burkina Faso.
                </p>
                <p class="text-xs text-gray-400 mt-3 leading-relaxed">
                    World Health Organization. Global Health Observatory —
                    Estimated number of malaria cases,
                    2021. <a
                        href="https://www.who.int/data/gho/data/indicators/indicator-details/GHO/malaria-incidence-(per-1-000-population-at-risk)"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline hover:text-gray-600"
                        >https://www.who.int/data/gho</a
                    >
                </p>
            </div>
        </section>

        <!-- Spacer — map visible -->
        <div style="height:80vh;"></div>

        <!-- Step 3: Sickle Cell -->
        <section
            data-step="3"
            class="scroll-step px-4 md:px-12 py-8 flex justify-end"
        >
            <div class="glass-card mr-0 md:mr-[5%]">
                <h2
                    class="text-xl md:text-2xl font-bold mb-2"
                    style="color:#6b21a8;"
                >
                    Sickle Cell Disease
                </h2>
                <p class="text-sm md:text-base text-gray-700 leading-relaxed">
                    Sickle cell disease arises from a point mutation in the
                    &beta;-globin gene (HBB, Glu6Val) that causes hemoglobin S
                    to polymerize under low oxygen, deforming red blood cells
                    into rigid sickle shapes. Homozygous individuals (HbSS)
                    suffer chronic hemolytic anemia, vaso-occlusive crises, and
                    organ damage. Yet heterozygous carriers (HbAS) gain
                    significant protection against severe <em>P. falciparum</em> malaria
                    &mdash; sickled cells are cleared faster by the spleen, and the
                    parasite grows poorly in HbS erythrocytes. This heterozygote advantage
                    has maintained allele frequencies as high as 15&ndash;20% in malaria-endemic
                    West and Central Africa over thousands of generations, a textbook
                    case of balancing selection. Compare this map to the malaria layer
                    above: the geographic overlap is striking evidence that infectious
                    disease has shaped human genetics.
                </p>
                <p class="text-xs text-gray-400 mt-3 leading-relaxed">
                    Source: Institute for Health Metrics and Evaluation. Used
                    with permission. All rights reserved.
                    <br /><br />
                    Global Burden of Disease Study 2021 (GBD 2021) Sickle Cell Disease
                    Estimates 2000-2021. Seattle, United States: Institute for Health
                    Metrics and Evaluation (IHME), 2023.
                </p>
            </div>
        </section>

    </div>

    <style>
        /* Glass card — hidden by default, revealed on scroll */
        .glass-card {
            pointer-events: auto;
            background: rgba(255, 255, 255, 0.55);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 12px;
            padding: 1.5rem 2rem;
            max-width: 400px;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.5);
            opacity: 0;
            transform: translateY(30px);
            transition:
                opacity 0.6s ease,
                transform 0.6s ease;
        }
        .scroll-step.visible .glass-card {
            opacity: 1;
            transform: translateY(0);
        }
        .glass-card a {
            color: #6b7280;
        }

        /* Make page transparent so fixed map shows through */
        :global(body) {
            background: transparent !important;
        }
        :global(main.flex-grow) {
            padding: 0 !important;
            background: transparent !important;
        }
        :global(footer) {
            display: none;
        }

        /* Country paths */
        :global(.country) {
            stroke: none;
            transition: fill 0.8s ease;
            cursor: pointer;
        }
        /* Hover highlight layer */
        :global(.country-highlight) {
            fill: none;
            stroke: #333;
            stroke-width: 1.5;
            pointer-events: none;
        }
        /* Uniform border mesh */
        :global(.borders) {
            fill: none;
            stroke: #fff;
            stroke-width: 0.5;
            stroke-linejoin: round;
            pointer-events: none;
        }
    </style>

    <script is:inline>
        (function () {
            "use strict";

            // --- Configuration per step ---
            const STEPS = {
                0: {
                    title: "Anopheles Observations",
                    colorScheme: "greens",
                    dataKey: "anopheles",
                    label: "Species observations",
                    unit: "",
                },
                1: {
