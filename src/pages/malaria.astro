                "535": "BES",
            };

            function getIsoA3(feature) {
                return numericToIso[String(Number(feature.id))] || "";
            }

            // --- Get value for a country and dataset ---
            function getValue(feature, dataKey) {
                if (!dataKey) return null;
                const iso = getIsoA3(feature);
                if (!iso) return null;
                const val = dataByStep[dataKey][iso];
                return val !== undefined ? val : null;
            }

            // --- Get max for a dataset ---
            function getMax(dataKey) {
                if (!dataKey) return 0;
                const vals = Object.values(dataByStep[dataKey]);
                return vals.length ? Math.max(...vals) : 0;
            }

            // --- Update map colors ---
            function updateMap(stepIdx) {
                const step = STEPS[stepIdx];
                const dataKey = step.dataKey;
                const scheme = step.colorScheme;
                const interp = getInterpolator(scheme);
                const maxVal = getMax(dataKey);

                g.selectAll(".country")
                    .transition()
                    .duration(800)
                    .attr("fill", function (d) {
                        if (!dataKey) return "#e5e7eb";
                        const val = getValue(d, dataKey);
                        if (val === null || val === 0) return "#f3f4f6";
                        const t = powerScale(val, maxVal, 0.5);
                        return interp(t);
                    });

                // Update legend
                if (!dataKey) {
                    legend.style.opacity = "0";
                } else {
                    legend.style.opacity = "1";
                    legendTitle.textContent = step.label;
                    legendBar.style.background = getGradientCSS(scheme);
                    legendMin.textContent = "0";
                    legendMax.textContent = formatNumber(maxVal);
                }
            }

            function formatNumber(n) {
                if (n >= 1000) return Math.round(n).toLocaleString();
                if (n >= 10) return Math.round(n).toString();
                return n.toFixed(1);
            }

            // --- Tooltip & highlight ---
            function showTooltip(event, d) {
                // Draw highlight outline on top
                g.select(".country-highlight").attr("d", pathGen(d));

                const step = STEPS[currentStep];
                const val = step.dataKey ? getValue(d, step.dataKey) : null;
                const name = d.properties.name || "Unknown";
                const valStr = val !== null ? formatNumber(val) : "No data";
                const label = step.dataKey ? step.label : "";
                tooltip.innerHTML = label
                    ? `<strong>${name}</strong><br>${label}: ${valStr}`
                    : `<strong>${name}</strong>`;
                tooltip.classList.remove("hidden");
                positionTooltip(event);
            }

            function positionTooltip(event) {
                let x = event.clientX + 12;
                let y = event.clientY + 12;
                if (x + 220 > window.innerWidth) x = event.clientX - 230;
                if (y + 60 > window.innerHeight) y = event.clientY - 70;
                tooltip.style.left = x + "px";
                tooltip.style.top = y + "px";
            }

            function handleMouseEnter(event, d) {
                showTooltip(event, d);
            }

            function handleMouseMove(event, d) {
                positionTooltip(event);
            }

            function handleMouseLeave() {
                g.select(".country-highlight").attr("d", null);
                tooltip.classList.add("hidden");
            }

            // Mobile tap
            function handleClick(event, d) {
                if (window.matchMedia("(hover: hover)").matches) return;
                if (tooltip.classList.contains("hidden")) {
                    showTooltip(event, d);
                } else {
                    handleMouseLeave();
                }
            }

            // --- Scroll observer ---
            function setupScrollObserver() {
                const sections = document.querySelectorAll("[data-step]");

                const observer = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            const step = parseInt(
                                entry.target.getAttribute("data-step"),
                            );

                            if (entry.isIntersecting) {
                                // Card entering — reveal it and show its data
                                entry.target.classList.add("visible");
                                if (step !== currentStep) {
                                    currentStep = step;
                                    updateMap(step);
                                }
                            } else {
                                // Card leaving — hide it and advance/rewind map
                                entry.target.classList.remove("visible");

                                const rect = entry.boundingClientRect;
                                if (rect.bottom < 0) {
                                    // Scrolled above viewport (scrolling down) — advance
                                    const nextStep = step + 1;
                                    if (STEPS[nextStep] && nextStep !== currentStep) {
                                        currentStep = nextStep;
                                        updateMap(nextStep);
                                    }
                                } else if (rect.top > 0) {
                                    // Scrolled below viewport (scrolling up) — rewind
                                    const prevStep = step - 1;
                                    if (prevStep >= 0 && STEPS[prevStep] && prevStep !== currentStep) {
                                        currentStep = prevStep;
                                        updateMap(prevStep);
                                    }
                                }
                            }
                        }
                    },
                    { threshold: 0 },
                );

                sections.forEach((s) => observer.observe(s));
            }

            // --- Resize ---
            let resizeTimer;
            window.addEventListener("resize", () => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(() => {
                    if (!worldGeo) return;
                    const width = window.innerWidth;
                    const height = window.innerHeight;
                    svg.attr("viewBox", `0 0 ${width} ${height}`);
                    applyProjection(width, height);
                    pathGen = d3.geoPath().projection(projection);
                    g.selectAll("path").attr("d", pathGen);
                }, 200);
            });

            // --- Init ---
            async function init() {
                try {
                    await loadData();
                    initMap();
                    updateMap(0);
                    setupScrollObserver();
                } catch (err) {
                    console.error("Malaria visualization error:", err);
                }
            }

            // Load D3 and TopoJSON from CDN, then init
            function loadScript(src) {
                return new Promise((resolve, reject) => {
                    const s = document.createElement("script");
                    s.src = src;
                    s.onload = resolve;
                    s.onerror = reject;
                    document.head.appendChild(s);
                });
            }

            async function bootstrap() {
                await loadScript(
                    "https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js",
                );
                await loadScript(
                    "https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js",
                );
                if (document.readyState === "loading") {
                    document.addEventListener("DOMContentLoaded", init);
                } else {
                    init();
                }
            }

            bootstrap();
        })();
    </script>
</BaseLayout>
