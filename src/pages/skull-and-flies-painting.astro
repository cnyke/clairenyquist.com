---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Skull and Flies Painting - Claire Nyquist" description="Artistic exploration of mortality and nature through mixed media painting">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Back Navigation -->
    <div class="mb-8">
      <a href="/graphic-design" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium">
        ← Back to Graphic Design
      </a>
    </div>

    <!-- Project Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl name-gradient mb-6">
        Skull and Flies Painting
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
        A human skull surrounded by larger than life flies aims to explore the recycling of nutrients and energy in an ecosystem. Decay means fungi and bacteria are breaking down molecules. I find this decomposition to be a beautiful process. The acrylic paint, which is made of plastic, is a very human material, which contrasts with the natural wood it is painted on.       </p>
    </div>

    <!-- Featured painting, large and centered -->
    <div class="mb-12 flex justify-center">
      <div>
        <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300">
          <div class="relative">
            <img
              src="/images/skullandflies.jpg"
              alt="Painting on wood of a human skull in profile flanked by two black flies with stained-glass patterned wings."
              class="featured-art h-auto object-contain"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Detail studies -->
    <div class="mb-16 max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300">
        <div class="relative">
          <img
            src="/images/flywing.jpg"
            alt="Close-up painting of a fly's wing in stained-glass panes of blue, green, red, and orange against mint and violet."
            class="w-full h-auto object-contain"
          />
        </div>
      </div>
      <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300">
        <div class="relative">
          <img
            src="/images/fly2.png"
            alt="Bold painting detail of a black fly silhouette with spiny legs crossing vertical bands of magenta, teal, orange, and green."
            class="w-full h-auto object-contain"
          />
        </div>
      </div>
    </div>


    <!-- Navigation -->
    <div class="mt-12 pt-8 border-t border-gray-200">
      <div class="flex justify-between items-center">
        <a href="/graphic-design" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium">
          ← Back to Graphic Design
        </a>
        <div class="text-sm text-gray-500">
          Artistic Work
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Natural image sizing - no cropping */
    img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: contain;
      transition: transform 0.3s ease;
    }

    /* Featured painting: sized to fit on screen without scrolling */
    .featured-art {
      width: auto;
      max-width: 100%;
      max-height: 100vh;
    }

    /* Card hover effects */
    .bg-white:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    /* Image zoom effect on hover */
    .bg-white:hover img {
      transform: scale(1.05);
    }

    /* Ensure image container doesn't show overflow */
    .relative {
      overflow: hidden;
    }
  </style>
</BaseLayout>
