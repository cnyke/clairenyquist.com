---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  author?: string;
}

const {
  title,
  description = "Claire Nyquist - Data Visualization and Design. Exploring biology, public health, and epidemiology through interactive data visualizations, science communication, and creative storytelling.",
  image = "/images/headshot.png",
  type = "website",
  author = "Claire Nyquist"
} = Astro.props;

// Google Analytics Measurement ID
const GA_MEASUREMENT_ID = "G-7PZ8NQ5JQD";

// Get current URL for canonical and OG tags
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

const dataVizGroups = [
  {
    heading: "Public Health",
    pages: [
      { href: "/malaria", label: "Malaria" },
      { href: "/meps", label: "Medical Expenditure Panel Survey" },
      { href: "/respiratoryviruses", label: "Respiratory Viruses" },
      { href: "/tuberculosis", label: "Tuberculosis" },
    ],
  },
  {
    heading: "Science & Nature",
    pages: [
      { href: "/minnesota-bryophytes", label: "Minnesota Mosses" },
      { href: "/octopuses", label: "Octopuses" },
      { href: "/wilddyeplants", label: "Wild Dye Plants" },
    ],
  },
  {
    heading: "Speculative",
    pages: [
      { href: "/ai-models-timeline", label: "AI Models" },
      { href: "/stanford-torus-explorer", label: "Stanford Torus Explorer" },
      { href: "/themet", label: "The Met Collection" },
    ],
  },
];

// Anatomy & Physiology study tools (dropdown). Add new tools here.
const anatomyPages = [
  { href: "/histology", label: "Histology" },
];

const topLevelPages = [
  { href: "/graphic-design", label: "Graphic Design" },
  { href: "/tcplot", label: "tcplot" },
  { href: "/resume", label: "Resumé" },
  { href: "/about-contact", label: "About & Contact" },
];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Basic Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="keywords" content="data visualization, public health, science communication, epidemiology, biology, Claire Nyquist, interactive data, design, science fiction" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Favicon and Icons -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    
    <!-- Open Graph / Facebook Meta Tags -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content="Claire Nyquist" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:creator" content="@clairenyquist" />
    
    <!-- DNS Prefetch & Preconnect for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">

    <!-- Fonts: Helvetica Neue (system) with Inter as the cross-platform fallback; Silkscreen kept for the tcplot wordmark -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400&family=Silkscreen:wght@400;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style is:global>
      /* Neutral, uniform Helvetica Neue across the whole site. Silkscreen is the one exception (tcplot). */
      *:not(.font-silkscreen):not(.name-gradient):not(.font-space-grotesk) {
        font-family: "Helvetica Neue", Inter, Helvetica, Arial, sans-serif !important;
      }
      .font-silkscreen {
        font-family: "Silkscreen", cursive !important;
      }
      /* Space Grotesk — matches the "Claire Nyquist" wordmark on the home page. */
      .font-space-grotesk {
        font-family: "Space Grotesk", "Helvetica Neue", Arial, sans-serif !important;
      }
      /* Flatten weight so headings, body, and bold all read as one regular/neutral weight. */
      body,
      h1, h2, h3, h4, h5, h6,
      b, strong,
      .font-thin, .font-extralight, .font-light, .font-normal,
      .font-medium, .font-semibold, .font-bold, .font-extrabold, .font-black {
        font-weight: 400 !important;
      }
      /* Primary text in a neutral dark gray rather than near-black. */
      body { color: #374151; }
      .text-gray-900 { color: #374151 !important; }

      /* Page titles in the same animated blue gradient as the "Claire Nyquist"
         wordmark on the home page (turbo-scale blues, Space Grotesk). */
      .name-gradient {
        font-family: "Space Grotesk", "Helvetica Neue", Arial, sans-serif !important;
        line-height: 1.15;
        padding-bottom: 0.12em;
        background-image: linear-gradient(
          90deg,
          #1e3a8a,
          #2563eb,
          #4675ed,
          #38bdf8
        );
        background-size: 200% auto;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        -webkit-text-fill-color: transparent;
        animation: name-shift 9s ease-in-out infinite alternate;
      }
      @keyframes name-shift {
        from { background-position: 0% center; }
        to { background-position: 100% center; }
      }
      @media (prefers-reduced-motion: reduce) {
        .name-gradient { animation: none; }
      }
    </style>

    <!-- Structured Data (Schema.org JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": type === "article" ? "Article" : "WebSite",
      "name": "Claire Nyquist",
      "url": canonicalURL,
      "description": description,
      "author": {
        "@type": "Person",
        "name": author,
        "email": "clairenyquist@gmail.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Claire Nyquist",
        "logo": {
          "@type": "ImageObject",
          "url": new URL("/favicon.png", Astro.site)
        }
      }
    })} />
    
    <!-- Google Analytics -->
    {GA_MEASUREMENT_ID && GA_MEASUREMENT_ID !== "G-XXXXXXXXXX" && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA_MEASUREMENT_ID);
        </script>
      </>
    )}
  </head>
  <body class="font-lexend bg-white text-gray-900 min-h-screen flex flex-col">
    <header class="sticky top-0 bg-white/95 backdrop-blur-sm border-b border-gray-200" style="z-index: 1000;">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <!-- Logo/Title -->
          <div class="flex-shrink-0">
            <a href="/" class="font-space-grotesk text-xl font-light text-gray-900 hover:text-blue-600 transition-colors">
              Claire Nyquist
            </a>
          </div>
          
          <!-- Desktop Navigation -->
          <nav class="hidden md:flex space-x-8">
            <!-- Data Visualizations Dropdown -->
            <div class="relative">
              <button
                id="desktop-dataviz-toggle"
                type="button"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="desktop-dataviz-menu"
                class="text-gray-700 hover:text-blue-600 transition-colors font-medium flex items-center space-x-1"
              >
                <span>Data Visualizations</span>
                <svg id="desktop-dataviz-icon" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div
                id="desktop-dataviz-menu"
                class="absolute left-0 top-full pt-2 w-56 hidden z-50"
              >
                <div class="rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5">
                  <div class="py-1">
                    {dataVizGroups.map((g) => (
                      <div>
                        <p class="px-4 pt-3 pb-1 text-xs font-semibold uppercase tracking-wide text-gray-400">
                          {g.heading}
                        </p>
                        {g.pages.map((p) => (
                          <a href={p.href} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-blue-600 transition-colors">
                            {p.label}
                          </a>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <!-- Anatomy Dropdown -->
            <div class="relative">
              <button
                id="desktop-anatomy-toggle"
                type="button"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="desktop-anatomy-menu"
                class="text-gray-700 hover:text-blue-600 transition-colors font-medium flex items-center space-x-1"
              >
                <span>Studying Anatomy</span>
                <svg id="desktop-anatomy-icon" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div
                id="desktop-anatomy-menu"
                class="absolute left-0 top-full pt-2 w-56 hidden z-50"
              >
                <div class="rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5">
                  <div class="py-1">
                    {anatomyPages.map((p) => (
                      <a href={p.href} class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-blue-600 transition-colors">
                        {p.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            {topLevelPages.map((p) => (
              <a href={p.href} class={`text-gray-700 hover:text-blue-600 transition-colors ${p.href === "/tcplot" ? "font-silkscreen font-normal" : "font-medium"}`}>
                {p.label}
              </a>
            ))}
          </nav>

          <!-- Mobile menu button -->
          <div class="md:hidden">
            <button id="mobile-menu-button" class="text-gray-700 hover:text-blue-600 focus:outline-none focus:text-blue-600">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Navigation -->
        <div id="mobile-menu" class="hidden md:hidden pb-4">
          <div class="flex flex-col space-y-2">
            <!-- Data Visualizations Dropdown for Mobile -->
            <div>
              <button
                id="mobile-dataviz-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="mobile-dataviz-menu"
                class="text-gray-700 hover:text-blue-600 transition-colors font-medium py-2 flex items-center justify-between w-full"
              >
                <span>Data Visualizations</span>
                <svg id="mobile-dataviz-icon" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div id="mobile-dataviz-menu" class="hidden pl-4 space-y-2 mt-2">
                {dataVizGroups.map((g) => (
                  <div>
                    <p class="pt-2 pb-1 text-xs font-semibold uppercase tracking-wide text-gray-400">
                      {g.heading}
                    </p>
                    {g.pages.map((p) => (
                      <a href={p.href} class="block text-gray-700 hover:text-blue-600 transition-colors py-2">
                        {p.label}
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            </div>

            <!-- Anatomy Dropdown for Mobile -->
            <div>
              <button
                id="mobile-anatomy-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="mobile-anatomy-menu"
                class="text-gray-700 hover:text-blue-600 transition-colors font-medium py-2 flex items-center justify-between w-full"
              >
                <span>Studying Anatomy</span>
                <svg id="mobile-anatomy-icon" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div id="mobile-anatomy-menu" class="hidden pl-4 space-y-2 mt-2">
                {anatomyPages.map((p) => (
                  <a href={p.href} class="block text-gray-700 hover:text-blue-600 transition-colors py-2">
                    {p.label}
                  </a>
                ))}
              </div>
            </div>

            {topLevelPages.map((p) => (
              <a href={p.href} class={`text-gray-700 hover:text-blue-600 transition-colors py-2 ${p.href === "/tcplot" ? "font-silkscreen font-normal" : "font-medium"}`}>
                {p.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-gray-50 border-t border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Background Section -->
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Background</h3>
            <p class="text-gray-600 leading-relaxed">
              Claire Nyquist explores science and public health through data visualization and graphic design.
            </p>
          </div>
          
          <!-- Contact Section -->
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Contact</h3>
            <div class="space-y-2 text-gray-600">
              <p>Email: clairenyquist@gmail.com</p>
            </div>
          </div>
        </div>
        
        <div class="mt-8 pt-8 border-t border-gray-300 text-center text-gray-500">
          <p>&copy; 2026 Claire Nyquist. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      document.getElementById('mobile-menu-button')?.addEventListener('click', () => {
        document.getElementById('mobile-menu')?.classList.toggle('hidden');
      });

      // Mobile dropdown (accordion) — wired up by id prefix
      function setupMobileDropdown(prefix) {
        const btn = document.getElementById(`mobile-${prefix}-toggle`);
        const submenu = document.getElementById(`mobile-${prefix}-menu`);
        const icon = document.getElementById(`mobile-${prefix}-icon`);
        btn?.addEventListener('click', () => {
          const willOpen = submenu?.classList.contains('hidden');
          submenu?.classList.toggle('hidden');
          icon?.classList.toggle('rotate-180');
          btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        });
      }

      // Desktop dropdown — click to toggle (works on touch), close on outside click / Escape
      function setupDesktopDropdown(prefix) {
        const btn = document.getElementById(`desktop-${prefix}-toggle`);
        const menu = document.getElementById(`desktop-${prefix}-menu`);
        const icon = document.getElementById(`desktop-${prefix}-icon`);
        if (!btn || !menu) return;

        const closeMenu = () => {
          menu.classList.add('hidden');
          icon?.classList.remove('rotate-180');
          btn.setAttribute('aria-expanded', 'false');
        };

        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const willOpen = menu.classList.contains('hidden');
          menu.classList.toggle('hidden');
          icon?.classList.toggle('rotate-180');
          btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        });

        // Close when clicking anywhere outside
        document.addEventListener('click', (e) => {
          if (menu.classList.contains('hidden')) return;
          const target = e.target;
          if (target instanceof Node && !menu.contains(target) && target !== btn) {
            closeMenu();
          }
        });

        // Close on Escape
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeMenu();
        });
      }

      // Wire up every nav dropdown. Add a prefix here when you add another.
      ['dataviz', 'anatomy'].forEach((prefix) => {
        setupMobileDropdown(prefix);
        setupDesktopDropdown(prefix);
      });
    </script>
  </body>
</html>

